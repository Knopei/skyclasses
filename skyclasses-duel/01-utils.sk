# One-time cleanup #2 (found in variables.csv, Nov 2026):
#   - damage stats saved under ~2,400 mob UUIDs (jungle mobs / bosses that hit players, from before dmgStats() only counted players):
#     {damage::<mob>}, {class-damage::<mob>::*} and {matchdamage::<mob>} — about 10,800 variables, 0.8 MB. Kept only for real players
#     (anyone with a {kill::<uuid>} stat, which every player gets on first join).
#   - variables no script uses any more (old prototype / menu / draft-deck leftovers).
on load:
	if {perfCleanupV2} isn't set:
		set {perfCleanupV2} to true
		loop {damage::*}:
			if {kill::%loop-index%} isn't set:
				set {_junk::%loop-index%} to true
		loop {matchdamage::*}:
			if {kill::%loop-index%} isn't set:
				set {_junk::%loop-index%} to true
		loop {_junk::*}:
			delete {damage::%loop-index%}
			delete {class-damage::%loop-index%::*}
			delete {matchdamage::%loop-index%}
			delete {matchdamage::%loop-index%::*}
		delete {mbMagma::*}
		delete {sv-r::*}
		delete {sv-l::*}
		delete {classBrowserSlotClass::*}
		delete {draftMenuSlotClass::*}
		delete {class-menu::*}
		delete {protocfg::*}
		delete {classlevel-lore::*}
		delete {class-blurb::*}
		delete {perk-display-name::*}
		delete {category-buff::*}
		delete {minibossbuffs::*}
		delete {gd-speeduntil::*}
		delete {tbMagmaTouch::*}
		delete {grantPerkResult}
		delete {arrow-slot::*}
		delete {protoClock}
		delete {draftDeckV2}
		delete {draftDeckV3}
		delete {draftDeckV4}
		delete {draftResult}

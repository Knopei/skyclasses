		delete {fhULTResult::*}
		delete {fhULTResult}
		delete {forgeGolem::*}
		delete {forgeGolem}
		delete {gdCHECKResult::*}
		delete {gdCHECKResult}
		delete {godlike-ULT-CANCEL::*}
		delete {godlike-ULT-CANCEL}
		delete {godlike-ULT-CD::*}
		delete {godlike-ULT-CD}
		delete {godlike-ULT-USE::*}
		delete {godlike-ULT-USE}
		delete {hbAdj::*}
		delete {hbAdj}
		delete {hbDelta::*}
		delete {hbDelta}
		delete {hbExec::*}
		delete {hbExec}
		delete {hbFight::*}
		delete {hbFight}
		delete {hbFightClass::*}
		delete {hbFightClass}
		delete {hbFightHB::*}
		delete {hbFightHB}
		delete {hbFightLast::*}
		delete {hbFightLast}
		delete {hbFightPlayers::*}
		delete {hbFightPlayers}
		delete {hbFightSave::*}
		delete {hbFightSave}
		delete {hbFightWinner::*}
		delete {hbFightWinner}
		delete {hbPending::*}
		delete {hbPending}
		delete {invulnerabilityFix::*}
		delete {invulnerabilityFix}
		delete {isShielding::*}
		delete {isShielding}
		delete {jgRegenNext::*}
		delete {jgRegenNext}
		delete {lastMoveAbility::*}
		delete {lastMoveAbility}
		delete {levelTag::*}
		delete {levelTag}

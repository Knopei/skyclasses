	set {classlevel-name::RB::1} to "&6Rapid Bow"
	set {classlevel-desc::RB::1::*} to "&8&oSwap to your bow and fire arrows" and "&8&olike a rapid-fire machine gun."
	set {classlevel-category::RB::2} to "Passive Upgrade"
	set {classlevel-name::RB::2} to "&6Long Shot"
	set {classlevel-desc::RB::2::*} to "&8&oThe passive's arrow does 30%% max" and "&8&ohealth damage instead of 25%% when" and "&8&ofired from 7.5+ blocks away."

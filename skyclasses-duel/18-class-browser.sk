# ============================================
# CLASS BROWSER (out-of-match /class command)
# Not to be confused with 05-class-menu.sk's openClassMenu() — that's the
# in-match "swap between your 3 drafted classes" GUI, used only during the
# death-respawn flow now that the base region was scrapped. This is a
# separate browser: every class's full kit, mastery progress, level-unlock
# info, and — per class — a default-consumable and default-general-perk
# selector (what 05-class-menu.sk's classSelect() equips that class with on
# every respawn unless overridden in-match for that game — see
# 06-perks-general.sk / 07-consumables.sk). The main browser page itself
# stays purely informational; only the Class Info page's two default
# selectors actually change any persistent state.
#
# Ratings (difficulty/melee/range/toughness/crowd control/mobility) are static
# flavor data, not derived from anything — tune the strings directly below if
# a class's kit changes enough to make them inaccurate. Each line shows the
# pip bar first, then the stat's name.
#
# Level-unlock lore is written from the actual Perk 1 / Perk 2 descriptions
# already documented at the top of each class file — see viking.sk, demon.sk,
# etc. If a perk's behavior ever changes, update the matching block here too.
# ============================================

on load:
	# ---- RATINGS (Difficulty / Melee / Range / Toughness / Crowd Control / Mobility) ----
	set {class-rating::PGS::*} to "&a●&2●&7●● &cClose Damage" and "&7●●●● &eRange Damage" and "&a●●●● &6Toughness" and "&a●●&7●● &5Crowd Control" and "&a●&7●●● &bMobility"
	set {class-rating::VBA::*} to "&a●●●● &cClose Damage" and "&a●&2●&7●● &eRange Damage" and "&7●●●● &6Toughness" and "&a●&7●●● &5Crowd Control" and "&a●●&7●● &bMobility"
	set {class-rating::RB::*} to "&a●●●&7● &cClose Damage" and "&a●●●&2● &eRange Damage" and "&7●●●● &6Toughness" and "&7●●●● &5Crowd Control" and "&a●●&7●● &bMobility"
	set {class-rating::DS::*} to "&a●●&7●● &cClose Damage" and "&a●&7●●● &eRange Damage" and "&a●●●&7● &6Toughness" and "&a●&2●&7●● &5Crowd Control" and "&a●&7●●● &bMobility"
	set {class-rating::GD::*} to "&a●●&2●&7● &cClose Damage" and "&7●●●● &eRange Damage" and "&a●●&7●● &6Toughness" and "&7●●●● &5Crowd Control" and "&a●●●● &bMobility"
	set {class-rating::ZT::*} to "&a●●●&7● &cClose Damage" and "&a●●●&7● &eRange Damage" and "&7●●●● &6Toughness" and "&a●&2●&7●● &5Crowd Control" and "&a●&7●●● &bMobility"
	set {class-rating::MH::*} to "&a●●●&2● &cClose Damage" and "&7●●●● &eRange Damage" and "&2●&7●●● &6Toughness" and "&a●●●&7● &5Crowd Control" and "&a●&2●&7●● &bMobility"
	set {class-rating::RS::*} to "&a●●&7●● &cClose Damage" and "&a●&7●●● &eRange Damage" and "&a●&7●●● &6Toughness" and "&a●●&7●● &5Crowd Control" and "&a●●&2●&7● &bMobility"
	set {class-rating::NS::*} to "&a●●&7●● &cClose Damage" and "&a●&7●●● &eRange Damage" and "&7●●●● &6Toughness" and "&a●●&2●&7● &5Crowd Control" and "&a●●●&7● &bMobility"
	set {class-rating::FH::*} to "&a●●&7●● &cClose Damage" and "&7●●●● &eRange Damage" and "&a●●●&2● &6Toughness" and "&a●&7●●● &5Crowd Control" and "&a●●&7●● &bMobility"
	set {class-rating::BS::*} to "&a●●&7●● &cClose Damage" and "&7●●●● &eRange Damage" and "&a●●&2●&7● &6Toughness" and "&a●●●&7● &5Crowd Control" and "&a●&7●●● &bMobility"
	set {class-rating::CB::*} to "&a●●&7●● &cClose Damage" and "&a●●&7●● &eRange Damage" and "&7●●●● &6Toughness" and "&a●&2●&7●● &5Crowd Control" and "&a●●●&7● &bMobility"
	set {class-rating::TS::*} to "&a●●&7●● &cClose Damage" and "&a●&7●●● &eRange Damage" and "&7●●●● &6Toughness" and "&a●●&2●&7● &5Crowd Control" and "&a●●●&7● &bMobility" # Range 1/4 (was 1.5/4), Mobility 3/4 (was 2.5/4) — half a point moved from Range to Mobility
	set {class-rating::EA::*} to "&a●●●● &cClose Damage" and "&7●●●● &eRange Damage" and "&a●&7●●● &6Toughness" and "&a●&2●&7●● &5Crowd Control" and "&a●●&7●● &bMobility"

	# ---- LEVEL UNLOCK INFO (Level 1 = ultimate, Level 2 = Perk 1, Level 3 = Perk 2) ----
	# category feeds the item's display name ("Level N: <category>"); name is the
	# ability/perk's own name, pre-colored (perks are all &6, ultimates keep the
	# color they're shown with in class-display); desc is the description only.
	set {classlevel-category::VBA::1} to "Unlocks Ultimate"
	set {classlevel-name::VBA::1} to "&4Big Rage"
	set {classlevel-desc::VBA::1::*} to "&8&oLittle Rage but more furious."
	set {classlevel-category::VBA::2} to "Passive Upgrade"
	set {classlevel-name::VBA::2} to "&6Joyful to Furious"
	set {classlevel-desc::VBA::2::*} to "&8&oRefines the health-scaling damage" and "&8&oformula into more dramatic tiers."
	set {classlevel-category::VBA::3} to "Ultimate Upgrade"
	set {classlevel-name::VBA::3} to "&6Victim Chase"
	set {classlevel-desc::VBA::3::*} to "&8&oWhile the ultimate is active, empowers" and "&8&othe tactical's on-hit speed from 2 to 3."

	set {classlevel-category::DS::1} to "Unlocks Ultimate"
	set {classlevel-name::DS::1} to "&4Blood Harvest"
	set {classlevel-desc::DS::1::*} to "&8&oAutomatically shoot Blood Beams at" and "&8&oall nearby enemies."
	set {classlevel-category::DS::2} to "Tactical Upgrade"
	set {classlevel-name::DS::2} to "&6Extended Siphon"
	set {classlevel-desc::DS::2::*} to "&8&oExtends the tactical beam's range."
	set {classlevel-category::DS::3} to "Ultimate Upgrade"
	set {classlevel-name::DS::3} to "&6Vampire"
	set {classlevel-desc::DS::3::*} to "&8&oIncreases lifesteal per hit during" and "&8&othe ultimate."

	set {classlevel-category::FH::1} to "Unlocks Ultimate"
	set {classlevel-name::FH::1} to "&bIt's Alive!"
	set {classlevel-desc::FH::1::*} to "&8&oCreate a powerful electric shield" and "&8&othat reflects projectiles."
	set {classlevel-category::FH::2} to "Passive Upgrade"
	set {classlevel-name::FH::2} to "&6The Biggest Boy"
	set {classlevel-desc::FH::2::*} to "&8&oGain +1 max health."
	set {classlevel-category::FH::3} to "Ultimate Upgrade"
	set {classlevel-name::FH::3} to "&6Undying"
	set {classlevel-desc::FH::3::*} to "&8&oIncreases the ultimate's absorption" and "&8&oshield strength."

	set {classlevel-category::GD::1} to "Unlocks Ultimate"
	set {classlevel-name::GD::1} to "&4Ghost"
	set {classlevel-desc::GD::1::*} to "&8&oGain immense speed and invisibility" and "&8&o+ your next attack while invis does a" and "&8&olarge percent of the enemy's health."
	set {classlevel-category::GD::2} to "Tactical Upgrade"
	set {classlevel-name::GD::2} to "&6Lunge Master"
	set {classlevel-desc::GD::2::*} to "&8&oReduces the tactical's mana cost."
	set {classlevel-category::GD::3} to "Ultimate Upgrade"
	set {classlevel-name::GD::3} to "&6Supportive Ghost"
	set {classlevel-desc::GD::3::*} to "&8&oAdds cleanse + regen to the ultimate."

	set {classlevel-category::BS::1} to "Unlocks Ultimate"
	set {classlevel-name::BS::1} to "&6Shield Quake"
	set {classlevel-desc::BS::1::*} to "&8&oSlam your shield multiple times," and "&8&oknocking up enemies and briefly" and "&8&odisabling their stamina usage."
	set {classlevel-category::BS::2} to "Tactical Upgrade"
	set {classlevel-name::BS::2} to "&6Resilient Basher"
	set {classlevel-desc::BS::2::*} to "&8&oBigger stamina refund on bash."
	set {classlevel-category::BS::3} to "Ultimate Upgrade"
	set {classlevel-name::BS::3} to "&6Unsteady Grounds"
	set {classlevel-desc::BS::3::*} to "&8&oIncreases the damage of Shield Quake" and "&8&oand the duration of stamina pause."

	set {classlevel-category::MH::1} to "Unlocks Ultimate"
	set {classlevel-name::MH::1} to "&bMighty Leap"
	set {classlevel-desc::MH::1::*} to "&8&oLeap high and create a big explosion" and "&8&oon landing + dash mid-air."
	set {classlevel-category::MH::2} to "Passive Upgrade"
	set {classlevel-name::MH::2} to "&6Grenade Protection"
	set {classlevel-desc::MH::2::*} to "&8&oTake less damage from grenades."
	set {classlevel-category::MH::3} to "Ultimate Upgrade"
	set {classlevel-name::MH::3} to "&6Fire Pit"
	set {classlevel-desc::MH::3::*} to "&8&oCreates a fire ring on ultimate landing."

	set {classlevel-category::NS::1} to "Unlocks Ultimate"
	set {classlevel-name::NS::1} to "&6Dragon Blade"
	set {classlevel-desc::NS::1::*} to "&8&oPull out a fiery katana and gain" and "&8&oimmense speed and jump boost."
	set {classlevel-category::NS::2} to "Passive Upgrade"
	set {classlevel-name::NS::2} to "&6Stamina Master"
	set {classlevel-desc::NS::2::*} to "&8&oStamina dashes will launch you further."
	set {classlevel-category::NS::3} to "Ultimate Upgrade"
	set {classlevel-name::NS::3} to "&6Fiery Shurikens"
	set {classlevel-desc::NS::3::*} to "&8&oIgnites your shurikens during the" and "&8&oultimate."

	set {classlevel-category::PGS::1} to "Unlocks Ultimate"
	set {classlevel-name::PGS::1} to "&6Holy Radiance"
	set {classlevel-desc::PGS::1::*} to "&8&oCreate a holy radius that buffs you" and "&8&oand debuffs enemies."
	set {classlevel-category::PGS::2} to "Tactical Upgrade"

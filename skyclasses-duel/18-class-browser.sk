	set {classlevel-name::TS::1} to "&4Tornado"
	set {classlevel-desc::TS::1::*} to "&8&oSummon a directional tornado that" and "&8&opushes and damages enemies."
	set {classlevel-category::TS::2} to "Passive Upgrade"
	set {classlevel-name::TS::2} to "&6Lingering Winds"
	set {classlevel-desc::TS::2::*} to "&8&oAirborne's speed buff lasts 3" and "&8&oseconds instead of 2."

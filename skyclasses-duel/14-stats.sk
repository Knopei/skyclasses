# ============================================
# STATS
# Persistent overall + per-class account stats, the end-of-match summary GUI,
# and /matchhistory. Cleaned/rebuilt from the original leaderboards.sk (dropped
# the old leaderboard-sorting logic since divisions/leaderboard display were
# cut — can be revisited alongside champion mastery).
#
# NOTE: formatNumber() is Skript's own built-in function (available since
# Skript 2.10) — no custom definition needed here. It was originally a custom
# function in the old leaderboards.sk, but redefining it caused a duplicate-
# function error once both were loaded together.
#
# initializePlayerStats() is the single source of truth for every persistent
# stat variable in the game — used both on first join and by /resetstats, so
# there's only one place that needs updating if a new tracker is ever added.
# ============================================

function initializePlayerStats(p: offline player): # offline player, so /resetstats can target someone not currently online
	set {_uuid} to {_p}'s uuid

	# ---- OVERALL ----
	set {games::%{_uuid}%} to 0
	set {wins::%{_uuid}%} to 0
	set {losses::%{_uuid}%} to 0
	set {duration-total::%{_uuid}%} to 0
	set {duration-win-total::%{_uuid}%} to 0
	set {duration-loss-total::%{_uuid}%} to 0
	set {kill::%{_uuid}%} to 0
	set {death::%{_uuid}%} to 0
	set {ks::%{_uuid}%::count} to 0
	set {ks::%{_uuid}%::top} to 0
	set {firstbloods::%{_uuid}%} to 0
	set {damage::%{_uuid}%} to 0
	set {playerdamage::%{_uuid}%} to 0
	set {damagetaken::%{_uuid}%} to 0
	set {jungleslain::%{_uuid}%} to 0
	set {bossesslain::%{_uuid}%} to 0
	set {bosssteals::%{_uuid}%} to 0
	set {xpearly::%{_uuid}%} to 0
	set {xpmid::%{_uuid}%} to 0
	set {xplate::%{_uuid}%} to 0
	set {phasegames-early::%{_uuid}%} to 0 # games that reached each phase — denominator for the Avg XP/Phase stats below
	set {phasegames-mid::%{_uuid}%} to 0
	set {phasegames-late::%{_uuid}%} to 0
	set {leadgames::%{_uuid}%} to 0
	set {leadlossgames::%{_uuid}%} to 0
	set {behindwingames::%{_uuid}%} to 0
	set {bestgame-damage::%{_uuid}%} to 0
	set {bestgame-playerdamage::%{_uuid}%} to 0
	set {bestgame-cs::%{_uuid}%} to 0
	set {bestgame-kd::%{_uuid}%} to 0

	# ---- PER-CLASS ----
	loop {menu::classlist::*}: # 05-class-menu.sk
		set {_c} to loop-value
		set {class-games::%{_uuid}%::%{_c}%} to 0
		set {class-wins::%{_uuid}%::%{_c}%} to 0
		set {class-losses::%{_uuid}%::%{_c}%} to 0
		set {class-duration-total::%{_uuid}%::%{_c}%} to 0
		set {class-duration-win-total::%{_uuid}%::%{_c}%} to 0
		set {class-duration-loss-total::%{_uuid}%::%{_c}%} to 0
		set {class-kill::%{_uuid}%::%{_c}%} to 0
		set {class-death::%{_uuid}%::%{_c}%} to 0
		set {class-ks::%{_uuid}%::%{_c}%::count} to 0
		set {class-ks::%{_uuid}%::%{_c}%::top} to 0
		set {class-firstbloods::%{_uuid}%::%{_c}%} to 0
		set {class-damage::%{_uuid}%::%{_c}%} to 0
		set {class-playerdamage::%{_uuid}%::%{_c}%} to 0
		set {class-damagetaken::%{_uuid}%::%{_c}%} to 0
		set {class-jungleslain::%{_uuid}%::%{_c}%} to 0
		set {class-bossesslain::%{_uuid}%::%{_c}%} to 0
		set {class-bosssteals::%{_uuid}%::%{_c}%} to 0
		set {class-xpearly::%{_uuid}%::%{_c}%} to 0
		set {class-xpmid::%{_uuid}%::%{_c}%} to 0
		set {class-xplate::%{_uuid}%::%{_c}%} to 0
		set {class-leadgames::%{_uuid}%::%{_c}%} to 0
		set {class-leadlossgames::%{_uuid}%::%{_c}%} to 0
		set {class-behindwingames::%{_uuid}%::%{_c}%} to 0

	delete {matchhistory::%{_uuid}%::*}
	delete {pr::%{_uuid}%::*} # last-30-games rolling window (see PER-PLAYER RECENT GAMES below)
	delete {pr-ptr::%{_uuid}%}
	delete {prb::%{_uuid}%::*}

function backfillClassStats(p: offline player, class: text): # fills in only the MISSING per-class stat keys for one class, defaulted to 0 — unlike initializePlayerStats() (a full, unconditional reset), this never touches a key that's already set. Exists so a player who joined before a new class (e.g. Cyberpunk/Tempest) existed doesn't show blank/broken values on that class's Class Info page — their other classes' real stats are left completely untouched
	set {_uuid} to {_p}'s uuid
	if {class-games::%{_uuid}%::%{_class}%} isn't set: # canary — every key below is always set alongside this one, so checking just this one is enough
		set {class-games::%{_uuid}%::%{_class}%} to 0
		set {class-wins::%{_uuid}%::%{_class}%} to 0
		set {class-losses::%{_uuid}%::%{_class}%} to 0
		set {class-duration-total::%{_uuid}%::%{_class}%} to 0
		set {class-duration-win-total::%{_uuid}%::%{_class}%} to 0
		set {class-duration-loss-total::%{_uuid}%::%{_class}%} to 0
		set {class-kill::%{_uuid}%::%{_class}%} to 0
		set {class-death::%{_uuid}%::%{_class}%} to 0
		set {class-ks::%{_uuid}%::%{_class}%::count} to 0
		set {class-ks::%{_uuid}%::%{_class}%::top} to 0
		set {class-firstbloods::%{_uuid}%::%{_class}%} to 0
		set {class-damage::%{_uuid}%::%{_class}%} to 0
		set {class-playerdamage::%{_uuid}%::%{_class}%} to 0
		set {class-damagetaken::%{_uuid}%::%{_class}%} to 0
		set {class-jungleslain::%{_uuid}%::%{_class}%} to 0
		set {class-bossesslain::%{_uuid}%::%{_class}%} to 0
		set {class-bosssteals::%{_uuid}%::%{_class}%} to 0
		set {class-xpearly::%{_uuid}%::%{_class}%} to 0
		set {class-xpmid::%{_uuid}%::%{_class}%} to 0
		set {class-xplate::%{_uuid}%::%{_class}%} to 0
		set {class-leadgames::%{_uuid}%::%{_class}%} to 0
		set {class-leadlossgames::%{_uuid}%::%{_class}%} to 0
		set {class-behindwingames::%{_uuid}%::%{_class}%} to 0

on join: # first-time-ever initialization — {kill::%uuid%} is the canary since it's set by every path that initializes stats
	if {kill::%player's uuid%} isn't set:
		initializePlayerStats(player)
	else: # existing player — top up any class added to the roster since they last had a fresh initialization (e.g. Cyberpunk/Tempest)
		loop {menu::classlist::*}: # 05-class-menu.sk
			backfillClassStats(player, loop-value)

command /resetstats [<offline player>]:
	permission: op
	trigger:
		if arg 1 is set:
			set {_target} to arg 1
		else:
			set {_target} to player
		initializePlayerStats({_target})
		send "&aAll stats reset for &e%{_target}%&a." to player

# ---- PERSISTENT STATS GUI ----

function safeDivide(a: number, b: number) :: number: # avoids divide-by-zero across all the derived stats below
	if {_b} = 0:
		return 0
	return {_a} / {_b}

function formatDuration(seconds: number) :: string: # e.g. 754 -> "12m 34s"
	set {_m} to floor({_seconds} / 60)
	set {_s} to mod({_seconds}, 60)
	return "%{_m}%m %{_s}%s"

# ---- PER-PLAYER RECENT GAMES (last 30 real matches, powers the click-to-toggle on /stats icons and the Class Statistics icon) ----
# A ring buffer of 30 slots per player: {pr::<uuid>::<slot>::<field>} for the match's overall numbers and {pr::<uuid>::<slot>::c::<CLASS>::<field>} for each of
# the 3 loadout classes. Most lifetime counters only exist as running totals, so playerRecentSnapshot() (called once the draft is done) stores a baseline
# {prb::...} and playerRecentRecord() (called from endMatch(), real matches only) writes the DIFFERENCE for the match into the next slot. A match that is
# force-ended or is a /testduel never reaches playerRecentRecord(), so it is simply not in the window.
#   overall fields : games wins losses dur durwin durloss kills deaths mxks fb dmg pdmg dtaken jungle bosses steals xe xm xl pge pgm pgl lead leadloss behindwin mxdmg mxpdmg mxcs mxkd
#   per-class      : g w l k d dmg pd dt jg bs mxks
# Fields starting with "mx" are best-of values (aggregated as a MAX over the window), everything else is summed.

function trackKillstreak(p: player, class: text): # called from 09-death-match.sk right after a kill increments the streak — remembers the best streak reached THIS match (overall + per class)
	set {_cur} to {ks::%{_p}'s uuid%::count}
	if {_cur} > bd({matchtopks::%{_p}'s uuid%}):
		set {matchtopks::%{_p}'s uuid%} to {_cur}
	set {_cc} to {class-ks::%{_p}'s uuid%::%{_class}%::count}
	if {_cc} > bd({matchtopks::%{_p}'s uuid%::%{_class}%}):
		set {matchtopks::%{_p}'s uuid%::%{_class}%} to {_cc}

function playerRecentSnapshot(p: player): # called from 10-match-manager.sk's enterArena() for real matches, once the loadout is known
	set {_u} to {_p}'s uuid
	delete {prb::%{_u}%::*}
	set {prb::%{_u}%::dtaken} to bd({damagetaken::%{_u}%})
	set {prb::%{_u}%::bosses} to bd({bossesslain::%{_u}%})
	set {prb::%{_u}%::steals} to bd({bosssteals::%{_u}%})
	set {prb::%{_u}%::fb} to bd({firstbloods::%{_u}%})
	set {prb::%{_u}%::xe} to bd({xpearly::%{_u}%})
	set {prb::%{_u}%::xm} to bd({xpmid::%{_u}%})
	set {prb::%{_u}%::xl} to bd({xplate::%{_u}%})
	loop integers between 1 and 3:
		set {_c} to {loadout::%{_u}%::%loop-value%}
		if {_c} is set:
			set {prb::%{_u}%::c::%{_c}%::pd} to bd({class-playerdamage::%{_u}%::%{_c}%})
			set {prb::%{_u}%::c::%{_c}%::dt} to bd({class-damagetaken::%{_u}%::%{_c}%})
			set {prb::%{_u}%::c::%{_c}%::jg} to bd({class-jungleslain::%{_u}%::%{_c}%})
			set {prb::%{_u}%::c::%{_c}%::bs} to bd({class-bossesslain::%{_u}%::%{_c}%})
	set {prb::%{_u}%::ok} to true

function playerRecentRecord(p: offline player, result: text, duration: number): # called from endMatch() BEFORE processEndMatchStats() (which clears hadLead/wasBehind), real matches only
	set {_u} to {_p}'s uuid
	if {prb::%{_u}%::ok} isn't set: # no baseline (match started before this feature existed) — skip rather than record nonsense
		stop
	if {pr-ptr::%{_u}%} isn't set:
		set {pr-ptr::%{_u}%} to 0
	add 1 to {pr-ptr::%{_u}%}
	if {pr-ptr::%{_u}%} > 30:
		set {pr-ptr::%{_u}%} to 1
	set {_s} to {pr-ptr::%{_u}%}
	delete {pr::%{_u}%::%{_s}%::*}
	set {pr::%{_u}%::%{_s}%::games} to 1
	set {pr::%{_u}%::%{_s}%::dur} to {_duration}
	if {_result} = "WIN":
		set {pr::%{_u}%::%{_s}%::wins} to 1
		set {pr::%{_u}%::%{_s}%::durwin} to {_duration}
	else:
		set {pr::%{_u}%::%{_s}%::losses} to 1
		set {pr::%{_u}%::%{_s}%::durloss} to {_duration}
	set {pr::%{_u}%::%{_s}%::kills} to bd({matchkills::%{_u}%})
	set {pr::%{_u}%::%{_s}%::deaths} to bd({matchdeaths::%{_u}%})
	set {pr::%{_u}%::%{_s}%::mxks} to bd({matchtopks::%{_u}%})
	set {pr::%{_u}%::%{_s}%::dmg} to bd({matchdamage::%{_u}%})
	set {pr::%{_u}%::%{_s}%::pdmg} to bd({matchplayerdamage::%{_u}%})
	set {pr::%{_u}%::%{_s}%::jungle} to bd({matchjungleslain::%{_u}%})
	set {pr::%{_u}%::%{_s}%::fb} to bd({firstbloods::%{_u}%}) - bd({prb::%{_u}%::fb})
	set {pr::%{_u}%::%{_s}%::dtaken} to bd({damagetaken::%{_u}%}) - bd({prb::%{_u}%::dtaken})
	set {pr::%{_u}%::%{_s}%::bosses} to bd({bossesslain::%{_u}%}) - bd({prb::%{_u}%::bosses})
	set {pr::%{_u}%::%{_s}%::steals} to bd({bosssteals::%{_u}%}) - bd({prb::%{_u}%::steals})
	set {pr::%{_u}%::%{_s}%::xe} to bd({xpearly::%{_u}%}) - bd({prb::%{_u}%::xe})
	set {pr::%{_u}%::%{_s}%::xm} to bd({xpmid::%{_u}%}) - bd({prb::%{_u}%::xm})
	set {pr::%{_u}%::%{_s}%::xl} to bd({xplate::%{_u}%}) - bd({prb::%{_u}%::xl})
	set {pr::%{_u}%::%{_s}%::pge} to 1 # every match reaches the early phase
	set {pr::%{_u}%::%{_s}%::pgm} to 0
	set {pr::%{_u}%::%{_s}%::pgl} to 0
	if {_duration} >= {config::xpphase::early-end}:
		set {pr::%{_u}%::%{_s}%::pgm} to 1
	if {_duration} >= {config::xpphase::mid-end}:
		set {pr::%{_u}%::%{_s}%::pgl} to 1
	set {pr::%{_u}%::%{_s}%::lead} to 0
	set {pr::%{_u}%::%{_s}%::leadloss} to 0
	set {pr::%{_u}%::%{_s}%::behindwin} to 0
	if {hadLead::%{_u}%} is set:
		set {pr::%{_u}%::%{_s}%::lead} to 1
		if {_result} = "LOSS":
			set {pr::%{_u}%::%{_s}%::leadloss} to 1
	if {wasBehind::%{_u}%} is set:
		if {_result} = "WIN":
			set {pr::%{_u}%::%{_s}%::behindwin} to 1
	set {pr::%{_u}%::%{_s}%::mxdmg} to bd({matchdamage::%{_u}%})
	set {pr::%{_u}%::%{_s}%::mxpdmg} to bd({matchplayerdamage::%{_u}%})
	set {pr::%{_u}%::%{_s}%::mxcs} to bd({matchjungleslain::%{_u}%})
	if bd({matchdeaths::%{_u}%}) = 0:
		set {pr::%{_u}%::%{_s}%::mxkd} to bd({matchkills::%{_u}%})
	else:
		set {pr::%{_u}%::%{_s}%::mxkd} to bd({matchkills::%{_u}%}) / bd({matchdeaths::%{_u}%})

	loop integers between 1 and 3:
		set {_c} to {loadout::%{_u}%::%loop-value%}
		if {_c} is set:
			set {_k} to bd({matchkills::%{_u}%::%{_c}%})
			set {_d} to bd({matchdeaths::%{_u}%::%{_c}%})
			set {pr::%{_u}%::%{_s}%::c::%{_c}%::g} to 1
			set {pr::%{_u}%::%{_s}%::c::%{_c}%::w} to 0
			set {pr::%{_u}%::%{_s}%::c::%{_c}%::l} to 0
			if {_result} = "WIN":
				if ({_k} + {_d}) >= 3: # same anti-boost bar as the lifetime class-wins stat
					set {pr::%{_u}%::%{_s}%::c::%{_c}%::w} to 1
			else:
				set {pr::%{_u}%::%{_s}%::c::%{_c}%::l} to 1
			set {pr::%{_u}%::%{_s}%::c::%{_c}%::k} to {_k}
			set {pr::%{_u}%::%{_s}%::c::%{_c}%::d} to {_d}
			set {pr::%{_u}%::%{_s}%::c::%{_c}%::dmg} to bd({matchdamage::%{_u}%::%{_c}%})
			set {pr::%{_u}%::%{_s}%::c::%{_c}%::pd} to bd({class-playerdamage::%{_u}%::%{_c}%}) - bd({prb::%{_u}%::c::%{_c}%::pd})
			set {pr::%{_u}%::%{_s}%::c::%{_c}%::dt} to bd({class-damagetaken::%{_u}%::%{_c}%}) - bd({prb::%{_u}%::c::%{_c}%::dt})
			set {pr::%{_u}%::%{_s}%::c::%{_c}%::jg} to bd({class-jungleslain::%{_u}%::%{_c}%}) - bd({prb::%{_u}%::c::%{_c}%::jg})
			set {pr::%{_u}%::%{_s}%::c::%{_c}%::bs} to bd({class-bossesslain::%{_u}%::%{_c}%}) - bd({prb::%{_u}%::c::%{_c}%::bs})
			set {pr::%{_u}%::%{_s}%::c::%{_c}%::mxks} to bd({matchtopks::%{_u}%::%{_c}%})
	set {pr::%{_u}%::%{_s}%::ok} to true

function recentStatsAgg(target: offline player): # totals the player's last-30 window into {sv-r::<uuid>::<field>} and {sv-r::<uuid>::c::<CLASS>::<field>}; {sv-r::<uuid>::n} = matches in the window
	set {_u} to {_target}'s uuid
	delete {sv-r::%{_u}%::*}
	set {sv-r::%{_u}%::n} to 0
	# explicit field lists — the totals are built by name rather than by looping the stored list and trusting loop-index, which didn't reproduce the nested "c::CLASS::field" paths
	set {_sumf::*} to "games", "wins", "losses", "dur", "durwin", "durloss", "kills", "deaths", "fb", "dmg", "pdmg", "dtaken", "jungle", "bosses", "steals", "xe", "xm", "xl", "pge", "pgm", "pgl", "lead", "leadloss", "behindwin"
	set {_csumf::*} to "g", "w", "l", "k", "d", "dmg", "pd", "dt", "jg", "bs"
	set {_classes::*} to {menu::classlist::*}
	set {_si} to 1
	while {_si} <= 30:
		if {pr::%{_u}%::%{_si}%::ok} is set:
			add 1 to {sv-r::%{_u}%::n}
			set {_fi} to 1
			while {_fi} <= size of {_sumf::*}:
				set {_f} to {_sumf::%{_fi}%}
				add bd({pr::%{_u}%::%{_si}%::%{_f}%}) to {sv-r::%{_u}%::%{_f}%}
				add 1 to {_fi}
			set {_ci} to 1
			while {_ci} <= size of {_classes::*}:
				set {_c} to {_classes::%{_ci}%}
				set {_cfi} to 1
				while {_cfi} <= size of {_csumf::*}:
					set {_f} to {_csumf::%{_cfi}%}
					add bd({pr::%{_u}%::%{_si}%::c::%{_c}%::%{_f}%}) to {sv-r::%{_u}%::c::%{_c}%::%{_f}%}
					add 1 to {_cfi}
				add 1 to {_ci}
		add 1 to {_si}
	# best-of fields are a MAX over the window, not a sum — overwrite what the sum above produced
	set {_mx::*} to "mxks", "mxdmg", "mxpdmg", "mxcs", and "mxkd"
	set {_fi} to 1
	while {_fi} <= 5:
		set {_f} to {_mx::%{_fi}%}
		set {_best} to 0
		set {_si} to 1
		while {_si} <= 30:
			if {pr::%{_u}%::%{_si}%::ok} is set:
				if {pr::%{_u}%::%{_si}%::%{_f}%} > {_best}:
					set {_best} to {pr::%{_u}%::%{_si}%::%{_f}%}
			add 1 to {_si}
		set {sv-r::%{_u}%::%{_f}%} to {_best}
		add 1 to {_fi}
	set {_classes::*} to {menu::classlist::*}
	set {_ci} to 1
	while {_ci} <= size of {_classes::*}:
		set {_c} to {_classes::%{_ci}%}
		set {_best} to 0
		set {_si} to 1
		while {_si} <= 30:
			if {pr::%{_u}%::%{_si}%::ok} is set:
				if {pr::%{_u}%::%{_si}%::c::%{_c}%::mxks} > {_best}:
					set {_best} to {pr::%{_u}%::%{_si}%::c::%{_c}%::mxks}
			add 1 to {_si}
		set {sv-r::%{_u}%::c::%{_c}%::mxks} to {_best}
		add 1 to {_ci}
	# make sure every overall field exists, so the icons never print "<none>"
	set {_all::*} to "games", "wins", "losses", "dur", "durwin", "durloss", "kills", "deaths", "mxks", "fb", "dmg", "pdmg", "dtaken", "jungle", "bosses", "steals", "xe", "xm", "xl", "pge", "pgm", "pgl", "lead", "leadloss", "behindwin", "mxdmg", "mxpdmg", "mxcs", and "mxkd"
	set {_fi} to 1
	while {_fi} <= size of {_all::*}:
		set {_f} to {_all::%{_fi}%}
		if {sv-r::%{_u}%::%{_f}%} isn't set:
			set {sv-r::%{_u}%::%{_f}%} to 0
		add 1 to {_fi}

function lifetimeStatsView(target: offline player): # mirrors the lifetime counters into {sv-l::<uuid>::<field>} using the same field names as the recent view, so one icon builder serves both
	set {_u} to {_target}'s uuid
	delete {sv-l::%{_u}%::*}
	set {sv-l::%{_u}%::games} to bd({games::%{_u}%})
	set {sv-l::%{_u}%::wins} to bd({wins::%{_u}%})
	set {sv-l::%{_u}%::losses} to bd({losses::%{_u}%})
	set {sv-l::%{_u}%::dur} to bd({duration-total::%{_u}%})
	set {sv-l::%{_u}%::durwin} to bd({duration-win-total::%{_u}%})
	set {sv-l::%{_u}%::durloss} to bd({duration-loss-total::%{_u}%})
	set {sv-l::%{_u}%::kills} to bd({kill::%{_u}%})
	set {sv-l::%{_u}%::deaths} to bd({death::%{_u}%})
	set {sv-l::%{_u}%::mxks} to bd({ks::%{_u}%::top})
	set {sv-l::%{_u}%::fb} to bd({firstbloods::%{_u}%})
	set {sv-l::%{_u}%::dmg} to bd({damage::%{_u}%})
	set {sv-l::%{_u}%::pdmg} to bd({playerdamage::%{_u}%})
	set {sv-l::%{_u}%::dtaken} to bd({damagetaken::%{_u}%})
	set {sv-l::%{_u}%::jungle} to bd({jungleslain::%{_u}%})
	set {sv-l::%{_u}%::bosses} to bd({bossesslain::%{_u}%})
	set {sv-l::%{_u}%::steals} to bd({bosssteals::%{_u}%})
	set {sv-l::%{_u}%::xe} to bd({xpearly::%{_u}%})
	set {sv-l::%{_u}%::xm} to bd({xpmid::%{_u}%})
	set {sv-l::%{_u}%::xl} to bd({xplate::%{_u}%})
	set {sv-l::%{_u}%::pge} to bd({phasegames-early::%{_u}%})
	set {sv-l::%{_u}%::pgm} to bd({phasegames-mid::%{_u}%})
	set {sv-l::%{_u}%::pgl} to bd({phasegames-late::%{_u}%})
	set {sv-l::%{_u}%::lead} to bd({leadgames::%{_u}%})
	set {sv-l::%{_u}%::leadloss} to bd({leadlossgames::%{_u}%})
	set {sv-l::%{_u}%::behindwin} to bd({behindwingames::%{_u}%})
	set {sv-l::%{_u}%::mxdmg} to bd({bestgame-damage::%{_u}%})
	set {sv-l::%{_u}%::mxpdmg} to bd({bestgame-playerdamage::%{_u}%})
	set {sv-l::%{_u}%::mxcs} to bd({bestgame-cs::%{_u}%})
	set {sv-l::%{_u}%::mxkd} to bd({bestgame-kd::%{_u}%})

function recentBestWorstWorker(target: offline player): # the Best/Worst Class icon for the recent view — same score formula as 13-mastery.sk (win rate x 700 + K/D x 150, K/D capped at 2), computed from the window; a class is eligible once it has the games and score of the configured ranking tier
	set {_u} to {_target}'s uuid
	set {recentBestResult} to "N/A"
	set {recentWorstResult} to "N/A"
	set {_tier} to {config::mastery::min-tier-for-ranking}
	set {_bestScore} to -1
	set {_worstScore} to 999999
	loop {menu::classlist::*}:
		set {_c} to loop-value
		set {_g} to bd({sv-r::%{_u}%::c::%{_c}%::g})
		if {_g} >= {mastery-min-games::%{_tier}%}:
			set {_k} to bd({sv-r::%{_u}%::c::%{_c}%::k})
			set {_d} to bd({sv-r::%{_u}%::c::%{_c}%::d})
			if {_d} = 0:
				set {_kd} to {_k}
			else:
				set {_kd} to {_k} / {_d}
			if {_kd} > 2:
				set {_kd} to 2
			set {_score} to (safeDivide(bd({sv-r::%{_u}%::c::%{_c}%::w}), {_g}) * 700) + ({_kd} * 150)
			if {_score} >= {mastery-threshold::%{_tier}%}:
				if {_score} > {_bestScore}:
					set {_bestScore} to {_score}
					set {recentBestResult} to {_c}
				if {_score} < {_worstScore}:
					set {_worstScore} to {_score}
					set {recentWorstResult} to {_c}

function statsIcon(slot: number, target: offline player, mode: text) :: item: # builds one icon of the stats menu; mode "l" = lifetime, "r" = last 30 games
	set {_u} to {_target}'s uuid
	set {_m} to {_mode}
	set {_n} to bd({sv-r::%{_u}%::n})
	if {_m} is "r":
		set {_foot::*} to "" and "&e> Last 30 Games &7(%{_n}% played)" and "&7[CLICK] Show lifetime" and ""
	else:
		set {_foot::*} to "" and "&b> Lifetime" and "&7[CLICK] Show last 30 games" and ""
	set {_icon} to barrier named "&cUnknown"
	if {_slot} is 10:
		set {_games} to {sv-%{_m}%::%{_u}%::games}
		set {_winrate} to safeDivide({sv-%{_m}%::%{_u}%::wins}, {_games}) * 100
		set {_lore::*} to "" and "&7Games Played: &e%{_games}%" and "&7Wins: &a%{sv-%{_m}%::%{_u}%::wins}%" and "&7Losses: &c%{sv-%{_m}%::%{_u}%::losses}%" and "&7Win Rate: &e%{_winrate}%%%"
		add {_foot::*} to {_lore::*}
		set {_icon} to (nether star named "&e&lMatch Record" with lore {_lore::*}) with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	else if {_slot} is 12:
		set {_kd} to safeDivide({sv-%{_m}%::%{_u}%::kills}, {sv-%{_m}%::%{_u}%::deaths})
		set {_lore::*} to "" and "&7Kills: &e%formatNumber({sv-%{_m}%::%{_u}%::kills})%" and "&7Deaths: &e%formatNumber({sv-%{_m}%::%{_u}%::deaths})%" and "&7K/D Ratio: &e%{_kd}%" and "&7Best Killstreak: &e%{sv-%{_m}%::%{_u}%::mxks}%" and "&7First Bloods: &e%{sv-%{_m}%::%{_u}%::fb}%"
		add {_foot::*} to {_lore::*}
		set {_icon} to (iron sword named "&c&lCombat" with lore {_lore::*}) with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
		add nbt compound of "{""minecraft:tooltip_display"":{hidden_components:[""minecraft:attribute_modifiers"",""minecraft:enchantments"",""minecraft:stored_enchantments"",""minecraft:unbreakable"",""minecraft:can_break"",""minecraft:can_place_on"",""minecraft:dyed_color"",""minecraft:trim"",""minecraft:potion_contents"",""minecraft:jukebox_playable"",""minecraft:banner_patterns"",""minecraft:firework_explosion"",""minecraft:fireworks"",""minecraft:map_id"",""minecraft:bundle_contents"",""minecraft:lodestone_tracker"",""minecraft:instrument"",""minecraft:suspicious_stew_effects"",""minecraft:writable_book_content"",""minecraft:written_book_content"",""minecraft:charged_projectiles"",""minecraft:container""]}}" to nbt of {_icon} # sword's inherent attack damage/speed survive the item flag alone
	else if {_slot} is 14:
		set {_lore::*} to "" and "&7Overall Damage Dealt: &e%formatNumber({sv-%{_m}%::%{_u}%::dmg})%" and "&7Player Damage Dealt: &e%formatNumber({sv-%{_m}%::%{_u}%::pdmg})%" and "&7Damage Taken: &e%formatNumber({sv-%{_m}%::%{_u}%::dtaken})%"
		add {_foot::*} to {_lore::*}
		set {_icon} to (blaze powder named "&6&lDamage" with lore {_lore::*}) with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	else if {_slot} is 16:
		set {_games} to {sv-%{_m}%::%{_u}%::games}
		set {_avgCS} to safeDivide({sv-%{_m}%::%{_u}%::jungle}, {_games})
		set {_avgBosses} to safeDivide({sv-%{_m}%::%{_u}%::bosses}, {_games})
		set {_lore::*} to "" and "&7Jungle Mobs Slain: &e%{sv-%{_m}%::%{_u}%::jungle}%" and "&7Avg Jungle CS/Game: &e%{_avgCS}%" and "&7Bosses Slain: &e%{sv-%{_m}%::%{_u}%::bosses}%" and "&7Avg Bosses/Game: &e%{_avgBosses}%" and "&7Boss Steals: &e%{sv-%{_m}%::%{_u}%::steals}%"
		add {_foot::*} to {_lore::*}
		set {_icon} to (zombie head named "&2&lJungle & Bosses" with lore {_lore::*}) with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	else if {_slot} is 28:
		set {_avgXpEarly} to safeDivide({sv-%{_m}%::%{_u}%::xe}, {sv-%{_m}%::%{_u}%::pge})
		set {_avgXpMid} to safeDivide({sv-%{_m}%::%{_u}%::xm}, {sv-%{_m}%::%{_u}%::pgm})
		set {_avgXpLate} to safeDivide({sv-%{_m}%::%{_u}%::xl}, {sv-%{_m}%::%{_u}%::pgl})
		set {_lore::*} to "" and "&7Avg Early-Game XP: &e%{_avgXpEarly}%" and "&7Avg Mid-Game XP: &e%{_avgXpMid}%" and "&7Avg Late-Game XP: &e%{_avgXpLate}%"
		add {_foot::*} to {_lore::*}
		set {_icon} to (experience bottle named "&d&lXP by Phase" with lore {_lore::*}) with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	else if {_slot} is 22:
		set {_lore::*} to "" and "&7Highest Damage Game: &e%formatNumber({sv-%{_m}%::%{_u}%::mxdmg})%" and "&7Highest Player Damage Game: &e%formatNumber({sv-%{_m}%::%{_u}%::mxpdmg})%" and "&7Best CS Game: &e%{sv-%{_m}%::%{_u}%::mxcs}%" and "&7Best K/D Game: &e%{sv-%{_m}%::%{_u}%::mxkd}%"
		add {_foot::*} to {_lore::*}
		set {_icon} to (player head named "&6&lPersonal Records" with lore {_lore::*}) with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
		set skull owner of {_icon} to {_target}
	else if {_slot} is 30:
		set {_leadconv} to safeDivide({sv-%{_m}%::%{_u}%::leadloss}, {sv-%{_m}%::%{_u}%::lead})
		set {_leadconv} to (1 - {_leadconv}) * 100 # % of "significant lead" games that were actually won
		set {_lore::*} to "" and "&7Games With Sig. Lead: &e%{sv-%{_m}%::%{_u}%::lead}%" and "&7Games Lost After Leading: &c%{sv-%{_m}%::%{_u}%::leadloss}%" and "&7Games Won While Behind: &a%{sv-%{_m}%::%{_u}%::behindwin}%" and "&7Lead Conversion Rate: &e%{_leadconv}%%%"
		add {_foot::*} to {_lore::*}
		set {_icon} to (golden apple named "&b&lComeback Stats" with lore {_lore::*}) with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	else if {_slot} is 32:
		set {_avgDur} to formatDuration(safeDivide({sv-%{_m}%::%{_u}%::dur}, {sv-%{_m}%::%{_u}%::games}))
		set {_avgWinDur} to formatDuration(safeDivide({sv-%{_m}%::%{_u}%::durwin}, {sv-%{_m}%::%{_u}%::wins}))
		set {_avgLossDur} to formatDuration(safeDivide({sv-%{_m}%::%{_u}%::durloss}, {sv-%{_m}%::%{_u}%::losses}))
		set {_lore::*} to "" and "&7Avg Game Duration: &e%{_avgDur}%" and "&7Avg Winning Game: &a%{_avgWinDur}%" and "&7Avg Losing Game: &c%{_avgLossDur}%"
		add {_foot::*} to {_lore::*}
		set {_icon} to (clock named "&f&lDurations" with lore {_lore::*}) with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	else if {_slot} is 34:
		if {_m} is "r":
			recentBestWorstWorker({_target})
			set {_best} to {recentBestResult}
			set {_worst} to {recentWorstResult}
			set {_note} to "&8&oBest/worst of your last games; needs Bronze-level games and score."
		else:
			set {_best} to getBestClass({_target}) # 13-mastery.sk
			set {_worst} to getWorstClass({_target})
			set {_note} to "&8&oRequires Bronze+ mastery to rank."
		if {_best} = "N/A":
			set {_bestName} to "N/A"
		else:
			set {_bestName} to {class-name::%{_best}%}
		if {_worst} = "N/A":
			set {_worstName} to "N/A"
		else:
			set {_worstName} to {class-name::%{_worst}%}
		set {_lore::*} to "" and "&7Best Class: &a%{_bestName}%" and "&7Worst Class: &c%{_worstName}%" and "" and {_note}
		add {_foot::*} to {_lore::*}
		set {_icon} to (diamond named "&5&lBest / Worst Class" with lore {_lore::*}) with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	return {_icon}

function openStatsMenu(viewer: player, target: offline player):
	set {_uuid} to {_target}'s uuid
	set {_vid} to {_viewer}'s uuid
	set {_ownStats} to false
	if {_viewer}'s uuid is {_uuid}:
		set {_ownStats} to true

	if {_ownStats} is true:
		set metadata tag "stats menu" of {_viewer} to chest inventory with 6 rows named "Your Stats"
		set {_borderEnd} to 53
	else:
		set metadata tag "stats menu" of {_viewer} to chest inventory with 5 rows named "%{_target}%'s Stats"
		set {_borderEnd} to 44

	set slot (integers between 0 and 8) of metadata tag "stats menu" of {_viewer} to black stained glass pane named " "
	set slot (integers between 9 and 35) of metadata tag "stats menu" of {_viewer} to gray stained glass pane named " "
	set slot (integers between 36 and {_borderEnd}) of metadata tag "stats menu" of {_viewer} to black stained glass pane named " "

	# every icon starts on lifetime; clicking an icon flips just that icon between lifetime and last 30 games (handler below)
	delete {statsMode::%{_vid}%::*}
	set {statsTarget::%{_vid}%} to {_target}
	lifetimeStatsView({_target})
	recentStatsAgg({_target})
	set {_slots::*} to 10, 12, 14, 16, 28, 22, 30, 32, and 34
	set {_si} to 1
	while {_si} <= size of {_slots::*}:
		set {_sl} to {_slots::%{_si}%}
		set slot {_sl} of metadata tag "stats menu" of {_viewer} to statsIcon({_sl}, {_target}, "l")
		add 1 to {_si}

	# ---- back to class browser (bottom center, own stats only) ----
	if {_ownStats} is true:
		set slot 49 of metadata tag "stats menu" of {_viewer} to (enchanted book of infinity 1 named "&6&lClass Browser" with lore " " and "&7[CLICK] View") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable

	open (metadata tag "stats menu" of {_viewer}) to {_viewer}

command /stats [<offline player>]:
	trigger:
		if arg 1 is set:
			set {_target} to arg 1
		else:
			set {_target} to player
		openStatsMenu(player, {_target})

on inventory click:
	if event-inventory = (metadata tag "stats menu" of player):
		cancel event
		set {_slot} to index of event-slot
		set {_vid} to player's uuid
		if {_slot} is 49:
			openClassBrowser(player) # 18-class-browser.sk
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
		else if {_slot} is 10 or 12 or 14 or 16 or 22 or 28 or 30 or 32 or 34: # any stat icon: flip it between lifetime and last 30 games
			set {_target} to {statsTarget::%{_vid}%}
			if {_target} is set:
				if {statsMode::%{_vid}%::%{_slot}%} is "r":
					set {_new} to "l"
				else:
					set {_new} to "r"
				set {statsMode::%{_vid}%::%{_slot}%} to {_new}
				lifetimeStatsView({_target}) # refresh both views so the numbers are current
				recentStatsAgg({_target})
				set slot {_slot} of metadata tag "stats menu" of player to statsIcon({_slot}, {_target}, {_new})
				play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
	else if event-inventory = (metadata tag "match summary" of player):
		cancel event
	else if event-inventory = (metadata tag "match history" of player):
		cancel event
		set {_slot} to index of event-slot
		if {_slot} >= 1:
			if {_slot} <= 7:
				if {matchhistory::%player's uuid%::%{_slot}%::cls1} is set: # only games saved with full detail can be opened (older, pre-snapshot entries have none)
					play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
					openMatchSummary(player, {_slot})
				else if {matchhistory::%player's uuid%::%{_slot}%::result} is set:
					send "&7Detailed stats weren't saved for this older match." to player

# ---- MATCH SNAPSHOTS + HISTORY ----
# endMatch() (10-match-manager.sk) saves a full copy of each player's match
# stats the moment the match ends (snapshotMatch, into slot 0), and for real
# matches also pushes it into the rolling last-7 history (pushMatchHistory,
# slots 1-7, 1 = newest). The summary GUI below always renders from a saved
# slot — never from the live per-match variables — which is what lets the
# exact same screen be reopened later from /matchhistory. Everything is stored
# flat ({matchhistory::uuid::SLOT::field}) so shifting a slot is a plain
# key-by-key copy.
#
# Fields per slot: result, opponent, date (text, Pacific time), duration
# (seconds), kills/deaths/damage/objectives, okills/odeaths/odamage/oobjectives
# (the opponent's totals), and per loadout class i = 1..3: cls<i>, k<i>, d<i>,
# dmg<i> for the player and ocls<i>, ok<i>, od<i>, odmg<i> for the opponent.

import:
	java.time.ZonedDateTime
	java.time.ZoneId
	java.time.format.DateTimeFormatter

function stampMatchEnd(): # sets {matchEndText} to the current time in Pacific time (shows PST or PDT depending on daylight saving) — done through Java because Skript's own date formatting only knows the server's timezone. A global instead of a return value, same reason as firstAvailableClass() in 04-leveling.sk
	set {matchEndText} to ZonedDateTime.now(ZoneId.of("America/Los_Angeles")).format(DateTimeFormatter.ofPattern("MMM d, yyyy h:mm a z"))

function snapshotMatch(p: offline player, opponent: offline player, result: text, duration: number): # call stampMatchEnd() first; needs {loadout} and the per-match stats still intact
	set {_u} to {_p}'s uuid
	set {_o} to {_opponent}'s uuid
	delete {matchhistory::%{_u}%::0::*}
	set {matchhistory::%{_u}%::0::result} to {_result}
	set {matchhistory::%{_u}%::0::opponent} to "%{_opponent}%"
	set {matchhistory::%{_u}%::0::date} to {matchEndText}
	set {matchhistory::%{_u}%::0::duration} to {_duration}
	set {matchhistory::%{_u}%::0::kills} to {matchkills::%{_u}%}
	set {matchhistory::%{_u}%::0::deaths} to {matchdeaths::%{_u}%}
	set {matchhistory::%{_u}%::0::damage} to {matchdamage::%{_u}%}
	set {matchhistory::%{_u}%::0::objectives} to {matchobjectives::%{_u}%}
	set {matchhistory::%{_u}%::0::okills} to {matchkills::%{_o}%}
	set {matchhistory::%{_u}%::0::odeaths} to {matchdeaths::%{_o}%}
	set {matchhistory::%{_u}%::0::odamage} to {matchdamage::%{_o}%}
	set {matchhistory::%{_u}%::0::oobjectives} to {matchobjectives::%{_o}%}
	loop integers between 1 and 3:
		set {_i} to loop-value
		set {_class} to {loadout::%{_u}%::%{_i}%}
		if {_class} is set:
			set {matchhistory::%{_u}%::0::cls%{_i}%} to {_class}
			set {matchhistory::%{_u}%::0::k%{_i}%} to {matchkills::%{_u}%::%{_class}%}
			set {matchhistory::%{_u}%::0::d%{_i}%} to {matchdeaths::%{_u}%::%{_class}%}
			set {matchhistory::%{_u}%::0::dmg%{_i}%} to {matchdamage::%{_u}%::%{_class}%}
		set {_oclass} to {loadout::%{_o}%::%{_i}%}
		if {_oclass} is set:
			set {matchhistory::%{_u}%::0::ocls%{_i}%} to {_oclass}
			set {matchhistory::%{_u}%::0::ok%{_i}%} to {matchkills::%{_o}%::%{_oclass}%}
			set {matchhistory::%{_u}%::0::od%{_i}%} to {matchdeaths::%{_o}%::%{_oclass}%}
			set {matchhistory::%{_u}%::0::odmg%{_i}%} to {matchdamage::%{_o}%::%{_oclass}%}

function copyHistorySlot(p: offline player, from: number, to: number): # key-by-key copy of one saved match into another slot, replacing whatever was there
	delete {matchhistory::%{_p}'s uuid%::%{_to}%::*}
	loop {matchhistory::%{_p}'s uuid%::%{_from}%::*}:
		set {matchhistory::%{_p}'s uuid%::%{_to}%::%loop-index%} to loop-value

function pushMatchHistory(p: offline player): # adds the match in slot 0 as the newest history entry; the oldest of the 7 falls off the end
	loop integers between 1 and 6:
		copyHistorySlot({_p}, 7 - loop-value, 8 - loop-value) # 6->7, 5->6, ... 1->2
	copyHistorySlot({_p}, 0, 1)

# ---- END-OF-MATCH SUMMARY ----
# Opened from 10-match-manager.sk's endMatch() (slot 0 = the match that just
# ended) and from the /matchhistory GUI below (slots 1-7).

function openMatchSummary(p: player, slot: number):
	set metadata tag "match summary" of {_p} to chest inventory with 4 rows named "Match Summary"
	set slot (integers between 0 and 35) of metadata tag "match summary" of {_p} to black stained glass pane named " "

	if {matchhistory::%{_p}'s uuid%::%{_slot}%::result} = "WIN":
		set slot 4 of metadata tag "match summary" of {_p} to lime dye named "&a&lVICTORY!"
	else:
		set slot 4 of metadata tag "match summary" of {_p} to red dye named "&c&lDEFEAT"

	set {_lore::*} to "" and "&7Kills: &e%{matchhistory::%{_p}'s uuid%::%{_slot}%::kills}%" and "&7Deaths: &e%{matchhistory::%{_p}'s uuid%::%{_slot}%::deaths}%" and "&7Damage Dealt: &e%formatNumber({matchhistory::%{_p}'s uuid%::%{_slot}%::damage})%" and "&7Objectives Secured: &e%{matchhistory::%{_p}'s uuid%::%{_slot}%::objectives}%"
	set slot 10 of metadata tag "match summary" of {_p} to paper named "&e&lYour Stats" with lore {_lore::*}

	set {_lore::*} to "" and "&7Kills: &e%{matchhistory::%{_p}'s uuid%::%{_slot}%::okills}%" and "&7Deaths: &e%{matchhistory::%{_p}'s uuid%::%{_slot}%::odeaths}%" and "&7Damage Dealt: &e%formatNumber({matchhistory::%{_p}'s uuid%::%{_slot}%::odamage})%" and "&7Objectives Secured: &e%{matchhistory::%{_p}'s uuid%::%{_slot}%::oobjectives}%"
	set slot 16 of metadata tag "match summary" of {_p} to paper named "&c&l%{matchhistory::%{_p}'s uuid%::%{_slot}%::opponent}%'s Stats" with lore {_lore::*}

	loop integers between 1 and 3:
		set {_i} to loop-value
		set {_class} to {matchhistory::%{_p}'s uuid%::%{_slot}%::cls%{_i}%}
		if {_class} is set:
			set {_lore::*} to "" and "&7Kills: &e%{matchhistory::%{_p}'s uuid%::%{_slot}%::k%{_i}%}%" and "&7Deaths: &e%{matchhistory::%{_p}'s uuid%::%{_slot}%::d%{_i}%}%" and "&7Damage: &e%formatNumber({matchhistory::%{_p}'s uuid%::%{_slot}%::dmg%{_i}%})%"
			set slot (18 + {_i}) of metadata tag "match summary" of {_p} to ({class::weapon::%{_class}%} named "&e%{class-name::%{_class}%}%" with lore {_lore::*}) with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
		set {_oclass} to {matchhistory::%{_p}'s uuid%::%{_slot}%::ocls%{_i}%}
		if {_oclass} is set:
			set {_lore::*} to "" and "&7Kills: &e%{matchhistory::%{_p}'s uuid%::%{_slot}%::ok%{_i}%}%" and "&7Deaths: &e%{matchhistory::%{_p}'s uuid%::%{_slot}%::od%{_i}%}%" and "&7Damage: &e%formatNumber({matchhistory::%{_p}'s uuid%::%{_slot}%::odmg%{_i}%})%"
			set slot (22 + {_i}) of metadata tag "match summary" of {_p} to ({class::weapon::%{_oclass}%} named "&c%{class-name::%{_oclass}%}%" with lore {_lore::*}) with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable

	open (metadata tag "match summary" of {_p}) to {_p}

# ---- MATCH HISTORY (last 7) ----
# /matchhistory opens a 1-row GUI: slots 1-7 are the last 7 games, newest on
# the left. Lime dye = win, red dye = loss; clicking a game opens the same
# Match Summary screen shown at the end of the match.

function openMatchHistory(p: player):
	set metadata tag "match history" of {_p} to chest inventory with 1 rows named "Match History"
	set slot (integers between 0 and 8) of metadata tag "match history" of {_p} to black stained glass pane named " "
	loop integers between 1 and 7:
		set {_n} to loop-value
		if {matchhistory::%{_p}'s uuid%::%{_n}%::result} is set:
			if {matchhistory::%{_p}'s uuid%::%{_n}%::result} = "WIN":
				set {_icon} to lime dye named "&a&lVICTORY"
			else:
				set {_icon} to red dye named "&c&lDEFEAT"
			if {matchhistory::%{_p}'s uuid%::%{_n}%::duration} is set:
				set {_lore::*} to "" and "&7vs &f%{matchhistory::%{_p}'s uuid%::%{_n}%::opponent}%" and "&7Played: &f%{matchhistory::%{_p}'s uuid%::%{_n}%::date}%" and "&7Length: &f%formatDuration({matchhistory::%{_p}'s uuid%::%{_n}%::duration})%" and "" and "&e[CLICK] &7View match stats"
			else: # an entry saved before full match snapshots existed — only the old summary line survives
				set {_lore::*} to "" and "&7vs &f%{matchhistory::%{_p}'s uuid%::%{_n}%::opponent}%" and "" and "&8Older match - no details saved"
			set slot {_n} of metadata tag "match history" of {_p} to {_icon} with lore {_lore::*}
		else:
			set slot {_n} of metadata tag "match history" of {_p} to gray dye named "&8No game recorded"
	open (metadata tag "match history" of {_p}) to {_p}

command /matchhistory:
	trigger:
		openMatchHistory(player)

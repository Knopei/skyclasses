# ---- PAGE: Matchup Win Rates ----

function openBalanceMatchupPage(p: player):
	set metadata tag "balance matchup" of {_p} to chest inventory with 4 rows named "Matchup Win Rates"
	set slot (integers between 0 and 35) of metadata tag "balance matchup" of {_p} to gray stained glass pane named " "
	set slot (integers between 0 and 8) of metadata tag "balance matchup" of {_p} to black stained glass pane named " "
	set slot (integers between 27 and 35) of metadata tag "balance matchup" of {_p} to black stained glass pane named " "

	set {_slots::*} to 10, 11, 12, 13, 14, 15, 16, 19, 20, 21, 22, 23, 24, and 25 # 14 slots — one per class in {menu::classlist::*} (05-class-menu.sk); 25 was added for Executioner (EA), the 14th class
	loop {menu::classlist::*}:
		set {_class} to loop-value
		set {_slot} to {_slots::%loop-index%}

		set {_lore::*} to ""
		loop {menu::classlist::*}:
			set {_other} to loop-value-2
			if {_other} is not {_class}:
				set {_winsFor} to bd({balance-matchup::%{_class}%::%{_other}%})
				set {_winsAgainst} to bd({balance-matchup::%{_other}%::%{_class}%})
				set {_total} to {_winsFor} + {_winsAgainst}
				add "&7vs %{class-name::%{_other}%}%: %bpct({_winsFor}, {_total})% &8(%{_winsFor}%-%{_winsAgainst}%)" to {_lore::*}
		add "" to {_lore::*}

		set slot {_slot} of metadata tag "balance matchup" of {_p} to ({class::weapon::%{_class}%} named "&e%{class-name::%{_class}%}%" with lore {_lore::*}) with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable

	set slot 31 of metadata tag "balance matchup" of {_p} to (arrow named "&7&lBack" with lore "" and "&7[CLICK] Return") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	open (metadata tag "balance matchup" of {_p}) to {_p}


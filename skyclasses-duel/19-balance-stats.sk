# ============================================
# BALANCE STATS DASHBOARD
# Aggregate, class-level tracking (never tied to a specific player) used to
# inform overall and class balancing: ability usage/hit rate, damage by
# source, time-to-first-kill/death, matchup win rates, resource efficiency,
# consumable/perk pick rates and K/D, draft select rate, kill/boss carry
# rate, and level-vs-lives-left. Viewable in-game via /balancestats (op
# only). /resetbalancestats (also op only) wipes every tracker below back to
# empty — it never touches per-player stats (kills, deaths, class-games
# played, etc.), which live under entirely different variable names.
#
# None of this is tick-based — every counter here is incremented once,
# synchronously, from an event that was already firing (a kill, a death, a
# cast, a consume, a draft pick, a level-up), so it costs nothing extra in
# server performance beyond a handful of variable writes per event. The
# record*() functions below are called from other files at the moment the
# relevant event happens; each call site is commented "19-balance-stats.sk".
#
# DAMAGE-BY-SOURCE / HIT-RATE ATTRIBUTION: each class file tags its own
# tactical/ultimate/passive damage at the exact line that deals it —
# {balance-abilitySource::%uuid%} is set to "TAC"/"ULT"/"PASSIVE" immediately
# before the class's `damage <target> by <amount>` effect (or, for a shot
# projectile, as metadata on the projectile itself, read in 08-damage.sk's
# projectile branch) and deleted immediately after. Because Skript effects
# run synchronously and `damage` fires its EntityDamageEvent inline before
# the next line executes, this has zero misattribution window — it's set
# only for the exact instant that exact effect is resolving. Some mechanisms
# need a small, exact-duration window instead of instant set/clear, because
# their damage genuinely doesn't happen synchronously with the ability's own
# effect line:
#   - DoT damage — fire-tick (Mighty's Fire Pit, Ninja's ignites, Rapid's
#     Overheat) and wither (Reaper's passive) — setFireSource() tags the
#     VICTIM for exactly as long as the effect was applied for (matching the
#     actual `set fire to ... for N seconds` / potion-effect duration),
#     read by dmgUpdate() when a later fire-tick/wither damage event lands.
#     The function name is fire-specific from its original use, but the tag
#     itself is generic — any class can reuse it with any {_source} string.
#   - Zeus's lightning strikes — a LightningStrike entity can flash up to 3
#     times over several ticks (see extinguishMobsFor() in zeus.sk), so
#     setAbilitySourceTimed() keeps the tag alive for that same already-
#     established flash window (30 ticks for the tactical's single strike,
#     10 ticks per ultimate strike, 5 ticks for the passive's near-instant
#     sweep) instead of guessing.
# PASSIVE bucket: every class passive that deals its own direct damage is
# tagged "PASSIVE" instead of falling through to the "MELEE" default — Zeus's
# and Reaper's "every 3rd hit" procs (setAbilitySourceTimed() / setFireSource()
# respectively) and Rapid's Longshot arrow (projectile "balanceSource"
# metadata, like a TAC/ULT arrow). Ordinary melee swings that merely advance
# a passive's hit counter (no bonus damage of their own) are correctly still
# "MELEE" — only the proc's own extra damage is "PASSIVE".
# ============================================

# ---- DISPLAY HELPERS (also guard every raw counter against "unset" so the GUI never divides by/shows a variable that's never been written) ----

function bd(x: number) :: number: # "balance default" — 0 if the variable was never set
	if {_x} is set:
		return {_x}
	return 0

function bpct(numerator: number, denominator: number) :: text: # formatted "N%", or a dimmed "No data" if the denominator is empty
	set {_d} to bd({_denominator})
	if {_d} = 0:
		return "&8No data"
	set {_pct} to safeDivide(bd({_numerator}), {_d}) * 100
	return "&e%{_pct}%%%"

function bavg(sum: number, count: number) :: text: # formatted average, or "No data"
	set {_c} to bd({_count})
	if {_c} = 0:
		return "&8No data"
	set {_avg} to safeDivide(bd({_sum}), {_c})
	return "&e%{_avg}%"

function bdur(sum: number, count: number) :: text: # formatted average duration, or "No data"
	set {_c} to bd({_count})
	if {_c} = 0:
		return "&8No data"
	set {_avg} to safeDivide(bd({_sum}), {_c})
	set {_formatted} to formatDuration({_avg}) # 14-stats.sk
	return "&e%{_formatted}%"

function bkd(kills: number, deaths: number) :: text: # formatted K/D, or "No data" if this was never observed either way
	set {_k} to bd({_kills})
	set {_d} to bd({_deaths})
	if {_k} = 0:
		if {_d} = 0:
			return "&8No data"
	if {_d} = 0:
		return "&e%{_k}%"
	set {_ratio} to {_k} / {_d}
	return "&e%{_ratio}%"

function bcount(x: number) :: text: # a plain count is always meaningful at 0 — just format it safely
	return "&e%bd({_x})%"

# ---- ABILITY CASTS / HIT RATE / DAMAGE-BY-SOURCE ATTRIBUTION ----

function recordAbilityCast(p: player, source: text, manaSpent: number): # "TAC" or "ULT" — called from 03-resources.sk's tacCHECK()/ultCHECK() on every successful cast, and once from Basher's dash-bash (03-resources.sk's on sneak toggle) since that TAC isn't gated by tacCHECK
	if {testMatch} is set: # 10-match-manager.sk / 17-draft.sk — a test duel (/testduel) records no balance-dashboard stats at all
		stop
	set {_class} to {class::%{_p}'s uuid%}
	if {_class} is set:
		add 1 to {balance-ability-casts::%{_class}%::%{_source}%}
		add {_manaSpent} to {balance-mana-spent::%{_class}%}
		set {balance-abilityHit::%{_p}'s uuid%} to false # marks this cast as "not yet counted a hit" — recordDamageBySource() below flips it on the first landed hit, so an AOE/multi-hit cast only counts once toward hit rate

# ---- FIRE-TICK SOURCE TAGGING (Mighty's Fire Pit, Ninja's ignites, Rapid's Overheat) ----

function setFireSource(v: player, source: text, duration: number): # called at the moment a class ignites a player as part of a TAC/ULT effect
	set {balance-fireSource::%{_v}'s uuid%} to {_source}
	set {_setTime} to now
	set {balance-fireSourceSet::%{_v}'s uuid%} to {_setTime}
	clearFireSourceLater({_v}, {_setTime}, {_duration})

function clearFireSourceLater(v: player, setTime: date, duration: number): # runs as its own background execution — doesn't block the caller (same pattern as 11-mini-bosses.sk's respawn hologram)
	wait ("%{_duration}% seconds" parsed as a timespan)
	if {balance-fireSourceSet::%{_v}'s uuid%} = {_setTime}: # nothing newer (a fresh ignite) has overwritten it — safe to clear
		delete {balance-fireSource::%{_v}'s uuid%}
		delete {balance-fireSourceSet::%{_v}'s uuid%}

# ---- TIMED ABILITY-SOURCE TAGGING (Zeus's lightning — see the header note above) ----

function setAbilitySourceTimed(p: player, source: text, ticks: number):
	set {balance-abilitySource::%{_p}'s uuid%} to {_source}
	set {_setTime} to now
	set {balance-abilitySourceSet::%{_p}'s uuid%} to {_setTime}
	clearAbilitySourceLaterTicks({_p}, {_setTime}, {_ticks})

function clearAbilitySourceLaterTicks(p: player, setTime: date, ticks: number):
	wait ("%{_ticks}% ticks" parsed as a timespan)
	if {balance-abilitySourceSet::%{_p}'s uuid%} = {_setTime}:
		delete {balance-abilitySource::%{_p}'s uuid%}
		delete {balance-abilitySourceSet::%{_p}'s uuid%}

function recordDamageBySource(a: player, class: text, dmg: number): # called from 08-damage.sk's dmgStats(), only for confirmed player-vs-player hits — "only damage of players" per the original spec, so this stays player-victim-only
	if {testMatch} is set: # 10-match-manager.sk / 17-draft.sk — a test duel (/testduel) records no balance-dashboard stats at all
		stop
	if {balance-abilitySource::%{_a}'s uuid%} is set:
		set {_source} to {balance-abilitySource::%{_a}'s uuid%}
	else:
		set {_source} to "MELEE"
	add {_dmg} to {balance-dmg-by-source::%{_class}%::%{_source}%}

function recordAbilityHit(a: player, source: text): # called from dmgUpdate() for ANY landed TAC/ULT hit regardless of victim type — unlike damage-by-source, hit rate has to count a boss/mini-boss hit too (Paladin's ultimate and Zeus's iron-golem branch only ever land on bosses, never players, so they'd otherwise show a permanent 0% hit rate despite working exactly as designed)
	if {testMatch} is set: # 10-match-manager.sk / 17-draft.sk — a test duel (/testduel) records no balance-dashboard stats at all
		stop
	set {_class} to {class::%{_a}'s uuid%}
	if {_class} is set:
		if {balance-abilityHit::%{_a}'s uuid%} is false: # counted once per cast even if the ability hits multiple targets (AOE)
			set {balance-abilityHit::%{_a}'s uuid%} to true
			add 1 to {balance-ability-hits::%{_class}%::%{_source}%}

# ---- MATCHUPS / FIRST-KILL-DEATH / PERK & CONSUMABLE K/D ----

function levelKDBracket(level: number) :: text: # 3 brackets for the Level K/D tracker below: before level 2 (levels 0-1, no perks yet), level 2 (Perk 1 owned, not yet Perk 2), level 3 (both perks owned)
	if {_level} >= 3:
		return "3"
	else if {_level} >= 2:
		return "2"
	else:
		return "0"

function recordPvpKill(attacker: player, aClass: text, vClass: text): # called from 09-death-match.sk's kill-credit block
	if {testMatch} is set: # 10-match-manager.sk / 17-draft.sk — a test duel (/testduel) records no balance-dashboard stats at all
		stop
	add 1 to {balance-matchup::%{_aClass}%::%{_vClass}%} # per-kill exchange — aClass's kills against vClass
	add 1 to {balance-class-kills::%{_aClass}%} # global kill count for this class — mana-efficiency denominator

	# LEVEL K/D — bucketed by the killer's CURRENT level in aClass at the moment of the kill (classLevel() reads persistent classKills, which addClassKill() below hasn't incremented yet for this kill, so a kill that itself causes a level-up is still counted at the level it was earned at)
	add 1 to {balance-levelkd-kills::%{_aClass}%::%levelKDBracket(classLevel({_attacker}, {_aClass}))%}

	if {balance-firstKillDone::%{_attacker}'s uuid%::%{_aClass}%} isn't set: # once per class per match
		set {balance-firstKillDone::%{_attacker}'s uuid%::%{_aClass}%} to true
		if {matchStartTime} is set:
			set {_elapsed} to (unix timestamp of now) - {matchStartTime}
			add {_elapsed} to {balance-firstkill-sum::%{_aClass}%}
			add 1 to {balance-firstkill-count::%{_aClass}%}

	set {_perk} to {general-perk::%{_attacker}'s uuid%::selected}
	if {_perk} is set:
		add 1 to {balance-perk-kills::%{_perk}%}

	set {_consumable} to {balance-consumeWindow::%{_attacker}'s uuid%}
	if {_consumable} is set:
		add 1 to {balance-consumable-kills::%{_consumable}%}
		delete {balance-consumeWindow::%{_attacker}'s uuid%} # closes the window — recordConsumableUse() is what reopens it

function recordPvpDeath(victim: player, vClass: text): # called from 09-death-match.sk's death block, for every in-match death
	if {testMatch} is set: # 10-match-manager.sk / 17-draft.sk — a test duel (/testduel) records no balance-dashboard stats at all
		stop
	add 1 to {balance-levelkd-deaths::%{_vClass}%::%levelKDBracket(classLevel({_victim}, {_vClass}))%} # LEVEL K/D — bucketed by the victim's level in vClass at the moment of death

	if {balance-firstDeathDone::%{_victim}'s uuid%::%{_vClass}%} isn't set:
		set {balance-firstDeathDone::%{_victim}'s uuid%::%{_vClass}%} to true
		if {matchStartTime} is set:
			set {_elapsed} to (unix timestamp of now) - {matchStartTime}
			add {_elapsed} to {balance-firstdeath-sum::%{_vClass}%}
			add 1 to {balance-firstdeath-count::%{_vClass}%}

	set {_perk} to {general-perk::%{_victim}'s uuid%::selected}
	if {_perk} is set:
		add 1 to {balance-perk-deaths::%{_perk}%}

	set {_consumable} to {balance-consumeWindow::%{_victim}'s uuid%}
	if {_consumable} is set:
		add 1 to {balance-consumable-deaths::%{_consumable}%}
		delete {balance-consumeWindow::%{_victim}'s uuid%}

function recordConsumableUse(p: player, id: text): # called from 07-consumables.sk's 7 consume triggers — opens (or re-opens) the K/D tracking window
	if {testMatch} is set: # 10-match-manager.sk / 17-draft.sk — a test duel (/testduel) records no balance-dashboard stats at all
		stop
	set {balance-consumeWindow::%{_p}'s uuid%} to {_id}

# ---- DRAFT SELECT RATE ----

function recordDraftPick(picked: text): # called from 17-draft.sk right after a pick is finalized, before {draftPicked::*} is updated for it
	if {testMatch} is set: # 10-match-manager.sk / 17-draft.sk — a test duel (/testduel) records no balance-dashboard stats at all
		stop
	set {_available::*} to {menu::classlist::*} # 05-class-menu.sk
	loop {draftBanned::*}:
		remove loop-value from {_available::*}
	loop {draftPicked::*}:
		remove loop-value from {_available::*}
	loop {_available::*}:
		add 1 to {balance-draft-available::%loop-value%}
	add 1 to {balance-draft-picked::%{_picked}%}

# ---- CONSUMABLE / PERK PICK RATE (class-default, once per loadout-class per match) ----

function recordClassDefaultPicks(p: offline player, class: text): # called from 10-match-manager.sk's processEndMatchStats()
	if {testMatch} is set: # 10-match-manager.sk / 17-draft.sk — a test duel (/testduel) records no balance-dashboard stats at all
		stop
	set {_consumable} to {class-default-consumable::%{_p}'s uuid%::%{_class}%}
	if {_consumable} isn't set:
		set {_consumable} to "GA"
	add 1 to {balance-consumable-picks::%{_consumable}%}

	set {_perk} to {class-default-generalperk::%{_p}'s uuid%::%{_class}%}
	if {_perk} isn't set:
		set {_perk} to "healthyboy"
	add 1 to {balance-perk-picks::%{_perk}%}

# ---- CARRY RATE (kills / major bosses, among a player's 3 loadout classes) ----

function recordClassCarry(p: offline player): # called once per player from 10-match-manager.sk's endMatch()
	if {testMatch} is set: # 10-match-manager.sk / 17-draft.sk — a test duel (/testduel) records no balance-dashboard stats at all
		stop
	set {_c1} to {loadout::%{_p}'s uuid%::1}
	set {_c2} to {loadout::%{_p}'s uuid%::2}
	set {_c3} to {loadout::%{_p}'s uuid%::3}

	set {_k1} to {matchkills::%{_p}'s uuid%::%{_c1}%}
	set {_k2} to {matchkills::%{_p}'s uuid%::%{_c2}%}
	set {_k3} to {matchkills::%{_p}'s uuid%::%{_c3}%}
	if {_k1} isn't set:
		set {_k1} to 0
	if {_k2} isn't set:
		set {_k2} to 0
	if {_k3} isn't set:
		set {_k3} to 0
	set {_topK} to {_k1}
	if {_k2} > {_topK}:
		set {_topK} to {_k2}
	if {_k3} > {_topK}:
		set {_topK} to {_k3}
	if {_topK} > 0: # nobody "carried" if nobody got a kill on any of the 3 classes this match
		if {_k1} = {_topK}:
			add 1 to {balance-carry-kills-top::%{_c1}%}
		if {_k2} = {_topK}:
			add 1 to {balance-carry-kills-top::%{_c2}%}
		if {_k3} = {_topK}:
			add 1 to {balance-carry-kills-top::%{_c3}%}

	set {_b1} to {matchbosskills::%{_p}'s uuid%::%{_c1}%}
	set {_b2} to {matchbosskills::%{_p}'s uuid%::%{_c2}%}
	set {_b3} to {matchbosskills::%{_p}'s uuid%::%{_c3}%}
	if {_b1} isn't set:
		set {_b1} to 0
	if {_b2} isn't set:
		set {_b2} to 0
	if {_b3} isn't set:
		set {_b3} to 0
	set {_topB} to {_b1}
	if {_b2} > {_topB}:
		set {_topB} to {_b2}
	if {_b3} > {_topB}:
		set {_topB} to {_b3}
	if {_topB} > 0:
		if {_b1} = {_topB}:
			add 1 to {balance-carry-bosses-top::%{_c1}%}
		if {_b2} = {_topB}:
			add 1 to {balance-carry-bosses-top::%{_c2}%}
		if {_b3} = {_topB}:
			add 1 to {balance-carry-bosses-top::%{_c3}%}

# ---- LEVEL VS LIVES LEFT ----

function recordLevelUpLives(class: text, level: number, lives: number): # called from 04-leveling.sk's addClassKill() the instant a class reaches a new level
	if {testMatch} is set: # 10-match-manager.sk / 17-draft.sk — a test duel (/testduel) records no balance-dashboard stats at all
		stop
	add {_lives} to {balance-levelup-lives-sum::%{_class}%::%{_level}%}
	add 1 to {balance-levelup-lives-count::%{_class}%::%{_level}%}

# ============================================
# GUI — /balancestats (op only)
# ============================================

command /balancestats:
	permission: op
	trigger:
		openBalanceMainMenu(player)

function openBalanceMainMenu(p: player):
	set metadata tag "balance main" of {_p} to chest inventory with 3 rows named "Balance Dashboard"
	set slot (integers between 0 and 26) of metadata tag "balance main" of {_p} to black stained glass pane named " "

	set slot 10 of metadata tag "balance main" of {_p} to (bow named "&e&lAbility Usage & Hit Rate" with lore "" and "&7Casts, hit rate, avg casts per" and "&7game, and avg mana spent per" and "&7kill — per class." and "" and "&7[CLICK] View") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	set slot 11 of metadata tag "balance main" of {_p} to (blaze powder named "&6&lDamage by Source" with lore "" and "&7Tactical vs Ultimate vs Passive" and "&7vs Melee share of player damage" and "&7dealt, per class." and "" and "&7[CLICK] View") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	set slot 12 of metadata tag "balance main" of {_p} to (clock named "&b&lTime to First Kill/Death" with lore "" and "&7Average time into a match before" and "&7a class gets its first kill or" and "&7takes its first death." and "" and "&7[CLICK] View") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	set slot 13 of metadata tag "balance main" of {_p} to (iron sword named "&c&lMatchup Win Rates" with lore "" and "&7Win rate of each class against" and "&7every other class, based on" and "&7kill exchanges." and "" and "&7[CLICK] View") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	set slot 14 of metadata tag "balance main" of {_p} to (book named "&d&lDraft & Carry Rates" with lore "" and "&7How often a class is picked when" and "&7available, and how often it's the" and "&7top kill/boss contributor of a" and "&7player's 3 classes." and "" and "&7[CLICK] View") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	set slot 15 of metadata tag "balance main" of {_p} to (experience bottle named "&a&lLevel vs. Lives Left" with lore "" and "&7Average lives remaining when a" and "&7class reaches level 1, 2, and 3." and "" and "&7[CLICK] View") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	set slot 16 of metadata tag "balance main" of {_p} to (golden apple named "&c&lConsumable Pick Rate & K/D" with lore "" and "&7How often each consumable is set" and "&7as a default, and K/D while the" and "&7window after eating one is open." and "" and "&7[CLICK] View") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	set slot 20 of metadata tag "balance main" of {_p} to (glowstone dust named "&e&lGeneral Perk Pick Rate & K/D" with lore "" and "&7How often each perk is set as a" and "&7default, and K/D while it's the" and "&7active perk." and "" and "&7[CLICK] View") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	set slot 21 of metadata tag "balance main" of {_p} to (totem of undying named "&d&lK/D by Level" with lore "" and "&7A class's kill/death ratio before" and "&7level 2, at level 2, and at level 3 —" and "&7shows whether leveling up actually" and "&7makes a class stronger." and "" and "&7[CLICK] View") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable

	open (metadata tag "balance main" of {_p}) to {_p}

on inventory click:
	if event-inventory = (metadata tag "balance main" of player):
		cancel event
		set {_slot} to index of event-slot
		if {_slot} is 10:
			openBalanceAbilityPage(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
		else if {_slot} is 11:
			openBalanceDamageSourcePage(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
		else if {_slot} is 12:
			openBalanceTimeToKillPage(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
		else if {_slot} is 13:
			openBalanceMatchupPage(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
		else if {_slot} is 14:
			openBalanceDraftCarryPage(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
		else if {_slot} is 15:
			openBalanceLevelLivesPage(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
		else if {_slot} is 16:
			openBalanceConsumablePage(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
		else if {_slot} is 20:
			openBalancePerkPage(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
		else if {_slot} is 21:
			openBalanceLevelKDPage(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player

# ---- shared back-button handling for every read-only sub-page below ----
on inventory click:
	if event-inventory = (metadata tag "balance ability" of player):
		cancel event
		if index of event-slot is 31:
			openBalanceMainMenu(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
	else if event-inventory = (metadata tag "balance damage" of player):
		cancel event
		if index of event-slot is 31:
			openBalanceMainMenu(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
	else if event-inventory = (metadata tag "balance ttk" of player):
		cancel event
		if index of event-slot is 31:
			openBalanceMainMenu(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
	else if event-inventory = (metadata tag "balance matchup" of player):
		cancel event
		if index of event-slot is 31:
			openBalanceMainMenu(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
	else if event-inventory = (metadata tag "balance draftcarry" of player):
		cancel event
		if index of event-slot is 31:
			openBalanceMainMenu(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
	else if event-inventory = (metadata tag "balance levellives" of player):
		cancel event
		if index of event-slot is 31:
			openBalanceMainMenu(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
	else if event-inventory = (metadata tag "balance consumable" of player):
		cancel event
		if index of event-slot is 31:
			openBalanceMainMenu(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
	else if event-inventory = (metadata tag "balance perk" of player):
		cancel event
		if index of event-slot is 31:
			openBalanceMainMenu(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
	else if event-inventory = (metadata tag "balance levelkd" of player):
		cancel event
		if index of event-slot is 31:
			openBalanceMainMenu(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player

# ---- PAGE: Ability Usage & Hit Rate ----

function openBalanceAbilityPage(p: player):
	set metadata tag "balance ability" of {_p} to chest inventory with 4 rows named "Ability Usage & Hit Rate"
	set slot (integers between 0 and 35) of metadata tag "balance ability" of {_p} to gray stained glass pane named " " # fills every slot first — the border and class icons below overwrite what they need, leaving any leftover slot gray instead of empty
	set slot (integers between 0 and 8) of metadata tag "balance ability" of {_p} to black stained glass pane named " "
	set slot (integers between 27 and 35) of metadata tag "balance ability" of {_p} to black stained glass pane named " "

	set {_slots::*} to 10, 11, 12, 13, 14, 15, 16, 19, 20, 21, 22, 23, 24, and 25 # 14 slots — one per class in {menu::classlist::*} (05-class-menu.sk); 25 was added for Executioner (EA), the 14th class
	loop {menu::classlist::*}: # 05-class-menu.sk
		set {_class} to loop-value
		set {_slot} to {_slots::%loop-index%}

		set {_tacCasts} to bd({balance-ability-casts::%{_class}%::TAC})
		set {_ultCasts} to bd({balance-ability-casts::%{_class}%::ULT})
		set {_tacHits} to bd({balance-ability-hits::%{_class}%::TAC})
		set {_ultHits} to bd({balance-ability-hits::%{_class}%::ULT})
		set {_games} to bd({balance-class-games::%{_class}%})
		set {_classKills} to bd({balance-class-kills::%{_class}%})
		set {_avgManaText} to "&8No data"
		if {_classKills} > 0:
			set {_avgMana} to safeDivide(bd({balance-mana-spent::%{_class}%}), {_classKills}) / 10 # internal units -> displayed mana points
			set {_avgManaText} to "&e%{_avgMana}%"

		set {_lore::*} to "" and "&7TAC Casts: %bcount({_tacCasts})% &7Hit Rate: %bpct({_tacHits}, {_tacCasts})%" and "&7ULT Casts: %bcount({_ultCasts})% &7Hit Rate: %bpct({_ultHits}, {_ultCasts})%" and "" and "&7Avg TAC/Game: %bavg({_tacCasts}, {_games})%" and "&7Avg ULT/Game: %bavg({_ultCasts}, {_games})%" and "&7Avg Mana Spent/Kill: %{_avgManaText}%" and ""
		set slot {_slot} of metadata tag "balance ability" of {_p} to ({class::weapon::%{_class}%} named "&e%{class-name::%{_class}%}%" with lore {_lore::*}) with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable

	set slot 31 of metadata tag "balance ability" of {_p} to (arrow named "&7&lBack" with lore "" and "&7[CLICK] Return") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	open (metadata tag "balance ability" of {_p}) to {_p}

# ---- PAGE: Damage by Source ----

function openBalanceDamageSourcePage(p: player):
	set metadata tag "balance damage" of {_p} to chest inventory with 4 rows named "Damage by Source"
	set slot (integers between 0 and 35) of metadata tag "balance damage" of {_p} to gray stained glass pane named " "
	set slot (integers between 0 and 8) of metadata tag "balance damage" of {_p} to black stained glass pane named " "
	set slot (integers between 27 and 35) of metadata tag "balance damage" of {_p} to black stained glass pane named " "

	set {_slots::*} to 10, 11, 12, 13, 14, 15, 16, 19, 20, 21, 22, 23, 24, and 25 # 14 slots — one per class in {menu::classlist::*} (05-class-menu.sk); 25 was added for Executioner (EA), the 14th class
	loop {menu::classlist::*}:
		set {_class} to loop-value
		set {_slot} to {_slots::%loop-index%}

		set {_tacDmg} to bd({balance-dmg-by-source::%{_class}%::TAC})
		set {_ultDmg} to bd({balance-dmg-by-source::%{_class}%::ULT})
		set {_passiveDmg} to bd({balance-dmg-by-source::%{_class}%::PASSIVE})
		set {_meleeDmg} to bd({balance-dmg-by-source::%{_class}%::MELEE})
		set {_total} to {_tacDmg} + {_ultDmg} + {_passiveDmg} + {_meleeDmg}

		set {_lore::*} to "" and "&7Tactical: %bpct({_tacDmg}, {_total})%" and "&7Ultimate: %bpct({_ultDmg}, {_total})%" and "&7Passive: %bpct({_passiveDmg}, {_total})%" and "&7Melee: %bpct({_meleeDmg}, {_total})%" and "" and "&8&oTotal Player Damage: &7%formatNumber({_total})%" and ""
		set slot {_slot} of metadata tag "balance damage" of {_p} to ({class::weapon::%{_class}%} named "&e%{class-name::%{_class}%}%" with lore {_lore::*}) with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable

	set slot 31 of metadata tag "balance damage" of {_p} to (arrow named "&7&lBack" with lore "" and "&7[CLICK] Return") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	open (metadata tag "balance damage" of {_p}) to {_p}


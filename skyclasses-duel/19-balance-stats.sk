# ============================================
# BALANCE STATS DASHBOARD
# Aggregate, class-level tracking (never tied to a specific player) used to
# inform overall and class balancing: ability usage/hit rate, damage by
# source, time-to-first-kill/death, matchup win rates, resource efficiency,
# consumable/perk pick rates and K/D, draft select rate, kill/boss carry
# rate, and level-vs-lives-left. Viewable in-game via /balancestats (op
# only). /resetbalancestats (also op only) wipes every tracker below back to
# empty — it never touches per-player stats (kills, deaths, class-games
# played, etc.), which live under entirely different variable names.
#
# None of this is tick-based — every counter here is incremented once,
# synchronously, from an event that was already firing (a kill, a death, a
# cast, a consume, a draft pick, a level-up), so it costs nothing extra in
# server performance beyond a handful of variable writes per event. The
# record*() functions below are called from other files at the moment the
# relevant event happens; each call site is commented "19-balance-stats.sk".
#
# DAMAGE-BY-SOURCE / HIT-RATE ATTRIBUTION: each class file tags its own
# tactical/ultimate/passive damage at the exact line that deals it —
# {balance-abilitySource::%uuid%} is set to "TAC"/"ULT"/"PASSIVE" immediately
# before the class's `damage <target> by <amount>` effect (or, for a shot
# projectile, as metadata on the projectile itself, read in 08-damage.sk's
# projectile branch) and deleted immediately after. Because Skript effects
# run synchronously and `damage` fires its EntityDamageEvent inline before
# the next line executes, this has zero misattribution window — it's set
# only for the exact instant that exact effect is resolving. Some mechanisms
# need a small, exact-duration window instead of instant set/clear, because
# their damage genuinely doesn't happen synchronously with the ability's own
# effect line:
#   - DoT damage — fire-tick (Mighty's Fire Pit, Ninja's ignites, Rapid's
#     Overheat) and wither (Reaper's passive) — setFireSource() tags the
#     VICTIM for exactly as long as the effect was applied for (matching the
#     actual `set fire to ... for N seconds` / potion-effect duration),
#     read by dmgUpdate() when a later fire-tick/wither damage event lands.
#     The function name is fire-specific from its original use, but the tag
#     itself is generic — any class can reuse it with any {_source} string.
#   - Zeus's lightning strikes — a LightningStrike entity can flash up to 3
#     times over several ticks (see extinguishMobsFor() in zeus.sk), so
#     setAbilitySourceTimed() keeps the tag alive for that same already-
#     established flash window (30 ticks for the tactical's single strike,
#     10 ticks per ultimate strike, 5 ticks for the passive's near-instant
#     sweep) instead of guessing.
# PASSIVE bucket: every class passive that deals its own direct damage is
# tagged "PASSIVE" instead of falling through to the "MELEE" default — Zeus's
# and Reaper's "every 3rd hit" procs (setAbilitySourceTimed() / setFireSource()
# respectively) and Rapid's Longshot arrow (projectile "balanceSource"
# metadata, like a TAC/ULT arrow). Ordinary melee swings that merely advance
# a passive's hit counter (no bonus damage of their own) are correctly still
# "MELEE" — only the proc's own extra damage is "PASSIVE".
# ============================================

# ---- DISPLAY HELPERS (also guard every raw counter against "unset" so the GUI never divides by/shows a variable that's never been written) ----

function bd(x: number) :: number: # "balance default" — 0 if the variable was never set
	if {_x} is set:
		return {_x}
	return 0

function bpct(numerator: number, denominator: number) :: text: # formatted "N%", or a dimmed "No data" if the denominator is empty
	set {_d} to bd({_denominator})
	if {_d} = 0:
		return "&8No data"
	set {_pct} to safeDivide(bd({_numerator}), {_d}) * 100
	return "&e%{_pct}%%%"

function bavg(sum: number, count: number) :: text: # formatted average, or "No data"
	set {_c} to bd({_count})
	if {_c} = 0:
		return "&8No data"
	set {_avg} to safeDivide(bd({_sum}), {_c})
	return "&e%{_avg}%"

function bdur(sum: number, count: number) :: text: # formatted average duration, or "No data"
	set {_c} to bd({_count})
	if {_c} = 0:
		return "&8No data"
	set {_avg} to safeDivide(bd({_sum}), {_c})
	set {_formatted} to formatDuration({_avg}) # 14-stats.sk
	return "&e%{_formatted}%"

function bkd(kills: number, deaths: number) :: text: # formatted K/D, or "No data" if this was never observed either way
	set {_k} to bd({_kills})
	set {_d} to bd({_deaths})
	if {_k} = 0:
		if {_d} = 0:
			return "&8No data"
	if {_d} = 0:
		return "&e%{_k}%"
	set {_ratio} to {_k} / {_d}
	return "&e%{_ratio}%"

function bcount(x: number) :: text: # a plain count is always meaningful at 0 — just format it safely
	return "&e%bd({_x})%"

# ---- LIFETIME + RECENT-WINDOW COUNTERS ----
# balAdd() is the one place every dashboard counter is incremented: it adds to the lifetime variable {balance-<name>::<key>} AND to the current slot of the
# recent-games ring buffer ({balance-recent::<slot>::<name>::<key>}, see the RECENT-GAMES WINDOW section below). The dashboard pages read through bgv(),
# which returns either the lifetime value or the sum over the last {balance-recent-size} completed matches (balRecentAgg() must run first for the recent view).

function balAdd(name: text, key: text, amt: number):
	add {_amt} to {balance-%{_name}%::%{_key}%}
	set {_s} to {balance-recent-slot}
	if {_s} is set:
		add {_amt} to {balance-recent::%{_s}%::%{_name}%::%{_key}%}

function balRecentAgg(): # sums every counter of every completed slot into {balance-agg::<name>::<key>}; {balance-agg-games} = how many matches that was. Built from an explicit list of every counter path (balance-paths below), not by looping the stored tree, so it never depends on how nested loop indexes come back.
	delete {balance-agg::*}
	set {balance-agg-games} to 0
	set {_ids::*} to "GA", "HP", "GP", "GM", "CF", "MP", and "SP"
	set {_perks::*} to generalPerkPool() # 06-perks-general.sk
	set {_n} to 0
	loop {menu::classlist::*}:
		set {_c} to loop-value
		set {_cn::*} to "mana-spent", "class-games", "class-kills", "firstkill-sum", "firstkill-count", "firstdeath-sum", "firstdeath-count", "draft-available", "draft-picked", "carry-kills-top", and "carry-bosses-top"
		set {_k} to 1
		while {_k} <= size of {_cn::*}:
			add 1 to {_n}
			set {_paths::%{_n}%} to "%{_cn::%{_k}%}%::%{_c}%"
			add 1 to {_k}
		set {_sub::*} to "TAC", "ULT"
		set {_k} to 1
		while {_k} <= 2:
			add 1 to {_n}
			set {_paths::%{_n}%} to "ability-casts::%{_c}%::%{_sub::%{_k}%}%"
			add 1 to {_n}
			set {_paths::%{_n}%} to "ability-hits::%{_c}%::%{_sub::%{_k}%}%"
			add 1 to {_k}
		set {_src::*} to "TAC", "ULT", "PASSIVE", "MELEE"
		set {_k} to 1
		while {_k} <= 4:
			add 1 to {_n}
			set {_paths::%{_n}%} to "dmg-by-source::%{_c}%::%{_src::%{_k}%}%"
			add 1 to {_k}
		set {_k} to 1
		while {_k} <= 3:
			add 1 to {_n}
			set {_paths::%{_n}%} to "levelup-lives-sum::%{_c}%::%{_k}%"
			add 1 to {_n}
			set {_paths::%{_n}%} to "levelup-lives-count::%{_c}%::%{_k}%"
			add 1 to {_k}
		set {_k} to 1
		while {_k} <= 7:
			add 1 to {_n}
			set {_paths::%{_n}%} to "cons-games::%{_ids::%{_k}%}%::%{_c}%"
			add 1 to {_n}
			set {_paths::%{_n}%} to "cons-wins::%{_ids::%{_k}%}%::%{_c}%"
			add 1 to {_n}
			set {_paths::%{_n}%} to "perk-games::%{_perks::%{_k}%}%::%{_c}%"
			add 1 to {_n}
			set {_paths::%{_n}%} to "perk-wins::%{_perks::%{_k}%}%::%{_c}%"
			add 1 to {_k}
	set {_k} to 1
	while {_k} <= 7:
		add 1 to {_n}
		set {_paths::%{_n}%} to "consumable-picks::%{_ids::%{_k}%}%"
		add 1 to {_n}
		set {_paths::%{_n}%} to "consumable-kills::%{_ids::%{_k}%}%"
		add 1 to {_n}
		set {_paths::%{_n}%} to "consumable-deaths::%{_ids::%{_k}%}%"
		add 1 to {_n}
		set {_paths::%{_n}%} to "perk-picks::%{_perks::%{_k}%}%"
		add 1 to {_n}
		set {_paths::%{_n}%} to "perk-kills::%{_perks::%{_k}%}%"
		add 1 to {_n}
		set {_paths::%{_n}%} to "perk-deaths::%{_perks::%{_k}%}%"
		add 1 to {_k}
	set {_si} to 1
	while {_si} <= {balance-recent-size}:
		if {balance-recent-valid::%{_si}%} is set:
			add 1 to {balance-agg-games}
			set {_pi} to 1
			while {_pi} <= {_n}:
				set {_path} to {_paths::%{_pi}%}
				set {_v} to {balance-recent::%{_si}%::%{_path}%}
				if {_v} is set:
					add {_v} to {balance-agg::%{_path}%}
				add 1 to {_pi}
		add 1 to {_si}

function bgv(name: text, key: text, recent: boolean) :: number: # balance get value — lifetime or recent-window total, 0 if never set
	if {_recent} is true:
		return bd({balance-agg::%{_name}%::%{_key}%})
	return bd({balance-%{_name}%::%{_key}%})

function balRecentInfoIcon() :: item:
	return (book named "&e&lRecent Games" with lore "" and "&7Showing the last %{balance-agg-games}% completed" and "&7real match(es), out of a window of" and "&7%{balance-recent-size}%. Test duels and force-ended" and "&7matches are not counted." and "") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable

# ---- ABILITY CASTS / HIT RATE / DAMAGE-BY-SOURCE ATTRIBUTION ----

function recordAbilityCast(p: player, source: text, manaSpent: number): # "TAC" or "ULT" — called from 03-resources.sk's tacCHECK()/ultCHECK() on every successful cast, and once from Basher's dash-bash (03-resources.sk's on sneak toggle) since that TAC isn't gated by tacCHECK
	if {testMatch} is set: # 10-match-manager.sk / 17-draft.sk — a test duel (/testduel) records no balance-dashboard stats at all
		stop
	set {_class} to {class::%{_p}'s uuid%}
	if {_class} is set:
		balAdd("ability-casts", "%{_class}%::%{_source}%", 1)
		balAdd("mana-spent", {_class}, {_manaSpent})
		set {balance-abilityHit::%{_p}'s uuid%} to false # marks this cast as "not yet counted a hit" — recordDamageBySource() below flips it on the first landed hit, so an AOE/multi-hit cast only counts once toward hit rate

# ---- FIRE-TICK SOURCE TAGGING (Mighty's Fire Pit, Ninja's ignites, Rapid's Overheat) ----

function setFireSource(v: player, source: text, duration: number): # called at the moment a class ignites a player as part of a TAC/ULT effect
	set {balance-fireSource::%{_v}'s uuid%} to {_source}
	set {_setTime} to now
	set {balance-fireSourceSet::%{_v}'s uuid%} to {_setTime}
	clearFireSourceLater({_v}, {_setTime}, {_duration})

function clearFireSourceLater(v: player, setTime: date, duration: number): # runs as its own background execution — doesn't block the caller (same pattern as 11-mini-bosses.sk's respawn hologram)
	wait ("%{_duration}% seconds" parsed as a timespan)
	if {balance-fireSourceSet::%{_v}'s uuid%} = {_setTime}: # nothing newer (a fresh ignite) has overwritten it — safe to clear
		delete {balance-fireSource::%{_v}'s uuid%}
		delete {balance-fireSourceSet::%{_v}'s uuid%}

# ---- TIMED ABILITY-SOURCE TAGGING (Zeus's lightning — see the header note above) ----

function setAbilitySourceTimed(p: player, source: text, ticks: number):
	set {balance-abilitySource::%{_p}'s uuid%} to {_source}
	set {_setTime} to now
	set {balance-abilitySourceSet::%{_p}'s uuid%} to {_setTime}
	clearAbilitySourceLaterTicks({_p}, {_setTime}, {_ticks})

function clearAbilitySourceLaterTicks(p: player, setTime: date, ticks: number):
	wait ("%{_ticks}% ticks" parsed as a timespan)
	if {balance-abilitySourceSet::%{_p}'s uuid%} = {_setTime}:
		delete {balance-abilitySource::%{_p}'s uuid%}
		delete {balance-abilitySourceSet::%{_p}'s uuid%}

function recordDamageBySource(a: player, class: text, dmg: number): # called from 08-damage.sk's dmgStats(), only for confirmed player-vs-player hits — "only damage of players" per the original spec, so this stays player-victim-only
	if {testMatch} is set: # 10-match-manager.sk / 17-draft.sk — a test duel (/testduel) records no balance-dashboard stats at all
		stop
	if {balance-abilitySource::%{_a}'s uuid%} is set:
		set {_source} to {balance-abilitySource::%{_a}'s uuid%}
	else:
		set {_source} to "MELEE"
	balAdd("dmg-by-source", "%{_class}%::%{_source}%", {_dmg})

function recordAbilityHit(a: player, source: text): # called from dmgUpdate() for ANY landed TAC/ULT hit regardless of victim type — unlike damage-by-source, hit rate has to count a boss/mini-boss hit too (Paladin's ultimate and Zeus's iron-golem branch only ever land on bosses, never players, so they'd otherwise show a permanent 0% hit rate despite working exactly as designed)
	if {testMatch} is set: # 10-match-manager.sk / 17-draft.sk — a test duel (/testduel) records no balance-dashboard stats at all
		stop
	set {_class} to {class::%{_a}'s uuid%}
	if {_class} is set:
		if {balance-abilityHit::%{_a}'s uuid%} is false: # counted once per cast even if the ability hits multiple targets (AOE)
			set {balance-abilityHit::%{_a}'s uuid%} to true
			balAdd("ability-hits", "%{_class}%::%{_source}%", 1)

# ---- MATCHUPS / FIRST-KILL-DEATH / PERK & CONSUMABLE K/D ----

function levelKDBracket(level: number) :: text: # 3 brackets for the Level K/D tracker below: before level 2 (levels 0-1, no perks yet), level 2 (Perk 1 owned, not yet Perk 2), level 3 (both perks owned)
	if {_level} >= 3:
		return "3"
	else if {_level} >= 2:
		return "2"
	else:
		return "0"

# ---- RECENT-GAMES WINDOW (matchups + level K/D) ----
# The lifetime trackers above have no dates on them, so the "recent" views keep their own rolling window: the last {balance-recent-size} REAL
# matches (never /testduel), one slot per match in a ring buffer. startMatch() claims the next slot and wipes it, recordPvpKill()/recordPvpDeath()
# write into the current slot as well as the lifetime counters, and endMatch() marks the slot valid. A match that is force-ended (admin /endduel,
# disconnect before first blood) never gets marked valid, so its partial data is simply ignored. Slot layout:
#   {balance-recent::<slot>::matchup::<aClass>::<vClass>}   kills (same meaning as the lifetime {balance-matchup})
#   {balance-recent::<slot>::lkk::<class>::<bracket>}        kills by level bracket (same as {balance-levelkd-kills})
#   {balance-recent::<slot>::lkd::<class>::<bracket>}        deaths by level bracket
#   {balance-recent-valid::<slot>}                           set once that match finished normally

on load:
	set {balance-recent-size} to 30

function balanceRecentStart(): # called from 10-match-manager.sk's startMatch() for real (non-test) matches
	if {balance-recent-size} isn't set:
		set {balance-recent-size} to 30
	if {balance-recent-slot} isn't set:
		set {balance-recent-slot} to 0
	add 1 to {balance-recent-slot}
	if {balance-recent-slot} > {balance-recent-size}:
		set {balance-recent-slot} to 1
	set {_s} to {balance-recent-slot}
	delete {balance-recent::%{_s}%::*}
	delete {balance-recent-valid::%{_s}%}

function balanceRecentFinish(): # called from 10-match-manager.sk's endMatch() for real (non-test) matches — marks the current slot as a completed match
	if {balance-recent-slot} is set:
		set {_s} to {balance-recent-slot}
		set {balance-recent-valid::%{_s}%} to true

function recordPvpKill(attacker: player, aClass: text, vClass: text): # called from 09-death-match.sk's kill-credit block
	if {testMatch} is set: # 10-match-manager.sk / 17-draft.sk — a test duel (/testduel) records no balance-dashboard stats at all
		stop
	add 1 to {balance-matchup::%{_aClass}%::%{_vClass}%} # per-kill exchange — aClass's kills against vClass
	set {_slotNow} to {balance-recent-slot}
	if {_slotNow} is set:
		add 1 to {balance-recent::%{_slotNow}%::matchup::%{_aClass}%::%{_vClass}%} # recent-games window
	balAdd("class-kills", {_aClass}, 1) # global kill count for this class — mana-efficiency denominator

	# LEVEL K/D — bucketed by the killer's CURRENT level in aClass at the moment of the kill (classLevel() reads persistent classKills, which addClassKill() below hasn't incremented yet for this kill, so a kill that itself causes a level-up is still counted at the level it was earned at)
	set {_br} to levelKDBracket(classLevel({_attacker}, {_aClass}))
	add 1 to {balance-levelkd-kills::%{_aClass}%::%{_br}%}
	if {_slotNow} is set:
		add 1 to {balance-recent::%{_slotNow}%::lkk::%{_aClass}%::%{_br}%} # recent-games window

	if {balance-firstKillDone::%{_attacker}'s uuid%::%{_aClass}%} isn't set: # once per class per match
		set {balance-firstKillDone::%{_attacker}'s uuid%::%{_aClass}%} to true
		if {matchStartTime} is set:
			set {_elapsed} to (unix timestamp of now) - {matchStartTime}
			balAdd("firstkill-sum", {_aClass}, {_elapsed})
			balAdd("firstkill-count", {_aClass}, 1)

	set {_perk} to {general-perk::%{_attacker}'s uuid%::selected}
	if {_perk} is set:
		balAdd("perk-kills", {_perk}, 1)

	set {_consumable} to {balance-consumeWindow::%{_attacker}'s uuid%}
	if {_consumable} is set:
		balAdd("consumable-kills", {_consumable}, 1)
		delete {balance-consumeWindow::%{_attacker}'s uuid%} # closes the window — recordConsumableUse() is what reopens it

function recordPvpDeath(victim: player, vClass: text): # called from 09-death-match.sk's death block, for every in-match death
	if {testMatch} is set: # 10-match-manager.sk / 17-draft.sk — a test duel (/testduel) records no balance-dashboard stats at all
		stop
	set {_br} to levelKDBracket(classLevel({_victim}, {_vClass}))
	add 1 to {balance-levelkd-deaths::%{_vClass}%::%{_br}%} # LEVEL K/D — bucketed by the victim's level in vClass at the moment of death
	set {_slotNow} to {balance-recent-slot}
	if {_slotNow} is set:
		add 1 to {balance-recent::%{_slotNow}%::lkd::%{_vClass}%::%{_br}%} # recent-games window

	if {balance-firstDeathDone::%{_victim}'s uuid%::%{_vClass}%} isn't set:
		set {balance-firstDeathDone::%{_victim}'s uuid%::%{_vClass}%} to true
		if {matchStartTime} is set:
			set {_elapsed} to (unix timestamp of now) - {matchStartTime}
			balAdd("firstdeath-sum", {_vClass}, {_elapsed})
			balAdd("firstdeath-count", {_vClass}, 1)

	set {_perk} to {general-perk::%{_victim}'s uuid%::selected}
	if {_perk} is set:
		balAdd("perk-deaths", {_perk}, 1)

	set {_consumable} to {balance-consumeWindow::%{_victim}'s uuid%}
	if {_consumable} is set:
		balAdd("consumable-deaths", {_consumable}, 1)
		delete {balance-consumeWindow::%{_victim}'s uuid%}

function recordConsumableUse(p: player, id: text): # called from 07-consumables.sk's 7 consume triggers — opens (or re-opens) the K/D tracking window
	if {testMatch} is set: # 10-match-manager.sk / 17-draft.sk — a test duel (/testduel) records no balance-dashboard stats at all
		stop
	set {balance-consumeWindow::%{_p}'s uuid%} to {_id}

# ---- DRAFT SELECT RATE ----

function recordDraftPick(picked: text): # called from 17-draft.sk right after a pick is finalized, before {draftPicked::*} is updated for it
	if {testMatch} is set: # 10-match-manager.sk / 17-draft.sk — a test duel (/testduel) records no balance-dashboard stats at all
		stop
	set {_available::*} to {menu::classlist::*} # 05-class-menu.sk
	loop {draftBanned::*}:
		remove loop-value from {_available::*}
	loop {draftPicked::*}:
		remove loop-value from {_available::*}
	loop {_available::*}:
		balAdd("draft-available", loop-value, 1)
	balAdd("draft-picked", {_picked}, 1)

# ---- CONSUMABLE / PERK PICK RATE (class-default, once per loadout-class per match) ----

function recordClassDefaultPicks(p: offline player, class: text, result: text): # called from 10-match-manager.sk's processEndMatchStats()
	if {testMatch} is set: # 10-match-manager.sk / 17-draft.sk — a test duel (/testduel) records no balance-dashboard stats at all
		stop
	set {_consumable} to {class-default-consumable::%{_p}'s uuid%::%{_class}%}
	if {_consumable} isn't set:
		set {_consumable} to "GA"
	balAdd("consumable-picks", {_consumable}, 1)

	set {_perk} to {class-default-generalperk::%{_p}'s uuid%::%{_class}%}
	if {_perk} isn't set:
		set {_perk} to "healthyboy"
	balAdd("perk-picks", {_perk}, 1)

	# win rate per class WITH that consumable / perk — only games where the class was really played (3+ combined kills/deaths on it, same bar as the class-wins mastery rule)
	set {_lives} to bd({matchkills::%{_p}'s uuid%::%{_class}%}) + bd({matchdeaths::%{_p}'s uuid%::%{_class}%})
	if {_lives} >= 3:
		balAdd("cons-games", "%{_consumable}%::%{_class}%", 1)
		balAdd("perk-games", "%{_perk}%::%{_class}%", 1)
		if {_result} = "WIN":
			balAdd("cons-wins", "%{_consumable}%::%{_class}%", 1)
			balAdd("perk-wins", "%{_perk}%::%{_class}%", 1)

# ---- CARRY RATE (kills / major bosses, among a player's 3 loadout classes) ----

function recordClassCarry(p: offline player): # called once per player from 10-match-manager.sk's endMatch()
	if {testMatch} is set: # 10-match-manager.sk / 17-draft.sk — a test duel (/testduel) records no balance-dashboard stats at all
		stop
	set {_c1} to {loadout::%{_p}'s uuid%::1}
	set {_c2} to {loadout::%{_p}'s uuid%::2}
	set {_c3} to {loadout::%{_p}'s uuid%::3}

	set {_k1} to {matchkills::%{_p}'s uuid%::%{_c1}%}
	set {_k2} to {matchkills::%{_p}'s uuid%::%{_c2}%}
	set {_k3} to {matchkills::%{_p}'s uuid%::%{_c3}%}
	if {_k1} isn't set:
		set {_k1} to 0
	if {_k2} isn't set:
		set {_k2} to 0
	if {_k3} isn't set:
		set {_k3} to 0
	set {_topK} to {_k1}
	if {_k2} > {_topK}:
		set {_topK} to {_k2}
	if {_k3} > {_topK}:
		set {_topK} to {_k3}
	if {_topK} > 0: # nobody "carried" if nobody got a kill on any of the 3 classes this match
		if {_k1} = {_topK}:
			balAdd("carry-kills-top", {_c1}, 1)
		if {_k2} = {_topK}:
			balAdd("carry-kills-top", {_c2}, 1)
		if {_k3} = {_topK}:
			balAdd("carry-kills-top", {_c3}, 1)

	set {_b1} to {matchbosskills::%{_p}'s uuid%::%{_c1}%}
	set {_b2} to {matchbosskills::%{_p}'s uuid%::%{_c2}%}
	set {_b3} to {matchbosskills::%{_p}'s uuid%::%{_c3}%}
	if {_b1} isn't set:
		set {_b1} to 0
	if {_b2} isn't set:
		set {_b2} to 0
	if {_b3} isn't set:
		set {_b3} to 0
	set {_topB} to {_b1}
	if {_b2} > {_topB}:
		set {_topB} to {_b2}
	if {_b3} > {_topB}:
		set {_topB} to {_b3}
	if {_topB} > 0:
		if {_b1} = {_topB}:
			balAdd("carry-bosses-top", {_c1}, 1)
		if {_b2} = {_topB}:
			balAdd("carry-bosses-top", {_c2}, 1)
		if {_b3} = {_topB}:
			balAdd("carry-bosses-top", {_c3}, 1)

# ---- LEVEL VS LIVES LEFT ----

function recordLevelUpLives(class: text, level: number, lives: number): # called from 04-leveling.sk's addClassKill() the instant a class reaches a new level
	if {testMatch} is set: # 10-match-manager.sk / 17-draft.sk — a test duel (/testduel) records no balance-dashboard stats at all
		stop
	balAdd("levelup-lives-sum", "%{_class}%::%{_level}%", {_lives})
	balAdd("levelup-lives-count", "%{_class}%::%{_level}%", 1)

# ============================================
# GUI — /balancestats (op only)
# ============================================

command /balancestats:
	permission: op
	trigger:
		openBalanceMainMenu(player)

function openBalanceMainMenu(p: player):
	set metadata tag "balance main" of {_p} to chest inventory with 3 rows named "Balance Dashboard"
	set slot (integers between 0 and 26) of metadata tag "balance main" of {_p} to black stained glass pane named " "

	set slot 10 of metadata tag "balance main" of {_p} to (bow named "&e&lAbility Usage & Hit Rate" with lore "" and "&7Casts, hit rate, avg casts per" and "&7game, and avg mana spent per" and "&7kill — per class." and "" and "&a[RIGHT CLICK] &7Recent (last 30 games)" and "&b[LEFT CLICK] &7Lifetime") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	set slot 11 of metadata tag "balance main" of {_p} to (blaze powder named "&6&lDamage by Source" with lore "" and "&7Tactical vs Ultimate vs Passive" and "&7vs Melee share of player damage" and "&7dealt, per class." and "" and "&a[RIGHT CLICK] &7Recent (last 30 games)" and "&b[LEFT CLICK] &7Lifetime") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	set slot 12 of metadata tag "balance main" of {_p} to (clock named "&b&lTime to First Kill/Death" with lore "" and "&7Average time into a match before" and "&7a class gets its first kill or" and "&7takes its first death." and "" and "&a[RIGHT CLICK] &7Recent (last 30 games)" and "&b[LEFT CLICK] &7Lifetime") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	set slot 13 of metadata tag "balance main" of {_p} to (iron sword named "&c&lMatchup Win Rates" with lore "" and "&7Win rate of each class against" and "&7every other class, based on" and "&7kill exchanges." and "" and "&a[RIGHT CLICK] &7Recent (last 30 games)" and "&b[LEFT CLICK] &7Lifetime") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	set slot 14 of metadata tag "balance main" of {_p} to (book named "&d&lDraft & Carry Rates" with lore "" and "&7How often a class is picked when" and "&7available, and how often it's the" and "&7top kill/boss contributor of a" and "&7player's 3 classes." and "" and "&a[RIGHT CLICK] &7Recent (last 30 games)" and "&b[LEFT CLICK] &7Lifetime") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	set slot 15 of metadata tag "balance main" of {_p} to (experience bottle named "&a&lLevel vs. Lives Left" with lore "" and "&7Average lives remaining when a" and "&7class reaches level 1, 2, and 3." and "" and "&a[RIGHT CLICK] &7Recent (last 30 games)" and "&b[LEFT CLICK] &7Lifetime") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	set slot 16 of metadata tag "balance main" of {_p} to (golden apple named "&c&lConsumable Pick Rate & K/D" with lore "" and "&7How often each consumable is set" and "&7as a default, and K/D while the" and "&7window after eating one is open." and "" and "&a[RIGHT CLICK] &7Recent (last 30 games)" and "&b[LEFT CLICK] &7Lifetime") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	set slot 20 of metadata tag "balance main" of {_p} to (glowstone dust named "&e&lGeneral Perk Pick Rate & K/D" with lore "" and "&7How often each perk is set as a" and "&7default, and K/D while it's the" and "&7active perk." and "" and "&a[RIGHT CLICK] &7Recent (last 30 games)" and "&b[LEFT CLICK] &7Lifetime") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	set slot 21 of metadata tag "balance main" of {_p} to (totem of undying named "&d&lK/D by Level" with lore "" and "&7A class's kill/death ratio before" and "&7level 2, at level 2, and at level 3 —" and "&7shows whether leveling up actually" and "&7makes a class stronger." and "" and "&a[RIGHT CLICK] &7Recent (last 30 games)" and "&b[LEFT CLICK] &7Lifetime") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable

	open (metadata tag "balance main" of {_p}) to {_p}

on inventory click:
	if event-inventory = (metadata tag "balance main" of player):
		cancel event
		set {_slot} to index of event-slot
		set {_ct} to "%event.getClick()%" # RIGHT / SHIFT_RIGHT = recent games, LEFT / SHIFT_LEFT = lifetime
		set {_recent} to false
		if {_ct} contains "RIGHT":
			set {_recent} to true
		set {_opened} to true
		if {_slot} is 10:
			openBalanceAbilityPage(player, {_recent})
		else if {_slot} is 11:
			openBalanceDamageSourcePage(player, {_recent})
		else if {_slot} is 12:
			openBalanceTimeToKillPage(player, {_recent})
		else if {_slot} is 13:
			openBalanceMatchupPage(player, {_recent})
		else if {_slot} is 14:
			openBalanceDraftCarryPage(player, {_recent})
		else if {_slot} is 15:
			openBalanceLevelLivesPage(player, {_recent})
		else if {_slot} is 16:
			openBalanceConsumablePage(player, {_recent})
		else if {_slot} is 20:
			openBalancePerkPage(player, {_recent})
		else if {_slot} is 21:
			openBalanceLevelKDPage(player, {_recent})
		else:
			set {_opened} to false
		if {_opened} is true:
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player

# ---- shared back-button handling for every read-only sub-page below ----
on inventory click:
	if event-inventory = (metadata tag "balance ability" of player):
		cancel event
		if index of event-slot is 31:
			openBalanceMainMenu(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
	else if event-inventory = (metadata tag "balance damage" of player):
		cancel event
		if index of event-slot is 31:
			openBalanceMainMenu(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
	else if event-inventory = (metadata tag "balance ttk" of player):
		cancel event
		if index of event-slot is 31:
			openBalanceMainMenu(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
	else if event-inventory = (metadata tag "balance matchup" of player):
		cancel event
		if index of event-slot is 31:
			openBalanceMainMenu(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
	else if event-inventory = (metadata tag "balance draftcarry" of player):
		cancel event
		if index of event-slot is 31:
			openBalanceMainMenu(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
	else if event-inventory = (metadata tag "balance levellives" of player):
		cancel event
		if index of event-slot is 31:
			openBalanceMainMenu(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
	else if event-inventory = (metadata tag "balance consumable" of player):
		cancel event
		if index of event-slot is 31:
			openBalanceMainMenu(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
	else if event-inventory = (metadata tag "balance perk" of player):
		cancel event
		if index of event-slot is 31:
			openBalanceMainMenu(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
	else if event-inventory = (metadata tag "balance levelkd" of player):
		cancel event
		if index of event-slot is 31:
			openBalanceMainMenu(player)
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player

# ---- PAGE: Ability Usage & Hit Rate ----

function openBalanceAbilityPage(p: player, recent: boolean):
	if {_recent} is true:
		balRecentAgg()
		set {_title} to "Ability Usage & Hit Rate (Recent)"
	else:
		set {_title} to "Ability Usage & Hit Rate (Lifetime)"
	set metadata tag "balance ability" of {_p} to chest inventory with 4 rows named {_title}
	set slot (integers between 0 and 35) of metadata tag "balance ability" of {_p} to gray stained glass pane named " "
	set slot (integers between 0 and 8) of metadata tag "balance ability" of {_p} to black stained glass pane named " "
	set slot (integers between 27 and 35) of metadata tag "balance ability" of {_p} to black stained glass pane named " "

	set {_slots::*} to 10, 11, 12, 13, 14, 15, 16, 19, 20, 21, 22, 23, 24, and 25 # 14 slots — one per class in {menu::classlist::*} (05-class-menu.sk)
	loop {menu::classlist::*}: # 05-class-menu.sk
		set {_class} to loop-value
		set {_slot} to {_slots::%loop-index%}

		set {_tacCasts} to bgv("ability-casts", "%{_class}%::TAC", {_recent})
		set {_ultCasts} to bgv("ability-casts", "%{_class}%::ULT", {_recent})
		set {_tacHits} to bgv("ability-hits", "%{_class}%::TAC", {_recent})
		set {_ultHits} to bgv("ability-hits", "%{_class}%::ULT", {_recent})
		set {_games} to bgv("class-games", {_class}, {_recent})
		set {_classKills} to bgv("class-kills", {_class}, {_recent})
		set {_manaSpent} to bgv("mana-spent", {_class}, {_recent})
		set {_avgManaText} to "&8No data"
		if {_classKills} > 0:
			set {_avgMana} to safeDivide({_manaSpent}, {_classKills}) / 10 # internal units -> displayed mana points
			set {_avgManaText} to "&e%{_avgMana}%"

		set {_lore::*} to "" and "&7TAC Casts: %bcount({_tacCasts})% &7Hit Rate: %bpct({_tacHits}, {_tacCasts})%" and "&7ULT Casts: %bcount({_ultCasts})% &7Hit Rate: %bpct({_ultHits}, {_ultCasts})%" and "" and "&7Avg TAC/Game: %bavg({_tacCasts}, {_games})%" and "&7Avg ULT/Game: %bavg({_ultCasts}, {_games})%" and "&7Avg Mana Spent/Kill: %{_avgManaText}%" and ""
		set slot {_slot} of metadata tag "balance ability" of {_p} to ({class::weapon::%{_class}%} named "&e%{class-name::%{_class}%}%" with lore {_lore::*}) with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable

	set slot 31 of metadata tag "balance ability" of {_p} to (arrow named "&7&lBack" with lore "" and "&7[CLICK] Return") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	if {_recent} is true:
		set slot 30 of metadata tag "balance ability" of {_p} to balRecentInfoIcon()
	open (metadata tag "balance ability" of {_p}) to {_p}

# ---- PAGE: Damage by Source ----

function openBalanceDamageSourcePage(p: player, recent: boolean):
	if {_recent} is true:
		balRecentAgg()
		set {_title} to "Damage by Source (Recent)"
	else:
		set {_title} to "Damage by Source (Lifetime)"
	set metadata tag "balance damage" of {_p} to chest inventory with 4 rows named {_title}
	set slot (integers between 0 and 35) of metadata tag "balance damage" of {_p} to gray stained glass pane named " "
	set slot (integers between 0 and 8) of metadata tag "balance damage" of {_p} to black stained glass pane named " "
	set slot (integers between 27 and 35) of metadata tag "balance damage" of {_p} to black stained glass pane named " "

	set {_slots::*} to 10, 11, 12, 13, 14, 15, 16, 19, 20, 21, 22, 23, 24, and 25 # 14 slots — one per class in {menu::classlist::*} (05-class-menu.sk)
	loop {menu::classlist::*}:
		set {_class} to loop-value
		set {_slot} to {_slots::%loop-index%}

		set {_tacDmg} to bgv("dmg-by-source", "%{_class}%::TAC", {_recent})
		set {_ultDmg} to bgv("dmg-by-source", "%{_class}%::ULT", {_recent})
		set {_passiveDmg} to bgv("dmg-by-source", "%{_class}%::PASSIVE", {_recent})
		set {_meleeDmg} to bgv("dmg-by-source", "%{_class}%::MELEE", {_recent})
		set {_total} to {_tacDmg} + {_ultDmg} + {_passiveDmg} + {_meleeDmg}

		set {_lore::*} to "" and "&7Tactical: %bpct({_tacDmg}, {_total})%" and "&7Ultimate: %bpct({_ultDmg}, {_total})%" and "&7Passive: %bpct({_passiveDmg}, {_total})%" and "&7Melee: %bpct({_meleeDmg}, {_total})%" and "" and "&8&oTotal Player Damage: &7%formatNumber({_total})%" and ""
		set slot {_slot} of metadata tag "balance damage" of {_p} to ({class::weapon::%{_class}%} named "&e%{class-name::%{_class}%}%" with lore {_lore::*}) with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable

	set slot 31 of metadata tag "balance damage" of {_p} to (arrow named "&7&lBack" with lore "" and "&7[CLICK] Return") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	if {_recent} is true:
		set slot 30 of metadata tag "balance damage" of {_p} to balRecentInfoIcon()
	open (metadata tag "balance damage" of {_p}) to {_p}

# ---- PAGE: Time to First Kill/Death ----

function openBalanceTimeToKillPage(p: player, recent: boolean):
	if {_recent} is true:
		balRecentAgg()
		set {_title} to "Time to First Kill/Death (Recent)"
	else:
		set {_title} to "Time to First Kill/Death (Lifetime)"
	set metadata tag "balance ttk" of {_p} to chest inventory with 4 rows named {_title}
	set slot (integers between 0 and 35) of metadata tag "balance ttk" of {_p} to gray stained glass pane named " "
	set slot (integers between 0 and 8) of metadata tag "balance ttk" of {_p} to black stained glass pane named " "
	set slot (integers between 27 and 35) of metadata tag "balance ttk" of {_p} to black stained glass pane named " "

	set {_slots::*} to 10, 11, 12, 13, 14, 15, 16, 19, 20, 21, 22, 23, 24, and 25 # 14 slots — one per class in {menu::classlist::*} (05-class-menu.sk)
	loop {menu::classlist::*}:
		set {_class} to loop-value
		set {_slot} to {_slots::%loop-index%}

		set {_fkSum} to bgv("firstkill-sum", {_class}, {_recent})
		set {_fkCount} to bgv("firstkill-count", {_class}, {_recent})
		set {_fdSum} to bgv("firstdeath-sum", {_class}, {_recent})
		set {_fdCount} to bgv("firstdeath-count", {_class}, {_recent})
		set {_lore::*} to "" and "&7Avg Time to First Kill:" and bdur({_fkSum}, {_fkCount}) and "" and "&7Avg Time to First Death:" and bdur({_fdSum}, {_fdCount}) and ""
		set slot {_slot} of metadata tag "balance ttk" of {_p} to ({class::weapon::%{_class}%} named "&e%{class-name::%{_class}%}%" with lore {_lore::*}) with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable

	set slot 31 of metadata tag "balance ttk" of {_p} to (arrow named "&7&lBack" with lore "" and "&7[CLICK] Return") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	if {_recent} is true:
		set slot 30 of metadata tag "balance ttk" of {_p} to balRecentInfoIcon()
	open (metadata tag "balance ttk" of {_p}) to {_p}

# ---- PAGE: Matchup Win Rates ----

function openBalanceMatchupPage(p: player, recent: boolean):
	# ---- gather the kill matrix {_mu::A::B} from whichever source this page is showing ----
	set {_classes::*} to {menu::classlist::*}
	set {_count} to size of {_classes::*}
	set {_games} to 0
	if {_recent} is true:
		set {_si} to 1
		while {_si} <= {balance-recent-size}:
			if {balance-recent-valid::%{_si}%} is set:
				add 1 to {_games}
				set {_ai} to 1
				while {_ai} <= {_count}:
					set {_ca} to {_classes::%{_ai}%}
					set {_bi} to 1
					while {_bi} <= {_count}:
						set {_cb} to {_classes::%{_bi}%}
						add bd({balance-recent::%{_si}%::matchup::%{_ca}%::%{_cb}%}) to {_mu::%{_ca}%::%{_cb}%}
						add 1 to {_bi}
					add 1 to {_ai}
			add 1 to {_si}
		set {_title} to "Matchup Win Rates (Recent)"
	else:
		set {_ai} to 1
		while {_ai} <= {_count}:
			set {_ca} to {_classes::%{_ai}%}
			set {_bi} to 1
			while {_bi} <= {_count}:
				set {_cb} to {_classes::%{_bi}%}
				set {_mu::%{_ca}%::%{_cb}%} to bd({balance-matchup::%{_ca}%::%{_cb}%})
				add 1 to {_bi}
			add 1 to {_ai}
		set {_title} to "Matchup Win Rates (Lifetime)"

	set metadata tag "balance matchup" of {_p} to chest inventory with 4 rows named {_title}
	set slot (integers between 0 and 35) of metadata tag "balance matchup" of {_p} to gray stained glass pane named " "
	set slot (integers between 0 and 8) of metadata tag "balance matchup" of {_p} to black stained glass pane named " "
	set slot (integers between 27 and 35) of metadata tag "balance matchup" of {_p} to black stained glass pane named " "

	set {_slots::*} to 10, 11, 12, 13, 14, 15, 16, 19, 20, 21, 22, 23, 24, and 25 # 14 slots — one per class in {menu::classlist::*} (05-class-menu.sk); 25 was added for Executioner (EA), the 14th class
	set {_opps} to {_count} - 1 # opponents per class
	set {_cats::*} to "STRIKER", "JUGGERNAUT", and "SKIRMISHER"
	set {_ci} to 1
	while {_ci} <= {_count}: # plain counters instead of nested "loop"s — keeps loop-value unambiguous
		set {_class} to {_classes::%{_ci}%}
		set {_slot} to {_slots::%{_ci}%}

		# ---- every opponent: kills for / against, and a numeric win rate to sort on ----
		delete {_rate::*}
		delete {_wf::*}
		delete {_wa::*}
		delete {_used::*}
		set {_allFor} to 0
		set {_allAgainst} to 0
		set {_oi} to 1
		while {_oi} <= {_count}:
			set {_other} to {_classes::%{_oi}%}
			if {_other} is not {_class}:
				set {_wf::%{_oi}%} to bd({_mu::%{_class}%::%{_other}%})
				set {_wa::%{_oi}%} to bd({_mu::%{_other}%::%{_class}%})
				set {_tot} to {_wf::%{_oi}%} + {_wa::%{_oi}%}
				if {_tot} > 0:
					set {_rate::%{_oi}%} to {_wf::%{_oi}%} / {_tot}
				else:
					set {_rate::%{_oi}%} to -1 # no data — sorts to the bottom
				add {_wf::%{_oi}%} to {_allFor}
				add {_wa::%{_oi}%} to {_allAgainst}
			add 1 to {_oi}

		# ---- summary lines: overall + each category (pooled kills across every class in it, so bigger samples weigh more) ----
		set {_allTotal} to {_allFor} + {_allAgainst}
		set {_lore::*} to "" and "&6&lOverall: %bpct({_allFor}, {_allTotal})% &8(%{_allFor}%-%{_allAgainst}%)"
		set {_k} to 1
		while {_k} <= 3:
			set {_cat} to {_cats::%{_k}%}
			set {_cf} to 0
			set {_ca} to 0
			loop {category-classes::%{_cat}%::*}:
				if loop-value is not {_class}:
					add bd({_mu::%{_class}%::%loop-value%}) to {_cf}
					add bd({_mu::%loop-value%::%{_class}%}) to {_ca}
			set {_catTotal} to {_cf} + {_ca}
			add "&7vs %{category-color::%{_cat}%}%%{category-name::%{_cat}%}%s: %bpct({_cf}, {_catTotal})% &8(%{_cf}%-%{_ca}%)" to {_lore::*}
			add 1 to {_k}
		add "" to {_lore::*}

		# ---- per-class lines, highest win rate first ----
		set {_n} to 0
		while {_n} < {_opps}:
			set {_best} to 0
			set {_bestRate} to -2
			set {_oi} to 1
			while {_oi} <= {_count}:
				if {_rate::%{_oi}%} is set:
					if {_used::%{_oi}%} isn't set:
						if {_rate::%{_oi}%} > {_bestRate}:
							set {_bestRate} to {_rate::%{_oi}%}
							set {_best} to {_oi}
				add 1 to {_oi}
			set {_used::%{_best}%} to true
			set {_bOther} to {_classes::%{_best}%}
			set {_bf} to {_wf::%{_best}%}
			set {_ba} to {_wa::%{_best}%}
			set {_bt} to {_bf} + {_ba}
			add "&7vs %{class-name::%{_bOther}%}%: %bpct({_bf}, {_bt})% &8(%{_bf}%-%{_ba}%)" to {_lore::*}
			add 1 to {_n}
		add "" to {_lore::*}

		set slot {_slot} of metadata tag "balance matchup" of {_p} to ({class::weapon::%{_class}%} named "&e%{class-name::%{_class}%}%" with lore {_lore::*}) with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
		add 1 to {_ci}

	set slot 31 of metadata tag "balance matchup" of {_p} to (arrow named "&7&lBack" with lore "" and "&7[CLICK] Return") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	if {_recent} is true:
		set slot 30 of metadata tag "balance matchup" of {_p} to (book named "&e&lRecent Games" with lore "" and "&7Showing the last %{_games}% completed" and "&7real match(es), out of a window of" and "&7%{balance-recent-size}%. Test duels and force-ended" and "&7matches are not counted." and "") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	open (metadata tag "balance matchup" of {_p}) to {_p}

# ---- PAGE: Draft & Carry Rates ----

function openBalanceDraftCarryPage(p: player, recent: boolean):
	if {_recent} is true:
		balRecentAgg()
		set {_title} to "Draft & Carry Rates (Recent)"
	else:
		set {_title} to "Draft & Carry Rates (Lifetime)"
	set metadata tag "balance draftcarry" of {_p} to chest inventory with 4 rows named {_title}
	set slot (integers between 0 and 35) of metadata tag "balance draftcarry" of {_p} to gray stained glass pane named " "
	set slot (integers between 0 and 8) of metadata tag "balance draftcarry" of {_p} to black stained glass pane named " "
	set slot (integers between 27 and 35) of metadata tag "balance draftcarry" of {_p} to black stained glass pane named " "

	set {_slots::*} to 10, 11, 12, 13, 14, 15, 16, 19, 20, 21, 22, 23, 24, and 25 # 14 slots — one per class in {menu::classlist::*} (05-class-menu.sk)
	loop {menu::classlist::*}:
		set {_class} to loop-value
		set {_slot} to {_slots::%loop-index%}

		set {_games} to bgv("class-games", {_class}, {_recent})
		set {_picked} to bgv("draft-picked", {_class}, {_recent})
		set {_avail} to bgv("draft-available", {_class}, {_recent})
		set {_ck} to bgv("carry-kills-top", {_class}, {_recent})
		set {_cb} to bgv("carry-bosses-top", {_class}, {_recent})

		set {_lore::*} to "" and "&7Draft Select Rate: %bpct({_picked}, {_avail})%" and "" and "&7Kill Carry Rate: %bpct({_ck}, {_games})%" and "&7Boss Carry Rate: %bpct({_cb}, {_games})%" and ""
		set slot {_slot} of metadata tag "balance draftcarry" of {_p} to ({class::weapon::%{_class}%} named "&e%{class-name::%{_class}%}%" with lore {_lore::*}) with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable

	set slot 31 of metadata tag "balance draftcarry" of {_p} to (arrow named "&7&lBack" with lore "" and "&7[CLICK] Return") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	if {_recent} is true:
		set slot 30 of metadata tag "balance draftcarry" of {_p} to balRecentInfoIcon()
	open (metadata tag "balance draftcarry" of {_p}) to {_p}


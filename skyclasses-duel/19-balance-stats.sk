# ---- PAGE: Consumable Pick Rate & K/D ----

function openBalanceConsumablePage(p: player):
	set metadata tag "balance consumable" of {_p} to chest inventory with 4 rows named "Consumable Pick Rate & K/D"
	set slot (integers between 0 and 35) of metadata tag "balance consumable" of {_p} to gray stained glass pane named " "
	set slot (integers between 0 and 8) of metadata tag "balance consumable" of {_p} to black stained glass pane named " "
	set slot (integers between 27 and 35) of metadata tag "balance consumable" of {_p} to black stained glass pane named " "

	set {_ids::*} to "GA", "HP", "GP", "GM", "CF", "MP", and "SP" # 07-consumables.sk's {health-item::*} — kept as an explicit list rather than looping the persistent variable directly: {health-item::*} also picks up unrelated nested entries like {health-item::%uuid%::item} (a player's cached selection), which broke slot lookups here (that's the missing-icon bug)
	set {_totalPicks} to 0
	loop {_ids::*}:
		add bd({balance-consumable-picks::%loop-value%}) to {_totalPicks}

	set {_slots::*} to 10, 11, 12, 13, 14, 15, and 16 # centers 7 icons on row 2 (absolute slots 9-17) — a fixed lookup list matched by loop-index, same proven pattern as every other page in this file, instead of a floor()/arithmetic row calc that was silently producing bad slots and swallowing every icon
	loop {_ids::*}:
		set {_id} to loop-value
		set {_slot} to {_slots::%loop-index%}
		set {_kills} to bd({balance-consumable-kills::%{_id}%})
		set {_deaths} to bd({balance-consumable-deaths::%{_id}%})

		set {_lore::*} to "" and "&7Default Pick Share: %bpct({balance-consumable-picks::%{_id}%}, {_totalPicks})%" and "&8&o(%bd({balance-consumable-picks::%{_id}%})% picks)" and "" and "&7K/D While Active: %bkd({_kills}, {_deaths})%" and "&8&o(%{_kills}%K / %{_deaths}%D)" and ""
		set slot {_slot} of metadata tag "balance consumable" of {_p} to ({health-item::%{_id}%} named "&e%name of {health-item::%{_id}%}%" with lore {_lore::*}) with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable

	set slot 31 of metadata tag "balance consumable" of {_p} to (arrow named "&7&lBack" with lore "" and "&7[CLICK] Return") with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable
	open (metadata tag "balance consumable" of {_p}) to {_p}


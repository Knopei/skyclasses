	set slot (integers between 0 and 8) of metadata tag "balance levellives" of {_p} to black stained glass pane named " "
	set slot (integers between 27 and 35) of metadata tag "balance levellives" of {_p} to black stained glass pane named " "

	set {_slots::*} to 10, 11, 12, 13, 14, 15, 16, 19, 20, 21, 22, 23, 24, and 25 # 14 slots — one per class in {menu::classlist::*} (05-class-menu.sk)
	loop {menu::classlist::*}:
		set {_class} to loop-value

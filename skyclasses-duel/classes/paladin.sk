# ============================================
# PALADIN (PGS) — Paladin Great Sword
# Tactical: always available. Ultimate: unlocks at class level 1.
# Tactical "Holy Shield": 2 absorption hearts for 2 seconds (3 with Perk 1), or until broken.
# Perk 1 (level 2) "Elder Shield": the shield lasts 3 seconds instead of 2.
#   (Replaced "Agile Shield", a speed burst while shielded — the tactical gives no speed.)
# Perk 2 (level 3) "Supreme Radiance": larger ultimate radius.
# ============================================

on right click with iron sword: # TACTICAL
	if name of player's held item is "%{wc}%Paladin Great Sword":
		if tacCHECK(player, {weapons::PGS::TAC-COST}) is true:
			if classLevel(player, "PGS") >= 2: # Perk 1 (Elder Shield) — 3 seconds instead of 2
				add potion effect of absorption 1 without particles for 3 seconds to potion effects of player
			else:
				add potion effect of absorption 1 without particles for 2 seconds to potion effects of player
			play sound "BLOCK_ANVIL_PLACE" with volume 1 and pitch 0.25 at player
			set {_shapes::circle} to a circle with radius 1.25
			set particle of {_shapes::*} to 1 of dust_color_transition particle using dustTransition(yellow, white, 0.75)
			set {_rotation} to rotation around vector(1, 1, 1) by 9 degrees
			while (absorption amount of player) > 0:
				set {_loc} to player's location
				add 1 to y-coord of {_loc}
				rotate shapes {_shapes::*} by {_rotation}
				draw shapes {_shapes::*} at {_loc}
				wait 2 tick

on damage of player: # visual cue while the tactical shield is absorbing hits
	if (absorption amount of victim) > 0:
		if {class::%victim's uuid%} = "PGS":
			set {_loc} to location of victim
			set {_x} to random number between -1 and 1
			set {_y} to random number between 1 and 1.5
			add {_x} to x-coord of {_loc}
			add {_y} to y-coord of {_loc}
			spawn 1 armor stand at {_loc}
			set {_ls} to last spawned armor stand
			add nbt compound of "{CustomNameVisible:1,NoGravity:1b,Small:1,Invisible:1,Invulnerable:1,NoBasePlate:1,Marker:1b}" to nbt compound of last spawned armor stand
			set name of last spawned armor stand to "&6✧&e&oSHIELDED&6✧"
			wait 1 second
			teleport {_ls} to block 100 below {_ls} # moved far away first so no armor-stand break sound plays near the player (same as showDMG in 01-utils.sk)
			wait 1 tick
			{_ls}.remove()

on drop of iron sword with priority low: # ULTIMATE
	if name of event-item is "%{wc}%Paladin Great Sword":
		cancel event
		if classLevel(player, "PGS") < 1:
			send "&cUltimate locked! Reach class level 1 to unlock." to player
			stop
		set {_ultCooldown} to ultCooldownFor(player, {weapons::PGS::ULT-CD}) # 06-perks-general.sk — Spell Caster
		if {godlike-ULT-USE::%player's uuid%::PGS} is set:
			send "&cULT ALREADY ACTIVATED!" to player
		else if {godlike-ULT-CD::%player's uuid%::PGS} is set:
			set {_time} to difference between now and {godlike-ULT-CD::%player's uuid%::PGS}
			if {_time} < {_ultCooldown}:
				send "&cULT NOT READY!" to player
		else if ultCHECK(player, {weapons::PGS::ULT-COST}) is true:
			ultPGS(player, {_ultCooldown}, classLevel(player, "PGS"), false) # the body is a function so Spell Breaker can cast it too (spellbreaker.sk)

function ultPGS(p: player, cd: timespan, lvl: number, sb: boolean): # ULTIMATE body — {_lvl} = the level it runs at, {_sb} = cast by Spell Breaker (spellbreaker.sk: no cooldown of its own)
	set {godlike-ULT-USE::%{_p}'s uuid%::PGS} to now
	healHP({_p}, 0.5) # 20-combat.sk (Lingering Wounds) — half a heart the moment the radiance is placed
	set {_pal} to {_p}
	if {_lvl} >= 3: # Perk 2 (Supreme Radiance)
		set {_shapes::outer-circle} to a circle of radius 7.5
		set {_shapes::inner-circle} to a circle of radius 7.25
		set {_shapes::tiny-circle} to a circle of radius 3
		set {_shapes::teeny-circle} to a circle of radius 1.5
		set {_shapes::triangle-1} to a triangle with radius 7
		set {_shapes::triangle-2} to a triangle with radius 7
		set {_ultDmgRadius} to 7.75
	else:
		set {_shapes::outer-circle} to a circle of radius 5
		set {_shapes::inner-circle} to a circle of radius 4.75
		set {_shapes::tiny-circle} to a circle of radius 1.5
		set {_shapes::triangle-1} to a triangle with radius 4.5
		set {_shapes::triangle-2} to a triangle with radius 4.5
		set {_ultDmgRadius} to 5.25

	rotate shapes {_shapes::triangle-2} around y axis by 60 degrees
	set particle of {_shapes::*} to 1 of dust_color_transition particle using dustTransition(yellow, white, 1)
	set {_loc} to {_p}'s location
	set {_y-max} to y-coord of {_loc}+2
	set {_y-min} to y-coord of {_loc}-2
	loop 32 times: # 32 x 5 ticks = 8 seconds (was 40 = 10)
		if {godlike-ULT-CANCEL::%{_p}'s uuid%::PGS} is set: # set by 09-death-match.sk when the Paladin dies — the radiance ends with it
			stop loop
		add 1 to {_n}
		draw shapes {_shapes::*} at {_loc}
		if {_n} = 4:
			delete {_n}
			loop all living entities in radius {_ultDmgRadius} around {_loc}:
				if loop-entity is {_pal}: # only the Paladin itself is buffed (this used to be every player in the radius — enemies included)
					add potion effect of speed 2 for 1 seconds to potion effects of loop-entity
					add potion effect of regeneration 3 for 1 seconds to potion effects of loop-entity
				else if loop-entity is not an armor stand: # everyone else — enemy players and mobs: slowness 1 + 1 heart per tick
					if y-coord of loop-entity is between {_y-max} and {_y-min}:
						updateAttacker({_p}, loop-entity)
						add potion effect of slowness 1 for 1 seconds to potion effects of loop-entity
						damage loop-entity by 1
						play sound "BLOCK_ANVIL_PLACE" with volume 0.5 and pitch 3 at {_loc}
		wait 5 tick
	set {godlike-ULT-CD::%{_p}'s uuid%::PGS} to now
	delete {godlike-ULT-USE::%{_p}'s uuid%::PGS}
	delete {godlike-ULT-CANCEL::%{_p}'s uuid%::PGS}
	# ULT CD
	if {_sb} is true: # Spell Breaker's stolen cast has no cooldown of its own (spellbreaker.sk runs Spell Breaker's)
		delete {godlike-ULT-CD::%{_p}'s uuid%::PGS}
		stop
	wait {_cd}
	delete {godlike-ULT-CD::%{_p}'s uuid%::PGS}
	if {class::%{_p}'s uuid%} = "PGS":
		play sound "BLOCK_BEACON_ACTIVATE" at volume 3 at pitch 1 to {_p}

# Passive (Believer): while below 4 hearts, Paladin regenerates at the Regeneration I rate — half a heart every 2.5 s, in or out of
# combat. Scripted (healHP(), 20-combat.sk) so a Striker's Lingering Wounds shrinks each heal to 0.3 hearts. The first heal comes
# 2.5 s after dropping below 4 hearts. Stacks with the Juggernaut level 2 out-of-combat regeneration.
# (Replaced "the Juggernaut out-of-combat regen heals at the Regeneration II rate".)
every 5 ticks:
	loop all players:
		set {_p} to loop-player
		set {_u} to {_p}'s uuid
		set {_ok} to false
		if {inMatch::%{_u}%} is set:
			if {respawning::%{_u}%} isn't set:
				if {class::%{_u}%} is "PGS":
					if health of {_p} > 0:
						if health of {_p} < 4:
							set {_ok} to true
		if {_ok} is true:
			if {pgBelieverNext::%{_u}%} isn't set:
				set {pgBelieverNext::%{_u}%} to (unix timestamp of now) + 2.5
			else if (unix timestamp of now) >= {pgBelieverNext::%{_u}%}:
				set {pgBelieverNext::%{_u}%} to (unix timestamp of now) + 2.5
				healHP({_p}, 0.5) # 20-combat.sk
				draw 1 of heart at ((location of {_p}) offset by vector(0, 2.2, 0)) with offset vector(0.2, 0.1, 0.2)
			if "%active potion effects of {_p}%" doesn't contain "invisibility":
				draw 1 of dust using dustOption(rgb(255, 215, 90), 0.8) at ((location of {_p}) offset by vector(0, 1, 0)) with offset vector(0.3, 0.5, 0.3) # a light holy shimmer while it's active
		else if {pgBelieverNext::%{_u}%} is set:
			delete {pgBelieverNext::%{_u}%}

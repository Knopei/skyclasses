# ============================================
# SCORCH (FG) — Scorch Blade (copper sword), Juggernaut  (was called Forge; the code and variables still use "forge" / FG)
# Tactical: always available. Ultimate: unlocks at class level 1.
# Passive "Molotov": Scorch's grenades become molotovs — the same fuse, but no explosion (no damage, no knockback). Where it lands, a
#   3-block fire area burns for 1.5 seconds: anyone else inside it is set on fire, and keeps burning for 2 seconds after the last moment
#   they stood in it; Scorch never burns from it. It ticks 3 times (0.5, 1 and 1.5 s): each tick sets everyone else inside on
#   fire and heals Scorch if standing in it (0.25, 0.25, then 0.5 on the last tick). (Grenade code: 07-consumables.sk.)
# Tactical "Flamethrower": 3 bursts of fire over 1.5 seconds in a flat cone in front of you (4 blocks long, 60 degrees wide, outlined in
#   orange like Magmaroth's Fire Breath). Each burst does
#   no damage of its own — it sets everything it hits on fire for 3 seconds, and sets off ANY grenade it touches (anyone's) right away.
# Ultimate "Fire & Steel": summons an iron golem (normal size, 12 hearts, Slowness II) for 15 seconds:
#   - on spawn it knocks every enemy within 5 blocks up
#   - enemy players within 5 blocks of it are slowed (Slowness I)
#   - it only ever attacks your opponent: 2 damage per hit, at most one hit every 1.5 seconds
#   - while you're within 5 blocks of it, 50% of every hit you take goes to the golem instead — and the golem takes double that
#     (so it loses the hit's full damage). Void deaths are never redirected, and neither is a Skirmisher execute.
#   - setting it on fire with your Flamethrower or your molotov ENHANCES it for the rest of its life: normal speed instead of Slowness II,
#     its hits set your opponent on fire for 2 seconds, and smoke rises from its shoulders
#   - it never takes damage from your Flamethrower, your molotovs, your own hits, or fire
#   - it disappears when its 15 seconds are up, when you die, swap class, or the match ends
# Perk 1 (level 2) "Wildfire": the last Flamethrower burst reaches 1 block further (5 blocks).
# Perk 2 (level 3) "Tempered Steel": the golem walks faster — Slowness I instead of II, and Speed I instead of normal speed when enhanced.
# ============================================

on load:
	set {forge::cone-length} to 4 # blocks
	set {forge::cone-cos} to 0.866 # cos(30 degrees) — a 60-degree cone
	set {forge::burn-seconds} to 2
	set {forge::molotov-radius} to 3
	set {forge::golem-health} to 12 # hearts
	set {forge::golem-seconds} to 15
	set {forge::golem-radius} to 5
	set {forge::golem-damage} to 2
	set {forge::golem-hit-gap} to 1.5 # seconds between golem hits
	loop all entities: # a reload kills the ult loops — sweep any golem they left behind
		set {_x} to loop-entity
		if {_x}.getScoreboardTags().contains("forge_golem"):
			{_x}.remove()
	delete {-forgeGolem::*}

# ---- PASSIVE: MOLOTOV (07-consumables.sk calls this instead of the explosion for a Scorch's grenade) ----

function forgeMolotov(p: player, loc: location):
	set {_r} to {forge::molotov-radius}
	play sound "item.firecharge.use" with volume 2 and pitch 0.8 at {_loc}
	play sound "block.fire.ambient" with volume 2 and pitch 1 at {_loc}
	draw 40 of flame at {_loc} with offset vector(1.5, 0.3, 1.5) with extra 0.05
	set {_step} to 0
	while {_step} < 15: # 15 x 2 ticks = 1.5 seconds; the fire itself ticks 3 times — at 0.5, 1 and 1.5 seconds (steps 5, 10, 15)
		add 1 to {_step}
		wait 2 ticks
		if mod({_step}, 2) = 1: # the orange outline at the 3-block edge (every 4 ticks — a light outline)
			forgeRing({_loc}, {_r})
		draw 4 of flame at {_loc} with offset vector(1.3, 0.1, 1.3) with extra 0.01
		if distance between {_p} and {_loc} <= {_r}: # Scorch standing in its own fire: burn ticks can't hurt it while it heals here
			set {forgeFireSafe::%{_p}'s uuid%} to (unix timestamp of now) + 0.2
		if mod({_step}, 5) = 0: # a fire tick: burn every enemy inside, heal Scorch
			draw 4 of lava at {_loc} with offset vector(1.2, 0.1, 1.2)
			loop all living entities in radius {_r} around {_loc}:
				set {_e} to loop-entity
				if {_e} is {_p}:
					if {_step} is 15: # the last fire tick heals more
						healHP({_p}, 0.5) # 20-combat.sk — Lingering Wounds can shrink it
					else:
						healHP({_p}, 0.25) # 0.25 hearts on the first two fire ticks
				else if metadata value "forgeOwner" of {_e} is {_p}:
					forgeEnhance({_e}) # your own golem: powered up, never burned
				else if {_e} is not an armor stand:
					set {_skip} to false
					if {_e} is a player:
						if {respawning::%{_e}'s uuid%} is set:
							set {_skip} to true
					if {_skip} is false:
						updateAttacker({_p}, {_e}) # 01-utils.sk — the burn is credited to Scorch
						ignite {_e} for 2 seconds # keeps burning for 2 seconds after leaving the fire
						if {_e} is a player:
							setFireSource({_e}, "PASSIVE", 2) # 19-balance-stats.sk

# ---- TACTICAL: FLAMETHROWER ----

on right click with copper sword:
	if name of player's held item is "%{wc}%Scorch Blade":
		if tacCHECK(player, {weapons::FG::TAC-COST}) is true:
			set {_p} to player
			set {_i} to 1
			while {_i} <= 3:
				if {_p} isn't online:
					stop
				if health of {_p} <= 0:
					stop
				set {_len} to {forge::cone-length}
				if {_i} is 3:
					if classLevel({_p}, "FG") >= 2: # Perk 1 (Wildfire): the last burst reaches 1 block further
						add 1 to {_len}
				forgeFlameBurst({_p}, {_len})
				add 1 to {_i}
				if {_i} <= 3:
					wait 10 ticks # 3 bursts over 1.5 seconds

function forgeFlameBurst(p: player, len: number): # a flat cone like Magmaroth's Fire Breath: 60 degrees wide, outlined in orange
	set {_yaw} to {_p}.getLocation().getYaw()
	set {_dx} to -1 * sin({_yaw}) # the direction the player faces, on the ground plane
	set {_dz} to cos({_yaw})
	set {_o} to (location of {_p}) offset by vector(0, 1, 0)
	play sound "entity.blaze.shoot" with volume 1.5 and pitch 0.8 at {_p}
	play sound "item.firecharge.use" with volume 1 and pitch 1.2 at {_p}
	forgeFlameVisual({_o}, {_dx}, {_dz}, {_len}) # has its own waits — returns at once
	loop all entities in radius ({_len} + 1.5) around {_o}:
		set {_e} to loop-entity
		if {_e} is not {_p}:
			if {_e} is not an armor stand:
				set {_box} to {_e}.getBoundingBox()
				set {_tx} to {_box}.getCenterX() - (x-coord of {_o})
				set {_tz} to {_box}.getCenterZ() - (z-coord of {_o})
				set {_ty} to {_box}.getCenterY() - (y-coord of {_o})
				set {_dist} to sqrt(({_tx} * {_tx}) + ({_tz} * {_tz})) # flat distance, like the outline
				set {_in} to false
				if abs({_ty}) <= 2.5:
					if {_dist} <= {_len} + 0.3:
						if {_dist} < 1: # point-blank: always hit
							set {_in} to true
						else if ((({_tx} * {_dx}) + ({_tz} * {_dz})) / {_dist}) >= {forge::cone-cos}: # within 30 degrees
							set {_in} to true
				if {_in} is true:
					if metadata value "isNade" of {_e} is set: # ANY grenade in the flames goes off right now (07-consumables.sk)
						set metadata value "nadeDetonate" of {_e} to true
					else if {_e} is a living entity:
						if {_p}.hasLineOfSight({_e}) is true:
							forgeFlameHit({_p}, {_e})

function forgeFlameVisual(o: location, dx: number, dz: number, len: number): # one burst: the orange outline plus flames filling the cone
	loop 8 times:
		if mod(loop-number, 2) = 1: # the outline every other tick — a light outline
			forgeConeOutline({_o}, {_dx}, {_dz}, {_len})
		loop 4 times:
			set {_a} to random number between -30 and 30
			set {_d} to random number between 0.5 and {_len}
			set {_ex} to ({_dx} * cos({_a})) - ({_dz} * sin({_a}))
			set {_ez} to ({_dx} * sin({_a})) + ({_dz} * cos({_a}))
			draw 1 of flame at ({_o} offset by vector({_ex} * {_d}, random number between -0.3 and 0.3, {_ez} * {_d})) with offset vector(0.1, 0.1, 0.1) with extra 0.02
		wait 1 tick

function forgeRing(loc: location, r: number): # a light orange ring: 16 points
	set {_a} to 0
	while {_a} < 360:
		draw 1 of dust using dustOption(rgb(255, 130, 0), 1) at ({_loc} offset by vector({_r} * cos({_a}), 0.15, {_r} * sin({_a})))
		add 22.5 to {_a}

function forgeConeOutline(o: location, dx: number, dz: number, range: number): # a light version of Magmaroth's Fire Breath outline: both edges and the far arc
	loop 5 times:
		set {_a} to -30 + ((loop-number - 1) * 15)
		set {_ex} to ({_dx} * cos({_a})) - ({_dz} * sin({_a}))
		set {_ez} to ({_dx} * sin({_a})) + ({_dz} * cos({_a}))
		draw 1 of dust using dustOption(rgb(255, 130, 0), 1) at ({_o} offset by vector({_ex} * {_range}, 0, {_ez} * {_range}))
		if loop-number is 1 or 5:
			set {_edge} to 0.8
			while {_edge} < {_range}:
				draw 1 of dust using dustOption(rgb(255, 130, 0), 1) at ({_o} offset by vector({_ex} * {_edge}, 0, {_ez} * {_edge}))
				add 1 to {_edge}

on damage of player with priority lowest: # Scorch healing in its own molotov doesn't take burn ticks there
	if {forgeFireSafe::%victim's uuid%} is set:
		if (unix timestamp of now) <= {forgeFireSafe::%victim's uuid%}:
			if "%event-damagecause%" is "fire" or "fire_tick" or "fire tick":
				cancel event

function forgeFlameHit(p: player, e: living entity):
	if metadata value "forgeOwner" of {_e} is {_p}: # your own golem: powered up, never damaged
		forgeEnhance({_e})
		stop
	if {_e} is a player:
		if {respawning::%{_e}'s uuid%} is set:
			stop
	updateAttacker({_p}, {_e}) # 01-utils.sk — the burn is credited to Scorch
	ignite {_e} for 3 seconds # no damage of its own — only the fire
	recordAbilityHit({_p}, "TAC") # 19-balance-stats.sk — counts for the tactical's hit rate (no damage event to count it otherwise)
	if {_e} is a player:
		setFireSource({_e}, "TAC", 3) # 19-balance-stats.sk

# ---- ULTIMATE: FIRE & STEEL ----

on drop of copper sword with priority low:
	if name of event-item is "%{wc}%Scorch Blade":
		cancel event
		if classLevel(player, "FG") < 1:
			send "&cUltimate locked! Reach class level 1 to unlock." to player
			stop
		set {_ultCooldown} to ultCooldownFor(player, {weapons::FG::ULT-CD}) # 06-perks-general.sk — Spell Caster
		if {-godlike-ULT-USE::%player's uuid%::FG} is set:
			send "&cULT ALREADY ACTIVATED!" to player
		else if {-godlike-ULT-CD::%player's uuid%::FG} is set:
			set {_time} to difference between now and {-godlike-ULT-CD::%player's uuid%::FG}
			if {_time} < {_ultCooldown}:
				send "&cULT NOT READY!" to player
		else if ultCHECK(player, {weapons::FG::ULT-COST}) is true:
			forgeGolemRun(player, {_ultCooldown}, classLevel(player, "FG"), false) # the golem's whole life, then the cooldown (a function with waits returns to here at once)

function forgeGolemRun(p: player, cd: timespan, lvl: number, sb: boolean): # {_lvl} = the level the ultimate runs at, {_sb} = cast by Spell Breaker (spellbreaker.sk: no cooldown of its own)
	set {_u} to {_p}'s uuid
	set {-godlike-ULT-USE::%{_u}%::FG} to now
	set {_hp} to {forge::golem-health}
	set {_inMatch} to false
	if {inMatch::%{_u}%} is set:
		set {_inMatch} to true
	spawn an iron golem at location of {_p}
	set {_g} to last spawned iron golem
	{_g}.addScoreboardTag("forge_golem")
	{_g}.setPlayerCreated(true)
	{_g}.setRemoveWhenFarAway(false)
	set metadata value "forgeGolem" of {_g} to true
	set metadata value "forgeOwner" of {_g} to {_p}
	set max health of {_g} to {_hp}
	set health of {_g} to {_hp}
	set metadata value "forgeLvl" of {_g} to {_lvl} # read by forgeEnhance()
	if {_lvl} >= 3: # Perk 2 (Tempered Steel): Slowness I instead of II
		add potion effect of slowness 1 without particles for 16 seconds to potion effects of {_g}
	else:
		add potion effect of slowness 2 without particles for 16 seconds to potion effects of {_g} # Slowness II (removed when enhanced)
	set {-forgeGolem::%{_u}%} to {_g}
	forgeGolemName({_g})
	# spawn: knock every enemy within the radius up
	play sound "entity.iron_golem.repair" with volume 2 and pitch 0.6 at {_g}
	play sound "entity.generic.explode" with volume 1 and pitch 1.4 at {_g}
	draw 40 of flame at {_g} with offset vector(2, 0.3, 2) with extra 0.05
	draw 20 of large_smoke at {_g} with offset vector(1.5, 0.5, 1.5) with extra 0.02
	loop all living entities in radius {forge::golem-radius} around {_g}:
		set {_e} to loop-entity
		if {_e} is not {_p}:
			if {_e} is not {_g}:
				if {_e} is not an armor stand:
					set {_skip} to false
					if {_e} is a player:
						if {respawning::%{_e}'s uuid%} is set:
							set {_skip} to true
					if metadata value "isMajorBoss" of {_e} is set: # bosses keep their footing
						set {_skip} to true
					if {_skip} is false:
						updateAttacker({_p}, {_e})
						push {_e} upward at speed 0.8
	set {_ticks} to 0
	while {_ticks} < ({forge::golem-seconds} * 20):
		if {_g} is dead:
			stop loop
		if {_p} isn't online:
			stop loop
		if health of {_p} <= 0:
			stop loop
		if {-godlike-ULT-CANCEL::%{_u}%::FG} is set: # set by 09-death-match.sk when Scorch dies
			stop loop
		if {-godlike-ULT-USE::%{_u}%::FG} isn't set: # class swap (01-utils.sk's clearCurrClass)
			stop loop
		if {_inMatch} is true:
			if {inMatch::%{_u}%} isn't set:
				stop loop
		# target: the opponent only (and only one it can actually fight)
		set {_opp} to {matchOpponent::%{_u}%}
		set {_t} to false
		if {_opp} is set:
			if {_opp} is online:
				if {respawning::%{_opp}'s uuid%} isn't set:
					if {_opp} is not invisible:
						if distance between {_g} and {_opp} <= 24:
							set {_t} to true
		if {_t} is true:
			{_g}.setTarget({_opp})
		else:
			{_g}.setTarget(null)
		# every 10 ticks: the slowing aura on enemy players, its ring, and the enhanced smoke
		if mod({_ticks}, 10) = 0:
			if metadata value "forgeEnhanced" of {_g} is set: # 12-major-boss.sk — the aura's outline: gray, orange once enhanced
				mbDrawRingRGB(location of {_g}, {forge::golem-radius}, 255, 130, 0)
			else:
				mbDrawRingRGB(location of {_g}, {forge::golem-radius}, 150, 150, 150)
			loop all players in radius {forge::golem-radius} around {_g}:
				if loop-player is not {_p}:
					if {respawning::%loop-player's uuid%} isn't set:
						add potion effect of slowness 1 without particles for 1 second to potion effects of loop-player # Slowness I
		if metadata value "forgeEnhanced" of {_g} is set:
			forgeShoulderSmoke({_g})
		wait 5 ticks
		add 5 to {_ticks}
	# gone
	if {_g} is alive:
		draw 20 of large_smoke at {_g} with offset vector(0.6, 1, 0.6) with extra 0.02
		play sound "entity.iron_golem.death" with volume 1 and pitch 1 at {_g}
		{_g}.remove()
	delete {-forgeGolem::%{_u}%}
	# the ultimate's cooldown starts once the golem is gone
	set {-godlike-ULT-CD::%{_u}%::FG} to now
	delete {-godlike-ULT-USE::%{_u}%::FG}
	delete {-godlike-ULT-CANCEL::%{_u}%::FG}
	if {_sb} is true: # Spell Breaker's stolen cast has no cooldown of its own (spellbreaker.sk runs Spell Breaker's)
		delete {-godlike-ULT-CD::%{_u}%::FG}
		stop
	wait {_cd}
	delete {-godlike-ULT-CD::%{_u}%::FG}
	if {_p} is online:
		if {class::%{_u}%} = "FG":
			play sound "BLOCK_BEACON_ACTIVATE" at volume 3 at pitch 1 to {_p}

function forgeGolemName(g: living entity):
	set {_hp} to round((health of {_g}) * 10) / 10
	set display name of {_g} to "&6Scorch Golem &c%{_hp}%❤"
	{_g}.setCustomNameVisible(true)

function forgeShoulderSmoke(g: living entity): # two puffs of smoke, one from each shoulder
	set {_yaw} to {_g}.getLocation().getYaw()
	set {_sx} to cos({_yaw}) * 0.75 # sideways (perpendicular to where it faces)
	set {_sz} to sin({_yaw}) * 0.75
	draw 2 of white_smoke at (location of {_g}) offset by vector({_sx}, 2.5, {_sz}) with offset vector(0.1, 0.1, 0.1) with extra 0.02
	draw 2 of white_smoke at (location of {_g}) offset by vector(-1 * {_sx}, 2.5, -1 * {_sz}) with offset vector(0.1, 0.1, 0.1) with extra 0.02

function forgeEnhance(g: living entity): # set on fire by its own Scorch: faster for the rest of its life, and its hits burn
	if metadata value "forgeEnhanced" of {_g} is set:
		stop
	set metadata value "forgeEnhanced" of {_g} to true
	remove slowness from active potion effects of {_g} # normal speed
	set {_owner} to metadata value "forgeOwner" of {_g}
	if {_owner} is a player:
		if metadata value "forgeLvl" of {_g} >= 3: # Perk 2 (Tempered Steel): Speed I when enhanced (the level the ultimate was cast at — a Spell Breaker's stolen golem carries its own)
			add potion effect of speed 1 without particles for 16 seconds to potion effects of {_g}
	play sound "item.firecharge.use" with volume 2 and pitch 0.6 at {_g}
	play sound "entity.blaze.ambient" with volume 1 and pitch 0.7 at {_g}
	draw 30 of flame at {_g} with offset vector(0.6, 1.2, 0.6) with extra 0.05
	set {_o} to metadata value "forgeOwner" of {_g}
	if {_o} is a player:
		send action bar "&6Your golem is ablaze!" to {_o}

function forgeGolemTake(g: living entity, amt: number): # damage redirected from its Scorch (straight off its health, no damage event)
	if {_g} is dead:
		stop
	set {_left} to (health of {_g}) - {_amt}
	draw 6 of damage_indicator at (location of {_g}) offset by vector(0, 1.5, 0) with offset vector(0.4, 0.4, 0.4) with extra 0.1
	play sound "entity.iron_golem.hurt" with volume 1 and pitch 1 at {_g}
	if {_left} <= 0:
		kill {_g}
		stop
	set health of {_g} to {_left}
	forgeGolemName({_g})

function forgeGolemMelee(g: living entity, v: living entity) :: number: # 08-damage.sk — the golem's own hit on the opponent: its damage (0 = no hit)
	set {_last} to metadata value "forgeLastHit" of {_g}
	if {_last} is set:
		if ((unix timestamp of now) - {_last}) < {forge::golem-hit-gap}:
			return 0
	set metadata value "forgeLastHit" of {_g} to unix timestamp of now
	set {_o} to metadata value "forgeOwner" of {_g}
	if {_o} is a player:
		updateAttacker({_o}, {_v}) # the golem's hits (and their kills) are credited to its Scorch
		if metadata value "forgeEnhanced" of {_g} is set:
			ignite {_v} for 2 seconds
			if {_v} is a player:
				setFireSource({_v}, "ULT", 2) # 19-balance-stats.sk
	return {forge::golem-damage}

# ---- the golem: targeting, damage it takes, redirect ----

on target:
	if metadata value "forgeGolem" of event-entity is set:
		set {_t} to event.getTarget()
		if {_t} is set:
			set {_o} to metadata value "forgeOwner" of event-entity
			set {_opp} to {matchOpponent::%{_o}'s uuid%}
			if {_opp} isn't set:
				cancel event
			else if {_t} is not {_opp}: # it only ever goes after your opponent
				cancel event

on damage of iron golem with priority lowest:
	if metadata value "forgeGolem" of victim is set:
		set {_cause} to "%event-damagecause%"
		if {_cause} is "fire" or "fire_tick" or "fire tick" or "lava" or "hot_floor" or "hot floor" or "fall" or "suffocation":
			cancel event # fire only powers it up; it doesn't take fall damage either
			stop
		set {_o} to metadata value "forgeOwner" of victim
		if attacker is set:
			if attacker is {_o}: # your own hits
				cancel event

on death of iron golem:
	if metadata value "forgeGolem" of victim is set:
		clear drops # (iron golems never drop experience)
		set {_o} to metadata value "forgeOwner" of victim
		if {_o} is a player:
			send action bar "&cYour golem was destroyed!" to {_o}

on damage of iron golem with priority monitor: # its name shows its health
	if metadata value "forgeGolem" of victim is set:
		if event is not cancelled:
			set {_g} to victim
			wait 1 tick
			if {_g} is alive:
				forgeGolemName({_g})

on damage of player with priority highest: # the redirect: half of what Scorch takes near its golem goes to the golem, which takes double that
	if event is cancelled:
		stop
	set {_u} to victim's uuid
	set {_g} to {-forgeGolem::%{_u}%}
	if {_g} isn't set:
		stop
	if {_g} is dead:
		stop
	if "%event-damagecause%" is "void":
		stop
	if metadata value "skExecute" of victim is set: # a Skirmisher execute isn't softened
		stop
	if distance between victim and {_g} > {forge::golem-radius}:
		stop
	set {_d} to damage
	if {_d} <= 0:
		stop
	set damage to {_d} / 2
	forgeGolemTake({_g}, {_d}) # double the redirected half = the hit's full damage

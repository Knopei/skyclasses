# ============================================
# DEMON (DS) — Demonic Saber
# Tactical: always available. Ultimate: unlocks at class level 1.
# Perk 1 (level 2) "Extended Siphon": the tactical's beam range goes from 5 to 7.5 blocks. (Back again — it had been replaced by "Efficient Siphon", -5 mana.)
# Perk 2 (level 3) "Vampire": increases lifesteal per hit during the ultimate.
# ============================================

function demonicBeam(p: player, e: living entity, v: vector, h: number):
	set vector length of {_v} to 0.1
	set {_loc} to location of {_p}
	add {_h} to y-coord of {_loc}
	loop (distance between {_loc} and {_e}) / 0.1 times:
		draw 2 of dust using dustOption(red, 0.75) at {_loc}
		make 1 of block particle using redstone block at {_loc}
		set {_loc} to {_loc} ~ {_v}
	updateAttacker({_p}, {_e})
	play sound "entity_blaze_shoot" at volume 5 at location of {_p}
	make 25 of block particle using redstone block at block 1.5 above location of {_e}
	play sound "BLOCK_STONE_BREAK" at volume 5 at location of {_e}

on right click with netherite sword: # TACTICAL
	if name of player's held item is "%{wc}%Demonic Saber":
		set {_cost} to {weapons::DS::TAC-COST}
		if tacCHECK(player, {_cost}) is true:
			set {_beamRange} to 5
			if classLevel(player, "DS") >= 2: # Perk 1 (Extended Siphon) — 7.5 blocks
				set {_beamRange} to 7.5

			set {-balance-abilitySource::%player's uuid%} to "TAC" # 19-balance-stats.sk
			set {_dis} to 0
			while {_dis} < {_beamRange}: # steps of 1 block out to the range (the last step lands exactly on 7.5 with Extended Siphon)
				add 1 to {_dis}
				if {_dis} > {_beamRange}:
					set {_dis} to {_beamRange}
				set {_loc} to location {_dis} blocks infront of player
				set {_loc} to location 1 blocks above {_loc}
				loop all living entities in radius 2.5 of {_loc}:
					if loop-entity is not a armor stand:
						if loop-entity isn't player:
							set {_target} to loop-entity
							if {_targetList::*} doesn't contain {_target}:
								add {_target} to {_targetList::*}
								set {_v} to vector from player to {_target}
								demonicBeam(player, {_target}, {_v}, 1.25)
								directAttack({_target})
								damage {_target} by 0.5
								healHP(player, 0.5) # 20-combat.sk — Lingering Wounds can shrink it
			delete {-balance-abilitySource::%player's uuid%}
			if {_target} isn't set:
				play sound "entity.blaze.hurt" at volume 3 and pitch 0.5 to player

on drop of netherite sword with priority low: # ULTIMATE
	if name of event-item is "%{wc}%Demonic Saber":
		cancel event
		if classLevel(player, "DS") < 1:
			send "&cUltimate locked! Reach class level 1 to unlock." to player
			stop
		set {_ultCooldown} to ultCooldownFor(player, {weapons::DS::ULT-CD}) # 06-perks-general.sk — Spell Caster
		if {-godlike-ULT-USE::%player's uuid%::DS} is set:
			send "&cULT ALREADY ACTIVATED!" to player
		else if {-godlike-ULT-CD::%player's uuid%::DS} is set:
			set {_time} to difference between now and {-godlike-ULT-CD::%player's uuid%::DS}
			if {_time} < {_ultCooldown}:
				send "&cULT NOT READY!" to player
		else if ultCHECK(player, {weapons::DS::ULT-COST}) is true:
			ultDS(player, {_ultCooldown}, classLevel(player, "DS"), false) # the body is a function so Spell Breaker can cast it too (spellbreaker.sk)

function ultDS(p: player, cd: timespan, lvl: number, sb: boolean): # ULTIMATE body — {_lvl} = the level it runs at, {_sb} = cast by Spell Breaker (spellbreaker.sk: no cooldown of its own)
	set {-godlike-ULT-USE::%{_p}'s uuid%::DS} to now
	play sound "entity_blaze_death" with volume 5 and pitch 0.5 at {_p}
	set {_shapes::circle} to a circle with radius 1.25
	set particle of {_shapes::*} to 1 of dust_color_transition particle using dustTransition(red, black, 0.5)
	set {_rotation} to rotation around vector(1, 1, 1) by 9 degrees
	set {_n} to 39
	loop 161 times:
		if {-godlike-ULT-CANCEL::%{_p}'s uuid%::DS} is set:
			stop loop
		add 1 to {_n}
		if {_n} = 40:
			set {_n} to 0
			set {_max} to 0
			set {-balance-abilitySource::%{_p}'s uuid%} to "ULT" # 19-balance-stats.sk
			loop all living entities in radius 6 around {_p}:
				if loop-entity is not an armor stand: # excludes armor stands (including the per-player level-tag stands from 04-leveling.sk) from being targeted, damaged, or healed off of
					if loop-entity is not {_p}:
						if loop-entity is a player:
							set {_v} to vector from {_p} to loop-entity
							if {_max} < 3:
								demonicBeam({_p}, loop-entity, {_v}, 1.25)
								damage loop-entity by 0.5 hearts
								add 1 to {_hits}
								add 1 to {_max}
						else:
							set {_v} to vector from {_p} to loop-entity
							demonicBeam({_p}, loop-entity, {_v}, 1.25)
							damage loop-entity by 0.5 hearts
							add 1 to {_hits}
			if {_hits} > 0: # 0.5 hearts for the first enemy hit by this pulse, +0.5 hearts for each additional one
				set {_amt} to 0.5 + (({_hits} - 1) * 0.5)
				healHP({_p}, {_amt}) # 20-combat.sk — Lingering Wounds can shrink it
			delete {_hits}
			delete {_v}
			delete {_max}
			delete {-balance-abilitySource::%{_p}'s uuid%}

		set {_loc} to {_p}'s location
		add 1 to y-coord of {_loc}
		rotate shapes {_shapes::*} by {_rotation}
		draw shapes {_shapes::*} at {_loc}
		wait 1 tick
	set {-godlike-ULT-CD::%{_p}'s uuid%::DS} to now
	delete {-godlike-ULT-USE::%{_p}'s uuid%::DS}
	delete {-godlike-ULT-CANCEL::%{_p}'s uuid%::DS}
	# ULT CD
	if {_sb} is true: # Spell Breaker's stolen cast has no cooldown of its own (spellbreaker.sk runs Spell Breaker's)
		delete {-godlike-ULT-CD::%{_p}'s uuid%::DS}
		stop
	wait {_cd}
	delete {-godlike-ULT-CD::%{_p}'s uuid%::DS}
	if {class::%{_p}'s uuid%} = "DS":
		play sound "BLOCK_BEACON_ACTIVATE" at volume 3 at pitch 1 to {_p}

on damage of living entity: # PASSIVE — lifesteal on melee hit, boosted during ultimate by Perk 2
	if attacker is a player:
		if name of attacker's held item is "%{wc}%Demonic Saber":
			if attack cooldown of attacker >= 0.75:
				if {-godlike-ULT-USE::%attacker's uuid%::DS} is set:
					if classLevel(attacker, "DS") >= 3: # Perk 2 (Vampire)
						healHP(attacker, 0.75)
					else:
						healHP(attacker, 0.25)
				else:
					healHP(attacker, 0.25)
		else if name of attacker's held item is "%{wc}%Spell Breaker": # spellbreaker.sk — a stolen Blood Harvest gives the shovel the ultimate's lifesteal (not the passive's)
			if {-godlike-ULT-USE::%attacker's uuid%::DS} is set:
				if attack cooldown of attacker >= 0.75:
					if sbStolenLevel(attacker) >= 3: # Mastered Theft — the Vampire version
						healHP(attacker, 0.75)
					else:
						healHP(attacker, 0.25)

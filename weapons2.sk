
on load:
	# MH
	set {weapons::MH::TAC-COST} to 50
	set {weapons::MH::ULT-COST} to 60
	set {weapons::MH::ULT-CD} to 45 seconds
	# RS
	set {weapons::RS::0-TAC-COST} to 20 # miss cost (true value)
	set {weapons::RS::S-TAC-COST} to 45
	set {weapons::RS::M-TAC-COST} to 50
	set {weapons::RS::L-TAC-COST} to 55
	set {weapons::RS::ULT-COST} to 60
	set {weapons::RS::ULT-CD} to 40 seconds
	# MH
	set {weapons::MMH::0-TAC-COST} to 200 # refund cost in 10's (20 = 20*10)
	set {weapons::MMH::TAC-COST} to 40

	set {weapons::MMS::ULT-COST} to 15
	set {weapons::MMH::ULT-CD} to 12 seconds
	# NS
	set {weapons::NS::TAC-COST} to 40
	set {weapons::NS::ULT-COST} to 50
	set {weapons::NS::ULT-CD} to 40 seconds
	# PT
	set {weapons::PT::TAC-COST} to 50
	set {weapons::PT::ULT-COST} to 60
	set {weapons::PT::ULT-CD} to 40 seconds
	# HC
	set {weapons::HC::ATK-COST} to 15
	set {weapons::HC::TAC-COST} to 40
	set {weapons::HC::ULT-COST} to 10
	set {weapons::HC::ULT-CD} to 1 seconds

	set {weapons::HK::TAC-COST} to 40
	set {weapons::HK::ULT-CD} to 4 seconds

	set {weapons::HWL::R-COST} to 20
	set {weapons::HWL::L-COST} to 20 
	# TB
	set {weapons::TB::ATK-COST} to 25
	set {weapons::TB::TAC-COST} to 8 # must be divisible by 4
	set {weapons::TB::ULT-COST} to 60
	set {weapons::TB::ULT-CD} to 40 seconds

	set {perk-var::TB::28} to 20 # tac = 20 mana (perk: 28)


# on disconnect & on skript stop = weapons.sk 

function arrowGive(p: player):
	remove all arrow from inventory of {_p}
	wait 1 tick
	if slot {arrow-slot} of {_p}'s inventory is air:
		set slot {arrow-slot} of {_p}'s inventory to 1 of arrow
	else:
		give {_p} 1 of arrow	

# MIGHTY HAMMER

function mightyExplosion(p: player, radius: integer):
	set {_r} to ceil({_radius} - 1)
	if {_radius} > 3:
		set {_s} to 2
	else:
		set {_s} to 1
	create a fake explosion at {_p}
	draw {_radius} of explosion at {_p} with offset vector({_s}, {_s}, {_s}) with extra 0
	draw 10 of large_smoke at {_p} with extra 0.5
	draw 50 of dust_color_transition using dustTransition(cyan, white, {_s}) at {_p} with offset vector({_r}, {_r}, {_r}) with extra 0.5

on right click with mace:
	if name of player's held item is "%{wc}%Mighty Hammer": 
		if tacCHECK(player, {weapons::MH::TAC-COST}) is true:
			mightyExplosion(player, 3) # int only
			if {class-perk::%player's uuid%::MH::perk} = {perk-check::3}:
				set {_pitch} to pitch of player
				if {_pitch} > 75:
					push player upwards at speed 0.875
			loop all living entities in radius 3.5 around player:
				if loop-entity is not player:
					updateAttacker(player, loop-entity)
					directAttack(loop-entity)
					push loop-entity upward at speed 0.75
					damage loop-entity by 2

on drop of mace with priority low: # ULT USE
	if name of event-item is "%{wc}%Mighty Hammer":
		cancel event
		if {general-perk::%player's uuid%::perk} = 22:
			set {_ultCooldown} to {special::%player's uuid%::ULT-CD}
		else:
			set {_ultCooldown} to {weapons::MH::ULT-CD}
		if {mighty-DASH::%player's uuid%} is set:
			push player forward at speed 3
			play sound "entity_bat_takeoff" with volume 1 and pitch 1 at player
			delete {mighty-DASH::%player's uuid%}
		else if {godlike-ULT-USE::%player's uuid%::MH} is set:
			send "&cULT ALREADY ACTIVATED!" to player
		else if {godlike-ULT-CD::%player's uuid%::MH} is set:
			set {_time} to difference between now and {godlike-ULT-CD::%player's uuid%::MH}
			if {_time} < {_ultCooldown}:
				send "&cULT NOT READY!" to player
		else if ultCHECK(player, {weapons::MH::ULT-COST}) is true:
			set {godlike-ULT-USE::%player's uuid%::MH} to now
			
			play sound "entity_bat_takeoff" with volume 1 and pitch 1 at player
			# leap
			create a fake explosion at player
			teleport player to player
			push player upward at speed 2.5
			wait 10 ticks
			set {mighty-DASH::%player's uuid%} to true

			set {_shapes::circle} to a circle with radius 1
			set particle of {_shapes::*} to 1 of dust_color_transition particle using dustTransition(cyan, white, 1)

			while player isn't on ground: # code: longer in the air = more dmg + push
				set {_loc} to player's location
				add 1 to y-coord of {_loc}
				draw shapes {_shapes::*} at {_loc}
				add 1 to {_airTime}
				wait 1 tick
			# slam
			delete {mighty-DASH::%player's uuid%}
			if {godlike-ULT-CANCEL::%player's uuid%::MH} isn't set:
				mightyExplosion(player, 5.5) # int only
				loop all living entities in radius 5.5 around player:
					if loop-entity is not player:
						updateAttacker(player, loop-entity)
						directAttack(loop-entity)

						# dmg
						set {_dis} to distance between player and loop-entity
						set {_d} to abs({_dis} - 6) # must be 0.5 bigger than radius
						if {_d} < 2.5:
							set {_d} to 2.5
						else if {_d} > 3.5:
							set {_d} to 3.5
						set {_d} to ({_airTime}*0.05) + {_d}
						if {_d} > 5:
							set {_d} to 5

						set {_v} to vector between player and loop-entity
						wait 1 tick
						damage loop-entity by {_d}
						teleport loop-entity to loop-entity
						push loop-entity {_v} at speed {_d}
			# PERK
			if {class-perk::%player's uuid%::MH::perk} = {perk-check::2}:
				set {_shapes::circle} to a circle of radius 5

				set {_shapes::line-1} to a line in direction vector(0, 0, 1) with length 5
				set {_shapes::line-2} to a line in direction vector(0, 0, -1) with length 5
				set {_shapes::line-3} to a line in direction vector(1, 0, 0) with length 5
				set {_shapes::line-4} to a line in direction vector(-1, 0, 0) with length 5
				set {_ultDmgRadius} to 5.25

				set {_loc} to player's location
				set {_y-max} to y-coord of {_loc}+2
				set {_y-min} to y-coord of {_loc}-2

				set {_n} to 3
				loop 13 times:
					set {_rotation} to rotation around vector(0, 1, 0) by 20 degrees
					rotate shapes {_shapes::*} by {_rotation}
					draw shapes {_shapes::*} at {_loc}

					add 1 to {_n}
					if {_n} = 4:
						delete {_n}
						loop all living entities in radius {_ultDmgRadius} around {_loc}:
							if loop-entity is not player:
								if y-coord of loop-entity is between {_y-max} and {_y-min}:
									updateAttacker(player, loop-entity)
									set fire to loop-entity for 2 seconds
					wait 5 tick 

			set {godlike-ULT-CD::%player's uuid%::MH} to now
			delete {godlike-ULT-CANCEL::%player's uuid%::MH}	
			delete {godlike-ULT-USE::%player's uuid%::MH}
			# ULT CD
			wait {_ultCooldown}
			delete {godlike-ULT-CD::%player's uuid%::MH}	
			if {class::%player's uuid%} = "MH":
				play sound "BLOCK_BEACON_ACTIVATE" at volume 3 at pitch 1 to player

on death of player:
	if {godlike-ULT-USE::%victim's uuid%::MH} is set:
		set {godlike-ULT-CANCEL::%victim's uuid%::MH} to true
		delete {mighty-DASH::%victim's uuid%}


# REAPER SCYTHE

function rgHitEntity(a: player, victim: living entity):
	updateAttacker({_a}, {_victim})
	directAttack({_victim})
	damage {_victim} by 1.5 heart
	if {class-perk::%{_a}'s uuid%::RS::perk} = {perk-check::2}:
		add potion effect of wither 1 without particles for 5 seconds to potion effects of {_victim}

	set {_d} to distance between {_a} and {_victim}
	set {_d} to {_d}/5
	if {_d} < 0.5:
		set {_d} to 0.5

	set {_v} to vector between {_victim} and {_a} 
	push {_victim} {_v} at speed {_d}
	play sound "block_chain_break" with volume 5 and pitch 0.75 at {_victim}	


function rgMovement(p: player, loc: location):
	set {_d} to distance between {_p} and {_loc}
	set {_d} to {_d}/5

	if {_d} > 1.75:
		if {class-perk::%{_p}'s uuid%::RS::perk} = {perk-check::1}: # grap perk strength and length
			if {_d} > 2:
				set {_d} to 2
				set {_h} to 0.25
			else:
				set {_h} to 0.3
		else:
			set {_d} to 1.75
			set {_h} to 0.3			
	else if {_d} > 1.25:
		set {_h} to 0.35
	else:
		set {_h} to 0.4

	set {_v} to vector between {_p} and {_loc}
	teleport {_p} to {_p}
	push {_p} upward at speed {_h}
	push {_p} {_v} at speed {_d}

	play sound "entity_bat_takeoff" with volume 0.5 and pitch 1 at {_p}



function reaperGrapple(p: player, length: number, victim: living entity):
	set {_uuid} to {_p}'s uuid
	set {_x} to 0
	loop {_length} times:
		add 1 to {_x}
		set {_loc} to {rg::%{_uuid}%::%{_x}%}
		draw 1 of dust using dustOption(black, 1) at {_loc}

		if {rg-hitLoc::%{_uuid}%} = {_x}:
			# CHECKS HIT ENTITIES
			if {rg-movement::%{_uuid}%} is set:
				rgMovement({_p}, {rg-movement::%{_uuid}%})
			# CHECKS HIT BLOCKS
			else if {rg-hitEntity::%{_uuid}%} is set:
				rgHitEntity({_p}, {rg-hitEntity::%{_uuid}%})

			delete {rg::%{_uuid}%::*}
			delete {rg-hitEntity::%{_uuid}%}
			delete {rg-movement::%{_uuid}%}
			delete {rg-hitLoc::%{_uuid}%}
			stop loop

# RS [CHECK]

function rgHitEntityCHECK(p: player, victim: living entity) :: number:
	set {_d} to distance between {_p} and {_victim}
	set {_d} to {_d}/5

	if {_d} < 0.5:
		set {_mana} to {weapons::RS::S-TAC-COST}
	else if {_d} < 1.75:
		set {_mana} to {weapons::RS::M-TAC-COST}
	else:
		set {_mana} to {weapons::RS::L-TAC-COST}

	set {rg-hitEntity::%{_p}'s uuid%} to {_victim}
	return {_mana}

function rgMovementCHECK(p: player, loc: location) :: number:
	set {_d} to distance between {_p} and {_loc}
	set {_d} to {_d}/5

	if {_d} >= 1.75:
		set {_mana} to {weapons::RS::L-TAC-COST}
	else if {_d} >= 1:
		set {_mana} to {weapons::RS::M-TAC-COST}
	else:
		set {_mana} to {weapons::RS::S-TAC-COST}

	set {rg-movement::%{_p}'s uuid%} to {_loc}
	return {_mana}



function reaperGrappleCHECK(p: player, length: number) :: number:
	set {_uuid} to {_p}'s uuid
	set {_x} to 0
	set {_l} to 0
	loop {_length} times: 
		add 1 to {_x}
		add 0.5 to {_l}
		set {rg::%{_uuid}%::%{_x}%} to location {_l} blocks infront of {_p}
		set {rg::%{_uuid}%::%{_x}%} to location 1.5 blocks above {rg::%{_uuid}%::%{_x}%} 
		set {_loc} to {rg::%{_uuid}%::%{_x}%}
		# CHECKS HIT ENTITIES
		set {_height} to 0
		loop 3 times:
			loop all living entities in radius 0.5 around {_loc}:
				if loop-entity is not a armor stand:
					if loop-entity is not {_p}:
						if {_height} = 0: # tracks 1 block tall mobs 
							set {_hit} to true
						else if {_height} = 1:
							if loop-entity is not a wolf: # tracks players and 2 block tall mobs 
								set {_hit} to true
						else if {_height} = 2:
							if loop-entity is a warden: # tracks mobs taller than players
								set {_hit} to true
						if {_hit} is set:
							set {rg-hitLoc::%{_uuid}%} to {_x}
							return rgHitEntityCHECK({_p}, loop-entity)
			add 1 to {_height}
			set {_loc} to location 1 blocks below {_loc}
		# CHECKS HIT BLOCKS
		loop blocks in radius 0.5 around {rg::%{_uuid}%::%{_x}%}: # cannot use {_loc}
			if loop-block is not fern, short grass, air or water:
				set {rg-hitLoc::%{_uuid}%} to {_x}
				return rgMovementCHECK({_p}, {rg::%{_uuid}%::%{_x}%}) 
	# RUNS IF NOTHING IS HIT
	return {weapons::RS::0-TAC-COST}
	

on right click with netherite hoe:
	if name of player's held item is "%{wc}%Reaper Scythe":
		if {class-perk::%player's uuid%::RS::perk} = {perk-check::1}:
			set {_grappleLength} to 26
		else:
			set {_grappleLength} to 18

		set {_mana} to reaperGrappleCHECK(player, {_grappleLength}) # (player, <blocks x2>) org = 30
		#broadcast {_mana}
		if tacCHECK(player, {_mana}) is true:
			play sound "block_chain_break" with volume 5 and pitch 1.2 at player
			set {_victim} to {rg-hitEntity::%player's uuid%}
			reaperGrapple(player, {_grappleLength}, {_victim}) # (player, <blocks x2>, <dmg>) org = 30
		else:
			delete {rg::%player's uuid%::*}
			delete {rg-hitEntity::%player's uuid%}
			delete {rg-movement::%player's uuid%}
			delete {rg-hitLoc::%player's uuid%}

function reaperBeam(p: player, e: living entity, v: vector):
	set vector length of {_v} to 0.1
	set {_loc} to location of {_p}
	add 1.25 to y-coord of {_loc}
	loop (distance between {_loc} and {_e}) / 0.1 times:
		draw 3 of dust using dustOption(black, 1) at {_loc}
		set {_loc} to {_loc} ~ {_v}
	updateAttacker({_p}, {_e})
	play sound "block_chain_break" with volume 5 and pitch 0.5 at {_p}


on drop of netherite hoe with priority low: # ULT USE
	if name of event-item is "%{wc}%Reaper Scythe":
		cancel event
		if {general-perk::%player's uuid%::perk} = 22:
			set {_ultCooldown} to {special::%player's uuid%::ULT-CD}
		else:
			set {_ultCooldown} to {weapons::RS::ULT-CD}
		if {godlike-ULT-USE::%player's uuid%::RS} is set:
			send "&cULT ALREADY ACTIVATED!" to player
		else if {godlike-ULT-CD::%player's uuid%::RS} is set:
			set {_time} to difference between now and {godlike-ULT-CD::%player's uuid%::RS}
			if {_time} < {_ultCooldown}:
				send "&cULT NOT READY!" to player
		else if ultCHECK(player, {weapons::RS::ULT-COST}) is true:
			set {godlike-ULT-USE::%player's uuid%::RS} to now	
			add potion effect of speed 2 without particles for 6 seconds to potion effects of player
			# PHY TAC
			set {_loc} to location of player
			set {_y-max} to y-coord of {_loc}+2.5
			set {_y-min} to y-coord of {_loc}-2.5

			reaperSlash({_loc}, 9, 3, 1.5) # loc, radius, degree, particle-size
			reaperSlash({_loc}, 7, 6, 1) # loc, radius, degree, particle-size
			reaperSlash({_loc}, 3.5, 9, 0.75) # loc, radius, degree, particle-size
			play sound "entity.player.attack.sweep" with volume 5 and pitch 1.5 at {_loc}
			loop all living entities in radius 9.5 around {_loc}:
				if loop-entity is not player:
					if y-coord of loop-entity is between {_y-max} and {_y-min}:
						updateAttacker(player, loop-entity)
						add loop-entity to {_hitEnemies::*}
						set {_amount} to 1.5
						if distance between player and loop-entity >= 7:
							set {_amount} to 2.5
							play sound "entity.wither.hurt" with volume 0.5 and pitch 0.75 to player
						add potion effect of wither 2 without particles for 6 seconds to potion effects of loop-entity
						damage loop-entity by {_amount}
			wait 1 second
			loop {_hitEnemies::*}:
				set {_entity} to loop-value
				if {_entity} is a living entity:
					set {_v} to vector from player to {_entity}
					reaperBeam(player, {_entity}, {_v})

					add potion effect of blindness 1 without particles for 5 seconds to potion effects of {_entity}
					set {_shapes::%{_entity}%} to a circle with radius 0.5
					play sound "entity_wither_spawn" with volume 1 and pitch 1 to {_entity}

			# Blindness Effect
			set particle of {_shapes::*} to 1 of dust_color_transition particle using dustTransition(black, gray, 0.75)
			set {_rotation} to rotation around vector(1, 1, 1) by 9 degrees
			loop 100 times:
				loop {_shapes::*}:
					set {_e} to loop-index parsed as player
					set {_loc} to {_e}'s location
					add 1.5 to y-coord of {_loc}
					if {_e} is not invisible:
						draw shapes {_shapes::%loop-index%} at {_loc}
				rotate shapes {_shapes::*} by {_rotation}
				wait 1 tick

			set {godlike-ULT-CD::%player's uuid%::RS} to now	
			delete {godlike-ULT-USE::%player's uuid%::RS}
			# ULT CD
			wait {_ultCooldown}
			delete {godlike-ULT-CD::%player's uuid%::RS}	
			if {class::%player's uuid%} = "RS":
				play sound "BLOCK_BEACON_ACTIVATE" at volume 3 at pitch 1 to player


on damage of living entity: #PASSIVE
	if name of attacker's held item is "%{wc}%Reaper Scythe":	
		if {reaper-attack::%attacker's uuid%} = 2:
			delete {reaper-attack::%attacker's uuid%} 
			set level of attacker to 0
			set level progress of attacker to 0
			loop all entities in radius 3 around attacker:
				if loop-entity is not attacker:
					updateAttacker(attacker, loop-entity)
					add potion effect of wither 1 without particles for 5 seconds to potion effects of loop-entity

			set {_loc} to attacker's location
			reaperSlash({_loc}, 3, 9, 0.75) # loc, radius, degree, particle-size

		else:
			add 1 to {reaper-attack::%attacker's uuid%} 
			set level of attacker to 0
			add 0.495 to level progress of attacker


function reaperSlash(loc: location, main: number, degree: number, size: number): # loc, radius, degree, particle-size
	set {_other} to {_main} - 0.5

	set {_shapes::c1} to a circle with radius {_main}
	set particle of {_shapes::c1} to 1 of dust particle using dustOption(black, {_size}) 

	set {_shapes::c2} to a circle with radius {_other}
	set particle of {_shapes::c2} to 1 of dust particle using dustOption(gray, {_size}) 
	set {_shapes::c3} to a circle with radius {_other}
	set particle of {_shapes::c3} to 1 of dust particle using dustOption(gray, {_size}) 
	set {_rotation1} to rotation around vector(1, 1, 1) by {_degree} degrees
	set {_rotation2} to rotation around vector(1, 1, 1) by (-1*{_degree}) degrees
	rotate shapes {_shapes::c2} by {_rotation1}
	rotate shapes {_shapes::c3} by {_rotation2}

	add 1 to y-coord of {_loc}
	draw shapes {_shapes::*} at {_loc}

function rsCHECK(a: player, v: living entity, cause: text) :: number:
	if {_cause} is "attack":
		if {class-perk::%{_a}'s uuid%::RS::perk} = {perk-check::3}:
			set {_potions::*} to active potion effects of {_v}
			if {_potions::*} is set:
				loop {_potions::*}:
					set {_effect} to "%loop-value%"
					if {_effect} contains "blindness":
						heal {_a} by 0.5
						return 0.5


# MARKSMAN

function marksmanBeam(p: player, e: living entity, v: vector, h: number):
	set vector length of {_v} to 0.1
	set {_loc} to location of {_p}
	add {_h} to y-coord of {_loc}
	loop (distance between {_loc} and {_e}) / 0.1 times:
		draw 3 of dust_color_transition using dustTransition(cyan, orange, 0.75) at {_loc}
		set {_loc} to {_loc} ~ {_v}
	play sound "entity_blaze_shoot" at volume 5 at pitch 1.5 at location of {_p}
	play sound "BLOCK_GLASS_BREAK" at volume 3 at location of {_e}

	# add potion effect of slowness 1 without particles for 7 seconds to potion effects of {_e}

	itemEnchant({_p}, "%{wc}%Marksman Hatchet")

	send title "" with subtitle "&cmarked" to {_e} for 1 seconds with fade out 1 second
	set metadata value "marked" of {_e} to {_p}
	set glowing of {_e} to true
	loop 7 times:
		if metadata value "marked" of {_e} is {_p}:
			wait 1 second
		else:
			stop loop
	delete metadata value "marked" of {_e}
	set glowing of {_e} to false

	itemDisenchant({_p}, "%{wc}%Marksman Hatchet")


function marksmanTarget(p: player):
	set {_beamRange} to 30
	loop {_beamRange} times: 
		add 1 to {_dis}
		set {_loc} to location {_dis} blocks infront of {_p}
		set {_loc} to location 1 blocks above {_loc}
		loop all living entities in radius 1.5 of {_loc}:
			if loop-entity is not a armor stand:
				if loop-entity isn't {_p}:
					set {_target} to loop-entity
					set {_v} to vector from {_p} to {_target}
					# func
					marksmanBeam({_p}, {_target}, {_v}, 1.25)
					stop loop
		if {_target} is set:
			stop loop
	if {_target} isn't set:
		play sound "entity.blaze.hurt" at volume 3 and pitch 0.5 to {_p}
		add {weapons::MMH::0-TAC-COST} to {mana::%{_p}'s uuid%::curr}

on right click with stone axe:
	if name of player's held item is "%{wc}%Marksman Hatchet": 
		if tacCHECK(player, {weapons::MMH::TAC-COST}) is true:
			marksmanTarget(player)


function mmhCHECK(a: living entity, v: living entity, dmg: number) :: number:
	if {_a} is a player:
		if metadata value "marked" of {_v} is {_a}:
			if name of {_a}'s held item is "%{wc}%Marksman Hatchet":
				return ({_dmg}*0.2)

function mmsULT(p: player, id: string):
	set {_uuid} to {_p}'s uuid

	set {marksman-ULT-ammoCount::%{_uuid}%} to 0
	wait {weapons::MMH::ULT-CD}
	wait 1 second
	if {class-ID::%{_uuid}%} = {_id}: 
		set {marksman-ULT-ammoCount::%{_uuid}%} to 1
		sniperUpdateName({_p})

	while {class-ID::%{_uuid}%} = {_id}:
		set {godlike-ULT-CD::%{_uuid}%::MMH} to now
		wait {weapons::MMH::ULT-CD}
		if {class-ID::%{_uuid}%} = {_id}: 
			delete {godlike-ULT-CD::%{_uuid}%::MMH}

			if {marksman-ULT-ammoCount::%{_uuid}%} < 3:
				add 1 to {marksman-ULT-ammoCount::%{_uuid}%}
				sniperUpdateName({_p})
				play sound "BLOCK_BEACON_ACTIVATE" at volume 3 at pitch 1 to {_p}


function sniperUpdateName(p: player):
	set {_ammo} to {marksman-ULT-ammoCount::%{_p}'s uuid%}
	if {_ammo} = 0:
		set {_update} to "&7● ● ●"
	else if {_ammo} = 1:
		set {_update} to "&7● ● &e●"
	else if {_ammo} = 2:
		set {_update} to "&7● &e● ●"
	else if {_ammo} = 3:
		set {_update} to "&e● ● ●"
	loop {_p}'s inventory:
		if name of loop-value contains "%{wc}%Marksman Sniper":
			set {_i} to index of loop-value
			set name of slot {_i} of {_p}'s inventory to "%{wc}%Marksman Sniper %{_update}%"
			stop loop
	if {_i} isn't set:
		wait 5 ticks
		loop {_p}'s inventory:
			if name of loop-value contains "%{wc}%Marksman Sniper":
				set {_i} to index of loop-value
				set name of slot {_i} of {_p}'s inventory to "%{wc}%Marksman Sniper %{_update}%"
				stop loop		

function sniperParticle(p: player, e: entity):
	while metadata value "hit" of {_e} isn't set:
		draw 3 of dust_color_transition using dustTransition(cyan, orange, 0.75) at {_e} with offset vector(0, 0, 0) with extra 0
		if (y-coord of {_e}) < -75:
			set metadata value "hit" of {_e} to true
		wait 1 tick
	kill {_e}

on drop of stone axe with priority low:
	if name of event-item is "%{wc}%Marksman Hatchet": 
		cancel event
		send "&cULT WEAPON IN INVENTORY!" to player

on drop of spyglass with priority low:
	if name of event-item contains "%{wc}%Marksman Sniper": 
		cancel event
		set {tacCheck-fix::%player's uuid%} to true # fix the drop issue, dropping triggers a left click event
		if {sniper-CD::%player's uuid%} is set:
			send "&cSNIPER RELOADING!" to player
		else if {marksman-ULT-ammoCount::%player's uuid%} > 0:
			if ultCHECK(player, {weapons::MMS::ULT-COST}) is true:
				set {sniper-CD::%player's uuid%} to now
				remove 1 from {marksman-ULT-ammoCount::%player's uuid%}

				if {sniper-scoped::%player's uuid%} is set:
					shoot a snowball from player at speed 4.5
					delete {sniper-scoped::%player's uuid%} 
				else:
					set {_l} to location 0.5 in front of player
					add 1.5 to y-coord of {_l}
					set {_y} to a random number between -3 and 3 
					set {_p} to a random number between -3 and 3
					add {_y} to yaw of {_l}
					add {_p} to pitch of {_l}
					shoot a snowball from {_l} at speed 4.5

				set metadata value "attacker" of shot projectile to player
				set metadata value "type" of shot projectile to "MMS"

				sniperParticle(player, shot projectile)
				play sound "ENTITY_FIREWORK_ROCKET_BLAST" at volume 1 at pitch 0.1 at player
				wait 5 ticks
				if name of player's held item contains "%{wc}%Marksman Sniper": 
					disenchant player's held item
					sniperUpdateName(player)
					sniperRELOAD(player)
				else:
					wait 5 ticks
					sniperUpdateName(player)
					itemDisenchant(player, "%{wc}%Marksman Sniper")
		else:
			send "&cSNIPER AMMO REQUIRED!" to player
			play sound "ENTITY_ITEM_BREAK" at volume 5 at pitch 2 to player


on held item change:	
	if name of player's held item contains "%{wc}%Marksman Sniper": 
		if {sniper-CD::%player's uuid%} is set:
			sniperRELOAD(player)
	else:
		delete {sniper-scoped::%player's uuid%} 


function sniperRELOAD(p: player):
	wait 10 ticks
	if name of {_p}'s held item contains "%{wc}%Marksman Sniper":
		play sound "BLOCK_PISTON_EXTEND" at volume 1 at pitch 1.5 to {_p}
	wait 10 ticks
	if name of {_p}'s held item contains "%{wc}%Marksman Sniper":
		enchant {_p}'s held item with unbreaking 1
		delete {sniper-CD::%{_p}'s uuid%}
		play sound "BLOCK_PISTON_CONTRACT" at volume 1 at pitch 1.5 to {_p}

on left click with spyglass:
	if name of player's held item contains "%{wc}%Marksman Sniper": 
		if {tacCheck-fix::%player's uuid%} is set: # fix the drop issue, dropping triggers a left click event
			delete {tacCheck-fix::%player's uuid%} 
		else:
			if tacCHECK(player, {weapons::MMH::TAC-COST}) is true:
				marksmanTarget(player)

on right click with spyglass:
	if name of event-item contains "%{wc}%Marksman Sniper": 
		set {sniper-scoped::%player's uuid%} to now

on stop using item:
	if name of event-item contains "%{wc}%Marksman Sniper":
		delete {sniper-scoped::%player's uuid%} 

on damage of living entity with priority high:
	if event-damagecause is a projectile:
		if event-projectile is a snowball:
			set {_attacker} to metadata value "attacker" of event-projectile
			updateAttacker({_attacker}, victim)
			if metadata value "type" of event-projectile is "MMS":
				if distance between {_attacker} and location of victim >= 12.5:
					set {_d} to 5
				else if distance between {_attacker} and location of victim >= 7.5:
					set {_d} to 4
				else:
					set {_d} to 4 # 3
				add potion effect of slowness 2 for 3 seconds to potion effects of victim
				play sound "BLOCK_NOTE_BLOCK_PLING" at volume 1 at pitch 1.5 to {_attacker}
			if metadata value "marked" of victim is {_attacker}:
				add ({weapons::MMS::ULT-COST}*10) to {mana::%{_attacker}'s uuid%::curr}
				set {_d} to {_d}*1.5

			set {_d} to projectileDmgCHECK({_attacker}, victim, {_d})
			add {_d} to damage

			if {class-perk::%{_attacker}'s uuid%::MMH::perk} = {perk-check::1}:
				if {marksmanPerk-28::%{_attacker}'s uuid%} isn't set:
					set {marksmanPerk-28::%{_attacker}'s uuid%} to now
					add 1 to {marksman-ULT-ammoCount::%{_attacker}'s uuid%}
					sniperUpdateName({_attacker})	
					set level of {_attacker} to 0	
					set level progress of {_attacker} to 0
					wait 10 seconds		
					delete {marksmanPerk-28::%{_attacker}'s uuid%}
					if {class::%{_attacker}'s uuid%} = "MMH":
						set level of {_attacker} to 0
						add 0.99 to level progress of {_attacker}

			dmgStats({_attacker}, victim, {_d}, "MMS")
			showDMG(victim, {_d})

on join:
	delete {sniper-CD::%player's uuid%}
	delete {sniper-scoped::%player's uuid%} 
	delete metadata value "marked" of player


# NINJA

on right click with nether star or diamond sword:
	if name of player's held item is "%{wc}%Ninja Shurikens" or "%{wc}%Ninja Katana": 
		if tacCHECK(player, {weapons::NS::TAC-COST}) is true:

			loop 3 times:

				set {_l} to location 0.5 in front of player
				add 1.5 to y-coord of {_l}
				set {_y} to a random number between -3 and 3 # w
				set {_p} to a random number between -0.5 and 0.5 # h
				add {_y} to yaw of {_l}
				add {_p} to pitch of {_l}

				shoot a arrow from {_l} with speed 2
				if {godlike-ULT-USE::%player's uuid%::NS} is set:
					if {class-perk::%player's uuid%::NS::perk} = {perk-check::2}:
						set metadata value "fire" of shot projectile to true
						ignite shot projectile

				set metadata value "type" of shot projectile to "NS"
				set metadata value "attacker" of shot projectile to player
				play sound "entity_arrow_shoot" with volume 3 and pitch 1.5 at player
				add shot projectile to {_sp::*}

				wait 3 tick

			loop 100 times:
				loop {_sp::*}:
					if metadata value "hit" of loop-value-2 isn't set:
						draw 1 of electric spark particle at loop-value-2 with offset vector(0, 0, 0) with extra 0 
						if (y-coord of loop-value-2) < -75:
							set metadata value "hit" of loop-value-2 to true
							kill loop-value-2
							stop loop
						wait 1 tick

on damage of living entity:
	if event-damagecause is a projectile:
		if event-projectile is a arrow:
			if metadata value "type" of event-projectile is "NS":
				set {_attacker} to metadata value "attacker" of event-projectile
				updateAttacker({_attacker}, victim)

				if metadata value "fire" of event-projectile is true:
					set fire to victim for 4 seconds


on drop of nether star with priority low: # ULT USE
	if name of event-item is "%{wc}%Ninja Shurikens":
		cancel event
		if {general-perk::%player's uuid%::perk} = 22:
			set {_ultCooldown} to {special::%player's uuid%::ULT-CD}
		else:
			set {_ultCooldown} to {weapons::NS::ULT-CD}
		if {godlike-ULT-USE::%player's uuid%::NS} is set:
			send "&cULT ALREADY ACTIVATED!" to player
		else if {godlike-ULT-CD::%player's uuid%::NS} is set:
			set {_time} to difference between now and {godlike-ULT-CD::%player's uuid%::NS}
			if {_time} < {_ultCooldown}:
				send "&cULT NOT READY!" to player
		else if ultCHECK(player, {weapons::NS::ULT-COST}) is true:
			set {godlike-ULT-USE::%player's uuid%::NS} to now
			add potion effect of speed 3 without particles for 10 seconds to potion effects of player
			add potion effect of jump boost 4 without particles for 10 seconds to potion effects of player
			play sound "entity_ender_dragon_growl" with volume 5 and pitch 1.5 at player
			# PHY ULT
			wait 5 ticks
			if name of player's held item is "%{wc}%Ninja Shurikens": 
				set player's held item to {class::weapon::NK}
			else:
				wait 5 ticks
				loop player's inventory:
					if name of loop-value is "%{wc}%Ninja Shurikens":
						set {_i} to index of loop-value
						set slot {_i} of player's inventory to {class::weapon::NK}
						stop loop

			loop 40 times:
				set {_loc} to player's location
				add 1 to y-coord of {_loc}
				#rotate shapes {_shapes::*} by {_rotation}
				#draw shapes {_shapes::*} at {_loc}
				draw 1 of flame particle at block above player with extra 0.1
				draw 1 of lava particle at block above player with extra 0.1
				wait 5 tick

			loop player's inventory:
				if name of loop-value is "%{wc}%Ninja Katana":
					set {_i} to index of loop-value
					set slot {_i} of player's inventory to {class::weapon::NS}

			set {godlike-ULT-CD::%player's uuid%::NS} to now	
			delete {godlike-ULT-USE::%player's uuid%::NS}
			# ULT CD
			wait {_ultCooldown}
			delete {godlike-ULT-CD::%player's uuid%::NS}	
			if {class::%player's uuid%} = "NS":
				play sound "BLOCK_BEACON_ACTIVATE" at volume 3 at pitch 1 to player

on damage of living entity:
	if name of attacker's held item is "%{wc}%Ninja Katana": 
		set fire to victim for 2 seconds
		play sound "ITEM_FIRECHARGE_USE" at volume 2 at pitch 0.5 at victim

function nkStamina(p: player):
	if {godlike-ULT-USE::%{_p}'s uuid%::NS} is set:
		play sound "ITEM_FIRECHARGE_USE" at volume 2 at pitch 1 at {_p}
		set {_size} to 0.5

		loop 20 times:
			add 1 to {_n}
			if {_p} isn't on ground:
				loop all living entities in radius 2 around {_p}:
					if loop-entity is not {_p}:
						updateAttacker({_p}, loop-entity)
						set fire to loop-entity for 4 seconds
						play sound "ITEM_FIRECHARGE_USE" at volume 2 at pitch 1 at loop-entity 
			else if {_n} < 3:
				loop all living entities in radius 2 around {_p}:
					if loop-entity is not {_p}:
						updateAttacker({_p}, loop-entity)
						set fire to loop-entity for 4 seconds		
						play sound "ITEM_FIRECHARGE_USE" at volume 2 at pitch 1 at loop-entity 	
			else:
				stop loop

			set {_shapes::circle} to a circle with radius {_size}
			set particle of {_shapes::*} to 1 of flame particle

			set {_loc} to {_p}'s location
			add 1 to y-coord of {_loc}
			draw shapes {_shapes::*} at {_loc}

			if {_size} < 2:
				add 0.5 to {_size}

			wait 5 ticks

# POSEIDONS TRIDENT

on right click with trident: # TRIDENT DROP
	if {class::%player's uuid%} = "PT":
		if {class-perk::%player's uuid%::PT::perk} = {perk-check::2}: 
			if metadata value "tac" of player is set:
				set {_loc} to location of metadata value "tac" of player
				set {_proj} to metadata value "tac" of player
				delete metadata value "tac" of player

				set metadata value "hit" of {_proj} to true
				kill {_proj}

				set pitch of {_loc} to 90

				shoot a trident from {_loc} at speed 1.5

				set metadata value "attacker" of shot projectile to player
				set metadata value "type" of shot projectile to "PT"

on shoot: # TAC
	if name of shooter's held item is "%{wc}%Poseidon's Trident":
		if difference between now and {projectileChangeFix::%shooter's uuid%} > 10 ticks:
			if tacCHECK(shooter, {weapons::PT::TAC-COST}) is true:
				cancel event
				set shooter's held item to {class::weapon::PT}
			
				set {projectileChangeFix::%shooter's uuid%} to now
				shoot a trident from shooter at speed 4
				set {_proj} to last shot projectile

				set metadata value "tac" of shooter to {_proj}
				set metadata value "attacker" of {_proj} to shooter
				set metadata value "type" of {_proj} to "PT"

				play sound "item_trident_throw" at volume 3 at pitch 1 at shooter

				if {class-perk::%shooter's uuid%::PT::perk} = {perk-check::2}:
					add potion effect of speed 2 without particles for 4 seconds to potion effects of shooter

				while metadata value "hit" of {_proj} isn't set:
					if metadata value "type" of {_proj} is "PT":
						draw 5 of bubble at {_proj} with offset vector(0.1, 0.1, 0.1) with extra 0 
					if (y coord of {_proj}) < -75:
						set metadata value "hit" of {_proj} to true
					wait 1 tick
				kill {_proj}
				delete metadata value "tac" of shooter
			else:
				cancel event

on damage of living entity:
	if event-damagecause is a projectile:
		if event-projectile is a trident:
			if metadata value "type" of event-projectile is "PT":
				set {_attacker} to metadata value "attacker" of event-projectile
				updateAttacker({_attacker}, victim)

function ptPerkCHECK(a: player, v: living entity) :: number:
	if {class-perk::%{_a}'s uuid%::PT::perk} = {perk-check::1}: 
		updateAttacker({_a}, {_v})
		set {_h} to health of {_v}
		set {_h} to {_h}*0.25
		if {_h} < 1.5:
			set {_h} to 1.5
		damage {_v} by {_h} 
		heal {_a} by {_h} 
		dmgStats({_a}, {_v}, {_h}, "PT")
		return 0


on projectile hit with priority low: # TAC
	if event-projectile is a trident:
		if metadata value "type" of event-projectile is "PT":
			if metadata value "hit" of event-projectile isn't set:
				set {_p} to metadata value "attacker" of event-projectile
				set {_loc} to event-location
				set yaw of {_loc} to yaw of {_p}
				set pitch of {_loc} to pitch of {_p}

				teleport {_p} to {_loc}
		wait 1.5 second
		kill event-projectile

on drop of trident with priority low: # ULT USE
	if name of event-item is "%{wc}%Poseidon's Trident":
		cancel event
		if {general-perk::%player's uuid%::perk} = 22:
			set {_ultCooldown} to {special::%player's uuid%::ULT-CD}
		else:
			set {_ultCooldown} to {weapons::PT::ULT-CD}
		if {godlike-ULT-USE::%player's uuid%::PT} is set:
			send "&cULT ALREADY ACTIVATED!" to player
		else if {godlike-ULT-CD::%player's uuid%::PT} is set:
			set {_time} to difference between now and {godlike-ULT-CD::%player's uuid%::PT}
			if {_time} < {_ultCooldown}:
				send "&cULT NOT READY!" to player
		else if ultCHECK(player, {weapons::PT::ULT-COST}) is true:
			set {godlike-ULT-USE::%player's uuid%::PT} to now

			set {weatherChange} to 8
			play sound "entity.elder_guardian.curse" at volume 10 at pitch 1.25 at block 10 above location of player

			set {_shapes::circle} to a circle with radius 1.25
			set particle of {_shapes::*} to 1 of dust_color_transition particle using dustTransition(cyan, lime, 0.75)
			set {_rotation} to rotation around vector(1, 1, 1) by 9 degrees

			loop 140 times:
				add 1 to {_n}
				set {_loc} to player's location
				add 1 to y-coord of {_loc}
				rotate shapes {_shapes::*} by {_rotation}
				draw shapes {_shapes::*} at {_loc}
				if {_n} = 10:
					delete {_n}
					removeBadEffects(player, "victim")
					add potion effect of speed 3 without particles for 1 seconds to potion effects of player
					add potion effect of regeneration 2 without particles for 1 seconds to potion effects of player
				wait 1 tick

			set {godlike-ULT-CD::%player's uuid%::PT} to now
			delete {godlike-ULT-USE::%player's uuid%::PT}
			# ULT CD
			wait {_ultCooldown}
			delete {godlike-ULT-CD::%player's uuid%::PT}
			if {class::%player's uuid%} = "PT":
				play sound "BLOCK_BEACON_ACTIVATE" at volume 3 at pitch 1 to player



		
			

# HUNTER (PSS in summon.sk)

on right click with iron sword: # TAC USE
	if name of player's held item is "%{wc}%Hunter Knife": 
		if {hunterPoison::%player's uuid%} is set:
			send "&cPoison Already Active!" to player
			play sound "BLOCK_NOTE_BLOCK_BASS" at volume 1 at pitch 0.5 to player
		else:
			if tacCHECK(player, {weapons::HK::TAC-COST}) is true:
				set {hunterPoison::%player's uuid%} to true
				itemEnchant(player, "%{wc}%Hunter Knife")

on damage of living entity:
	if name of attacker's held item is "%{wc}%Hunter Knife": 
		if {hunterPoison::%attacker's uuid%} is set:
			if victim is not a armor stand:
				delete {hunterPoison::%attacker's uuid%}
				add potion effect of poison 1 for 5 seconds to potion effects of victim
				disenchant attacker's held item

				set {_shape} to a arc with radius 1, height 0, and angle 120 degrees
				set particle of {_shape} to 1 of dust_color_transition particle using dustTransition(light green, green, 1) with offset vector(0, 0, 0) with extra 0 

				set {_view} to vector from yaw attacker's yaw and pitch attacker's pitch

				set {_rotation} to rotation from vector(1, 1, 1) to {_view}
				rotate shape {_shape} by {_rotation}
				#rotate shape {_shape} around relative y axis by -1 * {_yaw}
				set {_loc} to location 1 block in front of attacker's eye location
				loop 5 times:
					draw the shape {_shape} at {_loc} ~ {_view}
				wait 2 tick


on drop of iron sword with priority low: # ULT USE
	if name of event-item is "%{wc}%Hunter Knife":
		cancel event
		if {godlike-ULT-CD::%player's uuid%::HC} is set:
			set {_time} to difference between now and {godlike-ULT-CD::%player's uuid%::HC}
			if {_time} < {weapons::HC::ULT-CD}:
				send "&cULT NOT READY!" to player
		else if ultCHECK(player, {weapons::HC::ULT-COST}) is true:
			set {godlike-ULT-CD::%player's uuid%::HC} to now	
			wait 5 ticks
			if name of player's held item is "%{wc}%Hunter Knife": 
				set player's held item to {class::weapon::HC}
			else:
				wait 5 ticks
				loop player's inventory:
					if name of loop-value is "%{wc}%Hunter Knife":
						set {_i} to index of loop-value
						set slot {_i} of player's inventory to {class::weapon::HC}
						stop loop
			# ULT CD
			wait {weapons::HC::ULT-CD}
			delete {godlike-ULT-CD::%player's uuid%::HC}	
			if {class::%player's uuid%} = "HC":
				play sound "BLOCK_BEACON_ACTIVATE" at volume 3 at pitch 1 to player

on shoot: # ATK USE
	if name of shooter's held item is "%{wc}%Hunter Crossbow":
		if atkCHECK(shooter, {weapons::HC::ATK-COST}) is true:

			set metadata value "attacker" of event-projectile to shooter
			set metadata value "type" of event-projectile to "HC"
			if {hunterPoison::%shooter's uuid%} is set:
				delete {hunterPoison::%shooter's uuid%}
				set {_poisonParticles} to true
				set metadata value "tac" of event-projectile to "HC"

			add event-projectile to {_sp::*}

			wait 2 tick
			loop 2 times:
				add 1 to {_n}
				set {_l} to shooter's location
				add 1.5 to y-coord of {_l}
				if {_n} = 1:
					set {_y} to -3 # w
				else if {_n} = 2:
					set {_y} to 3 # w
				add {_y} to yaw of {_l}
				shoot a arrow from {_l} with speed 3
				set metadata value "attacker" of shot projectile to shooter
				set metadata value "type" of shot projectile to "HC"
				if {_poisonParticles} is set:
					set metadata value "tac" of shot projectile to "HC"

				add shot projectile to {_sp::*}

				wait 2 tick

			arrowGive(shooter)
			loop 100 times:
				loop {_sp::*}:	
					if metadata value "hit" of loop-value-2 isn't set:
						draw 10 of crit at loop-value-2 with offset vector(0, 0, 0) with extra 0
						if {_poisonParticles} is true:
							draw 5 of dust_color_transition using dustTransition(light green, green, 1) at loop-value-2 with offset vector(0.1, 0.1, 0.1) with extra 0 
						if (y-coord of loop-value-2) < -75:
							set metadata value "hit" of loop-value-2 to true
							kill loop-value-2
							stop loop
						wait 1 tick
		else:
			cancel event
			arrowGive(shooter)


on left click with crossbow: # TAC USE
	if name of player's held item is "%{wc}%Hunter Crossbow": 
		if {tacCheck-fix::%player's uuid%} is set: # fix the drop issue, dropping triggers a left click event
			delete {tacCheck-fix::%player's uuid%} 
		else if {hunterPoison::%player's uuid%} is set:
			send "&cPoison Already Active!" to player
			play sound "BLOCK_NOTE_BLOCK_BASS" at volume 1 at pitch 0.5 to player
		else if tacCHECK(player, {weapons::HC::TAC-COST}) is true:
			set {hunterPoison::%player's uuid%} to true
			play sound "item.crossbow.loading_end" at volume 10 at pitch 1 to player

on damage of living entity with priority high:
	if event-damagecause is a projectile:
		if event-projectile is a arrow:
			set {_attacker} to metadata value "attacker" of event-projectile
			updateAttacker({_attacker}, victim)
			if metadata value "type" of event-projectile is "HC":
				if distance between {_attacker} and location of victim >= 12.5:
					set {_d} to 2.25
				else if distance between {_attacker} and location of victim >= 7.5:
					set {_d} to 1.75 # 1.5
				else:
					set {_d} to 1.75 # 1.25

				if metadata value "tac" of event-projectile is "HC":
					add potion effect of poison 1 for 5 seconds to potion effects of victim

				
				set {_d} to projectileDmgCHECK({_attacker}, victim, {_d})
				set damage to {_d}

				dmgStats({_attacker}, victim, {_d}, "PF")
				showDMG(victim, {_d})	

				summonTarget({_attacker}, victim)




on drop of crossbow with priority low: # ULT USE
	if name of event-item is "%{wc}%Hunter Crossbow":
		cancel event
		set {tacCheck-fix::%player's uuid%} to true # fix the drop issue, dropping triggers a left click event
		if {godlike-ULT-CD::%player's uuid%::HC} is set:
			set {_time} to difference between now and {godlike-ULT-CD::%player's uuid%::HC}
			if {_time} < {weapons::HK::ULT-CD}:
				send "&cULT NOT READY!" to player
		else if ultCHECK(player, {weapons::HC::ULT-COST}) is true:
			set {godlike-ULT-CD::%player's uuid%::HC} to now	
			remove all arrow from inventory of player
			wait 5 ticks
			if name of player's held item is "%{wc}%Hunter Crossbow": 
				set player's held item to {class::weapon::HK}
				if {hunterPoison::%player's uuid%} is set:
					itemEnchant(player, "%{wc}%Hunter Knife")
			else:
				wait 5 ticks
				loop player's inventory:
					if name of loop-value is "%{wc}%Hunter Crossbow":
						set {_i} to index of loop-value
						set slot {_i} of player's inventory to {class::weapon::HK}
						if {hunterPoison::%player's uuid%} is set:
							itemEnchant(player, "%{wc}%Hunter Knife")
						stop loop
			# ULT CD
			set {special::%player's uuid%::ULT-CD} to {weapons::HK::ULT-CD}
			wait {weapons::HK::ULT-CD}
			delete {godlike-ULT-CD::%player's uuid%::HC}	
			delete {special::%player's uuid%::ULT-CD} 
			if {class::%player's uuid%} = "HC":
				play sound "BLOCK_BEACON_ACTIVATE" at volume 3 at pitch 1 to player

# TEMPEST BOW

on right click with bow: # sets a var to when bow starts charging
	if name of player's held item is "%{wc}%Tempest Bow":
		set {bowCharge::%player's uuid%} to now

on shoot: 
	if name of shooter's held item is "%{wc}%Tempest Bow":
		if "%event-projectile%" is "arrow":
			cancel event
		if difference between now and {projectileChangeFix::%shooter's uuid%} > 10 ticks:
			if {class-perk::%shooter's uuid%::TB::perk} = {perk-check::1}:
				set {_mana} to {perk-var::TB::28}
			else:
				set {_mana} to {weapons::TB::ATK-COST}
			if atkCHECK(shooter, {_mana}) is true:

				set {projectileChangeFix::%shooter's uuid%} to now
				set {_time} to difference between now and {bowCharge::%shooter's uuid%}
				if {_time} < 0.5 seconds:
					set {_speed} to 0.75
					set {_dmg} to 1
				else if {_time} < 0.75 seconds:
					set {_speed} to 1
					set {_dmg} to 1.5
				else if {_time} < 1 seconds:
					set {_speed} to 1.5
					set {_dmg} to 2
				else if {_time} < 1.5 seconds:
					set {_speed} to 2
					set {_dmg} to 3
				else:
					set {_speed} to 4
					set {_dmg} to 3.5

				shoot wind charge from shooter at speed {_speed}
				delete {bowCharge::%shooter's uuid%}

				set metadata value "attacker" of shot projectile to shooter
				set metadata value "type" of shot projectile to "TB"
				set metadata value "charge" of shot projectile to {_dmg}
				while metadata value "hit" of shot projectile isn't set:
					if metadata value "type" of shot projectile is "TB":
						draw 1 of electric spark particle at shot projectile with offset vector(0, 0, 0) with extra 0 
					if (y coord of shot projectile) < -75:
						set metadata value "hit" of shot projectile to true
					wait 1 tick
				kill shot projectile
			else:
				cancel event
		else:
			cancel event

on damage of living entity with priority high:
	set {_cause} to "%event-damagecause%"
	if {_cause} = "projectile":
		if event-projectile is a fireball:
			set {_attacker} to metadata value "attacker" of event-projectile
			updateAttacker({_attacker}, victim)
			if metadata value "type" of event-projectile is "TB":
				set {_d} to metadata value "charge" of event-projectile

			set {_d} to projectileDmgCHECK({_attacker}, victim, {_d})
			add {_d} to damage

			dmgStats({_attacker}, victim, {_d}, "TB")
			showDMG(victim, {_d})

on join:
	set {tempestTimerPSS::%player's uuid%} to now

function tempestPSS(p: player): # PSS
	set {_uuid} to {_p}'s uuid
	if {tempestPSS::%{_uuid}%} is set:
		set level of {_p} to 0
		set level progress of {_p} to 0
		remove levitation from active potion effects of {_p}
		delete {tempestPSS::%{_uuid}%}
	else:
		if difference between now and {tempestTimerPSS::%{_uuid}%} > 5 ticks:
			set {tempestPSS::%{_uuid}%} to true
			set {tempestTimerPSS::%{_uuid}%} to now
			add potion effect of slow falling 1 without particles for 5 minutes to potion effects of {_p}
			set level of {_p} to 0
			add 0.99 to level progress of {_p}
			if {_p} is not on ground:
				add potion effect of levitation 1 without particles for 10 ticks to potion effects of {_p}

			while {tempestPSS::%{_uuid}%} is set:
				if {class::%{_uuid}%} = "TB": 
					set {_mana} to {weapons::TB::TAC-COST} / 4
					if atkCHECK({_p}, {_mana}) is true:
						set {_loc} to location of {_p}
						draw 3 of dust_color_transition using dustTransition(white, light gray, 0.75) at {_loc} with offset vector(0.1, 0.1, 0.1) with extra 0
						add 0.5 to y coord of {_loc}
						draw 3 of dust_color_transition using dustTransition(white, light gray, 0.75) at {_loc} with offset vector(0.1, 0.1, 0.1) with extra 0
						wait 5 ticks
					else:
						delete {tempestPSS::%{_uuid}%}
				else:
					delete {tempestPSS::%{_uuid}%}
			set level of {_p} to 0
			set level progress of {_p} to 0
			remove slow falling from active potion effects of {_p}

on left click with bow: # TAC USE
	if name of player's held item is "%{wc}%Tempest Bow": 
		if {tacCheck-fix::%player's uuid%} is set: # fix the drop issue, dropping triggers a left click event
			delete {tacCheck-fix::%player's uuid%} 
		else:
			tempestPSS(player)

on right click with iron hoe: # TAC USE
	if name of player's held item is "%{wc}%Tempest Scythe": 
		tempestPSS(player)


on drop of iron hoe with priority low:
	if name of event-item is "%{wc}%Tempest Scythe": 
		cancel event
		send "&cULT WEAPON IN INVENTORY!" to player

on drop of bow with priority low: # ULT USE
	if name of event-item is "%{wc}%Tempest Bow":
		cancel event
		if {general-perk::%player's uuid%::perk} = 22:
			set {_ultCooldown} to {special::%player's uuid%::ULT-CD}
		else:
			set {_ultCooldown} to {weapons::TB::ULT-CD}
		set {tacCheck-fix::%player's uuid%} to true # fix the drop issue, dropping triggers a left click event
		if {godlike-ULT-USE::%player's uuid%::TB} is set:
			send "&cULT ALREADY ACTIVATED!" to player
		else if {godlike-ULT-CD::%player's uuid%::TB} is set:
			set {_time} to difference between now and {godlike-ULT-CD::%player's uuid%::TB}
			if {_time} < {_ultCooldown}:
				send "&cULT NOT READY!" to player
		else if ultCHECK(player, {weapons::TB::ULT-COST}) is true:
			set {godlike-ULT-USE::%player's uuid%::TB} to now

			tornado(player)

			set {godlike-ULT-CD::%player's uuid%::TB} to now
			delete {godlike-ULT-USE::%player's uuid%::TB}
			# ULT CD
			wait {_ultCooldown}
			delete {godlike-ULT-CD::%player's uuid%::TB}
			if {class::%player's uuid%} = "TB":
				play sound "BLOCK_BEACON_ACTIVATE" at volume 3 at pitch 1 to player

function tornadoPHY(loc: location, ploc: location, a: player):
	add 3 to y coord of {_loc}
	loop all living entities in radius 5.5 around {_loc}:
		if loop-entity is not armor stand:
			set {_v} to vector between {_ploc} and {_loc}
			if loop-entity is {_a}:
				if {tornadoMovement::%{_a}'s uuid%} isn't set:
					push loop-entity {_v} at speed 1.25
					set {tornadoMovement::%{_a}'s uuid%} to true
					play sound "entity.breeze.wind_burst" with volume 5 and pitch 0.75 at loop-entity
			else:
				updateAttacker({_a}, loop-entity)
				directAttack(loop-entity)
				push loop-entity {_v} at speed 1.25
				damage loop-entity by 1.5 hearts

				play sound "entity.breeze.wind_burst" with volume 5 and pitch 1.25 at loop-entity



function tornado(p: player):
	set {_ploc} to location of {_p} 
	set {_loc} to location of {_p} 

	#spawn 1 armor stand at {_ploc}
	#set {_ls} to last spawned armor stand
	#add nbt compound of "{CustomNameVisible:1,NoGravity:1b,Small:1,Invisible:1,Invulnerable:1,NoBasePlate:1,Marker:1b}" to nbt compound of last spawned armor stand
	#set name of last spawned armor stand to "&7"

	play sound "entity.allay.ambient_without_item" with volume 10 and pitch 1 at {_ploc}

	set {_yaw::1} to 0
	set {_yaw::2} to 90
	set {_yaw::3} to 180
	set {_yaw::4} to 270
	set {_radius::1} to 5
	set {_radius::2} to 4
	set {_radius::3} to 3
	set {_radius::4} to 2

	if {class-perk::%{_p}'s uuid%::TB::perk} = {perk-check::2}:
		set {_times} to 40 # ( 20 blocks travel )
	else:
		set {_times} to 30 # ( 15 blocks travel ) 
	loop {_times} times: # * 0.5 (nado ticks every 5 times)
		
		# causes tornado to move
		set {_n} to 0.5
		set {_loc} to location {_n} blocks horizontally in front of {_loc} 
		#teleport {_ls} to {_loc}

		set {_center} to {_loc}
		loop {_radius::*}:
			set {_radius} to loop-index parsed as an integer
			loop 4 times:
				add 1 to {_count}
				set {_shape} to a arc with radius {_radius}, height 0, and angle 10 degrees
				set offset vector of {_shape} to vector(0, 0, 0)

				set particle of {_shape} to 1 of dust_color_transition particle using dustTransition(white, light gray, 1.5) with offset vector(0, 0, 0) with extra 0 
				rotate shapes {_shape} around vector(0, 1, 0) by {_yaw::%{_count}%} degrees
				draw shapes {_shape} at {_center}
			delete {_shape}
			delete {_count}
			add 3 to y coord of {_center} # height distance between particles

		loop {_yaw::*}: # causes the particles to spin based on yaw
			add 1 to {_count}
			add 9 to {_yaw::%{_count}%}
		delete {_count}

		# Physical effects of tornado
		add 1 to {_tornadoPHY}
		if {_tornadoPHY} = 10:
			tornadoPHY({_loc}, {_ploc}, {_p})
			delete {_tornadoPHY}

		wait 1 tick
	delete {tornadoMovement::%{_p}'s uuid%}
	kill {_ls}		


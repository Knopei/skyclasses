
on load:
	# Class Info Bottom
	set {class-bottom::back} to spectral arrow named "&7Back to Select"
	set {class-bottom::lb} to heart of the sea named "&9&lLeaderboard" with lore "" and "&8&lComing Soon"
	set {class-bottom::stats} to book named "&f&lStatistics" with lore "" and "" and "" and "" and "" and "" and "" and "" and ""
	# Division Colors
	set {division-color::TRASH} to "&8"
	set {division-color::ROOKIE} to "&7"
	set {division-color::BRONZE} to "<##6E4D25>"
	set {division-color::SILVER} to "&f"
	set {division-color::GOLD} to "&6"
	set {division-color::DIAMOND} to "&b"
	set {division-color::MASTER} to "&2"
	set {division-color::GRAND-MASTER} to "&5"
	set {division-color::ELITE-GRANDMASTER} to "&d"
	# Class Division ----------------------------
	set {class-division::TRASH} to nether brick named "%{division-color::TRASH}%&lTrash" with lore "" and "&7&l&oRewards" and "  &eTrash Title" and "" and ""  
	set {class-division::ROOKIE} to brick named "%{division-color::ROOKIE}%&lRookie" with lore "" and "&7&l&oRewards" and "  &eRookie Title" and "" and ""  
	set {class-division::BRONZE} to copper ingot named "%{division-color::BRONZE}%&lBronze" with lore "" and "&7&l&oRewards" and "  &eBronze Title" and "  &dPerk Unlock" and "" and ""
	set {class-division::SILVER} to iron ingot named "%{division-color::SILVER}%&lSilver" with lore "" and "&7&l&oRewards" and "  &eSilver Title" and "  &dPerk Unlock" and "" and ""
	set {class-division::GOLD} to gold ingot named "%{division-color::GOLD}%&lGold" with lore "" and "&7&l&oRewards" and "  &eGold Title" and "  &dPerk Unlock" and "" and ""
	set {class-division::DIAMOND} to diamond named "%{division-color::DIAMOND}%&lDiamond" with lore "" and "&7&l&oRewards" and "  &eDiamond Title" and "" and ""
	set {class-division::MASTER} to emerald named "%{division-color::MASTER}%&lMaster" with lore "" and "&7&l&oRewards" and "  &eMaster Title" and "" and ""  
	set {class-division::GRAND-MASTER} to amethyst shard named "%{division-color::GRAND-MASTER}%&lGrandmaster" with lore "" and "&7&l&oRewards" and "  &eGrandmaster Title" and "" and ""
	set {class-division::ELITE-GRANDMASTER} to cherry sapling named "%{division-color::ELITE-GRANDMASTER}%&lElite Grandmaster" with lore "" and "&7&l&oRewards" and "  &eElite Grandmaster Title" and "" and ""  

	set {class-requirement::9} to 0
	set {class-requirement::10} to 25
	set {class-requirement::11} to 50
	set {class-requirement::12} to 100
	set {class-requirement::13} to 250
	set {class-requirement::14} to 500
	set {class-requirement::15} to 1000
	set {class-requirement::16} to 5000
	set {class-requirement::17} to 10000
	# Class Display -----------------------------
	wait 1 tick
		# Special Case
	set {class-display::CB1} to diamond sword named "&eClass: %{class-color::CB}%&l%{class-name::CB}%" with lore "" and "&e&lPASSIVE" and "&9Mana Breach" and "&8&oWhen below half max mana, damage you" and "&8&odo will steal a portion of mana from the" and "&8&oenemy and transfer it to you." and "" and "&e&lTACTICAL" and "&6Cyber Glitch &7[RIGHT] &9🧪%{weapons::CB::TAC-COST}%" and "&8&oPhase through doors and solid terrain." and "" and "&e&lULTIMATE" and "&aMalicious Dart &7[DROP] &9🧪%{weapons::CB::ULT-COST}% &f⌚%{weapons::CB1::ULT-CD}%" and "&8&oShoot a dart that briefly disables" and "&8&ostamina usage." and ""

	set {class-display::RB1} to bow named "&eClass: %{class-color::RB}%&l%{class-name::RB}%" with lore "" and "&6&lATTACK &7[HOLD+RIGHT] &9🧪%{weapons::RB::ATK-COST}%" and "&8&oThe longer you hold, the more rapid the" and "&8&ofire rate." and "" and "&e&lPASSIVE" and "&6Rapid Bow" and "&8&oYour bow is always active." and "" and "&e&lTACTICAL" and "&eEnergize &7[LEFT] &9🧪%{weapons::RB1::TAC-COST}%" and "&8&oCharge your bow to the maximum fire rate." and "" and "&e&lULTIMATE" and "&cMachine Gun &7[DROP] &9🧪%{weapons::RB1::ULT-COST}% &f⌚%{weapons::RB1::ULT-CD}%" and "&8&oPlow anything in your way." and ""
	set {class-display::RD1} to stone sword named "&eClass: %{class-color::RB}%&l%{class-name::RB}%" with lore "" and "&e&lPASSIVE" and "&6Rapid Bow" and "&8&oYour bow is always active." and "" and "&e&lTACTICAL" and "&bSprint II &7[RIGHT] &9🧪%{weapons::RD::TAC-COST}%" and "&8&oBriefly gain great speed that declines." and "" 
		# LORE INFO
	set {class-display::ZT} to trident named "&eClass: %{class-color::ZT}%&l%{class-name::ZT}%" with lore "" and "&e&lPASSIVE" and "&3Pitch Fork" and "&8&oExtended your trident forward dealing" and "&8&odamage in front of you, every 4th hit." and "" and "&e&lTACTICAL" and "&bEmpowered Throw &7[RIGHT] &9🧪%{weapons::ZT::TAC-COST}%" and "&8&oThrow your trident and strike lightning" and "&8&owhere it lands." and "" and "&e&lULTIMATE" and "&bThunderstorm &7[DROP] &9🧪%{weapons::ZT::ULT-COST}% &f⌚%{weapons::ZT::ULT-CD}%" and "&8&oSummon a deadly thunderstorm at your" and "&8&olocation and gain lightning resistance." and ""
	set {class-display::PGS} to iron sword named "&eClass: %{class-color::PGS}%&l%{class-name::PGS}%" with lore "" and "&e&lPASSIVE" and "&dBeliever" and "&8&oPermanent regeneration." and "" and "&e&lTACTICAL" and "&eHoly Shield &7[RIGHT] &9🧪%{weapons::PGS::TAC-COST}%" and "&8&oCreate a shield around you that blocks damage." and "" and "&e&lULTIMATE" and "&6Holy Radiance &7[DROP] &9🧪%{weapons::PGS::ULT-COST}% &f⌚%{weapons::PGS::ULT-CD}%" and "&8&oCreate a holy radius at your location that " and "&8&obuffs you and debuffs enemies." and ""
	set {class-display::GD} to golden sword named "&eClass: %{class-color::GD}%&l%{class-name::GD}%" with lore "" and "&e&lPASSIVE" and "&bQuick Feet" and "&8&oPermanent increased speed." and "" and "&e&lTACTICAL" and "&cLunge &7[RIGHT] &9🧪%{weapons::GD::TAC-COST}%" and "&8&oDirectional dash that damages enemies" and "&8&oin the way." and "" and "&e&lULTIMATE" and "&4Ghost &7[DROP] &9🧪%{weapons::GD::ULT-COST}% &f⌚%{weapons::GD::ULT-CD}%" and "&8&oGain immense speed and invisiblity + your" and "&8&onext attack while invis, does a large" and "&8&opercent of the enemies current health." and ""
	set {class-display::VBA} to iron axe named "&eClass: %{class-color::VBA}%&l%{class-name::VBA}%" with lore "" and "&e&lPASSIVE" and "&cLittle Rage" and "&8&oGain attack damage and speed the lower" and "&8&oyour health." and "" and "&e&lTACTICAL" and "&6Bullseye &7[RIGHT] &9🧪%{weapons::VBA::TAC-COST}%" and "&8&oThrow an arrow that slows the enemy and" and "&8&ogrants you speed if hit." and "" and "&e&lULTIMATE" and "&4Big Rage &7[DROP] &9🧪%{weapons::VBA::ULT-COST}% &f⌚%{weapons::VBA::ULT-CD}%" and "&8&oLittle Rage but more furious." and ""
	set {class-display::DS} to netherite sword named "&eClass: %{class-color::DS}%&l%{class-name::DS}%" with lore "" and "&e&lPASSIVE" and "&4Life Steal" and "&8&oHeal when damaging enemies." and "" and "&e&lTACTICAL" and "&cBlood Beam &7[RIGHT] &9🧪%{weapons::DS::TAC-COST}%" and "&8&oTarget a enemy to damage and heal from." and "" and "&e&lULTIMATE" and "&4Blood Harvest &7[DROP] &9🧪%{weapons::DS::ULT-COST}% &f⌚%{weapons::DS::ULT-CD}%" and "&8&oAutomatically shoot Blood Beams at all" and "&8&onearby enemies." and ""
	set {class-display::MH} to mace named "&eClass: %{class-color::MH}%&l%{class-name::MH}%" with lore "" and "&e&lPASSIVE" and "&2Grenade Protection" and "&8&oTake less damage to grenades." and "" and "&e&lTACTICAL" and "&3Explode &7[RIGHT] &9🧪%{weapons::MH::TAC-COST}%" and "&8&oCreate an explosion at your location damaging" and "&8&oand knocking up any enemies nearby." and "" and "&e&lULTIMATE" and "&bMighty Leap &7[DROP] &9🧪%{weapons::MH::ULT-COST}% &f⌚%{weapons::MH::ULT-CD}%" and "&8&oLeap high into the air and create a big explosion" and "&8&oupon landing that damages and pushes enemies away" and "&8&o+ &7[DROP] &8&oWhile airborne to directional dash." and ""
	set {class-display::RS} to netherite hoe named "&eClass: %{class-color::RS}%&l%{class-name::RS}%" with lore "" and "&e&lPASSIVE" and "&cReaping Slash" and "&8&oSlash around you applying wither on every" and "&8&o3rd hit." and "" and "&e&lTACTICAL" and "&eGrapple &7[RIGHT] &9🧪%{weapons::RS::S-TAC-COST}%-%{weapons::RS::L-TAC-COST}%" and "&8&oThrow a grapple that pulls you toward solid" and "&8&oobjects or pulls enemies toward you." and "" and "&e&lULTIMATE" and "&4Soul Collector &7[DROP] &9🧪%{weapons::RS::ULT-COST}% &f⌚%{weapons::RS::ULT-CD}%" and "&8&oSwing your scythe around you, and apply" and "&8&owithering and blindness to hit enemies." and ""
	set {class-display::NS} to nether star named "&eClass: %{class-color::NS}%&l%{class-name::NS}%" with lore "" and "&e&lPASSIVE" and "&eImproved Stamina" and "&8&oStamina dashes will launch you further." and "" and "&e&lTACTICAL" and "&cShuriken Throw &7[RIGHT] &9🧪%{weapons::NS::TAC-COST}%" and "&8&oConsecutively throw 3 ninja stars." and "" and "&e&lULTIMATE" and "&6Dragon Blade &7[DROP] &9🧪%{weapons::NS::ULT-COST}% &f⌚%{weapons::NS::ULT-CD}%" and "&8&oPull out a fiery katana and gain immense" and "&8&ospeed and jumboost." and ""
	set {class-display::PT} to trident named "&eClass: %{class-color::PT}%&l%{class-name::PT}%" with lore "" and "&e&lPASSIVE" and "&6Moist Apples" and "&8&oGain more healing for golden apples." and "" and "&e&lTACTICAL" and "&9Harpoon &7[RIGHT] &9🧪%{weapons::PT::TAC-COST}%" and "&8&oThrow your trident and teleport to" and "&8&owhere it lands." and "" and "&e&lULTIMATE" and "&1Aura Farm &7[DROP] &9🧪%{weapons::PT::ULT-COST}% &f⌚%{weapons::PT::ULT-CD}%" and "&8&oExpand your frame and begin aura farming" and "&8&olike the ASU Frat leader." and ""
	set {class-display::CB} to diamond sword named "&eClass: %{class-color::CB}%&l%{class-name::CB}%" with lore "" and "&e&lPASSIVE" and "&9Mana Breach" and "&8&oWhen below half max mana, damage you" and "&8&odo will steal a portion of mana from the" and "&8&oenemy and transfer it to you." and "" and "&e&lTACTICAL" and "&aMalicious Dart &7[RIGHT] &9🧪%{weapons::CB::TAC-COST}%" and "&8&oShoot a dart that briefly disables" and "&8&ostamina usage." and "" and "&e&lULTIMATE" and "&6Cyber Glitch &7[DROP] &9🧪%{weapons::CB::ULT-COST}% &f⌚%{weapons::CB::ULT-CD}%" and "&8&oPhase through doors and solid terrain." and ""
	set {class-display::FH} to mace named "&eClass: %{class-color::FH}%&l%{class-name::FH}%" with lore "" and "&e&lPASSIVE" and "&cBig Boy" and "&8&oGain +1 max heatlh." and "" and "&e&lTACTICAL" and "&3Leap &7[RIGHT] &9🧪%{weapons::FH::TAC-COST}%" and "&8&oLeap into the air, and create a damaging" and "&8&oand slowing radius on impact." and "" and "&e&lULTIMATE" and "&bIt's Alive! &7[DROP] &9🧪%{weapons::FH::ULT-COST}% &f⌚%{weapons::FH::ULT-CD}%" and "&8&oCreate a powerful electric shield around" and "&8&oyou that reflects projectiles." and ""
	set {class-display::BS} to shield named "&eClass: %{class-color::BS}%&l%{class-name::BS}%" with lore "" and "&e&lPASSIVE" and "&eStamina Recharge" and "&8&oHitting Bash refunds a small portion" and "&8&oof Stamina." and "" and "&e&lTACTICAL" and "&3Shield &7[RIGHT+HOLD] &9🧪%{weapons::BS::TAC-COST}% PER SECOND" and "&8&oUse your shield to block all sources" and "&8&oof damage." and "" and "&e&lSPECIAL" and "&cBash &7[RIGHT+HOLD+STAMINA]" and "&8&oWhile in Shield State, using Stamina will" and "&8&odamage and knock back any enemies in" and "&8&oyour way." and "" and "&e&lULTIMATE" and "&6Shield Quake &7[DROP] &9🧪%{weapons::BS::ULT-COST}% &f⌚%{weapons::BS::ULT-CD}%" and "&8&oSlam your shield on the ground mutliple" and "&8&otimes, knocking up enemies and briefly" and "&8&odisabling thier stamina usage." and ""
	set {class-display::WH} to netherite axe named "&eClass: %{class-color::WH}%&l%{class-name::WH}%" with lore "" and "&e&lPASSIVE" and "&7Fragile Stacking" and "&8&oYou Sonic Beams will briefly apply a stack " and "&8&oof fragile to an enemy, enemies with fragile" and "&8&ostacks will take more damage to your next" and "&8&oSonic Beams." and "" and "&e&lTACTICAL" and "&bSonic Beam &7[RIGHT] &9🧪%{weapons::WH::TAC-COST}%" and "&8&oCharge up, then shoot a Sonic Beam." and "" and "&e&lULTIMATE" and "&1Warden Summon &7[DROP] &9🧪%{weapons::WH::ULT-COST}% &f⌚%{weapons::WH::ULT-CD}%" and "&8&oSummon a Warden that will assist you in battle." and ""

	set {class-display::RB} to bow named "&eClass: %{class-color::RB}%&l%{class-name::RB}%" with lore "" and "&6&lATTACK &7[HOLD+RIGHT] &9🧪%{weapons::RB::ATK-COST}%" and "&8&oThe longer you hold, the more rapid the" and "&8&ofire rate." and "" and "&e&lPASSIVE" and "&bSprint" and "&8&oBriefly gain speed when swapping weapons." and "" and "&e&lTACTICAL" and "&eEnergize &7[LEFT] &9🧪%{weapons::RB::TAC-COST}%" and "&8&oCharge your bow to the maximum fire rate." and "" and "&e&lULTIMATE" and "&6Holster &7[DROP] &9🧪%{weapons::RB::ULT-COST}% &f⌚%{weapons::RB::ULT-CD}%" and "&8&oSwap to your dagger." and "" and "&7Click to swap"
	set {class-display::RD} to stone sword named "&eClass: %{class-color::RB}%&l%{class-name::RB}%" with lore "" and "&e&lPASSIVE" and "&bSprint" and "&8&oBriefly gain speed when swapping weapons." and "" and "&e&lTACTICAL" and "&bSprint II &7[RIGHT] &9🧪%{weapons::RD::TAC-COST}%" and "&8&oBriefly gain great speed that declines." and "" and "&e&lULTIMATE" and "&6Holster &7[DROP] &9🧪%{weapons::RB::ULT-COST}% &f⌚%{weapons::RB::ULT-CD}%" and "&8&oSwap to your bow." and "" and "&7Click to swap"

	set {class-display::PF} to leather horse armor named "&eClass: %{class-color::PF}%&l%{class-name::PF}%" with lore "" and "&6&lATTACK &7[RIGHT] &9🧪%{weapons::PF::ATK-COST}%" and "&8&oShoot a bullet that does more damage the" and "&8&ofurther it travels." and "" and "&e&lPASSIVE" and "&cReady n' Steady" and "&8&oYour next attack after swapping weapons" and "&8&owill do more damage." and "" and "&e&lTACTICAL" and "&cCannon Ball &7[LEFT] &9🧪%{weapons::PF::TAC-COST}%" and "&8&oShoot a bullet that knocks enemies back." and "" and "&e&lULTIMATE" and "&6Holster &7[DROP] &9🧪%{weapons::PF::ULT-COST}% &f⌚%{weapons::PF::ULT-CD}%" and "&8&oSwap to your cutlass." and "" and "&7Click to swap"
	set {class-display::PC} to iron sword named "&eClass: %{class-color::PF}%&l%{class-name::PF}%" with lore "" and "&e&lPASSIVE" and "&cReady n' Steady" and "&8&oYour next attack after swapping weapons" and "&8&owill do more damage." and "" and "&e&lTACTICAL" and "&cSwing n' Pray &7[RIGHT] &9🧪%{weapons::PC::TAC-COST}%" and "&8&oBriefly gain zero attack cooldown." and "" and "&e&lULTIMATE" and "&6Holster &7[DROP] &9🧪%{weapons::PF::ULT-COST}% &f⌚%{weapons::PF::ULT-CD}%" and "&8&oSwap to your flintlock." and "" and "&7Click to swap"
 
	set {class-display::MMS} to spyglass named "&eClass: %{class-color::MMH}%&l%{class-name::MMH}%" with lore "" and "&6&lATTACK &7[DROP] &9🧪%{weapons::MMS::ULT-COST}%" and "&8&oShoot a high damaging bullet that does more" and "&8&odamage the further it travels." and "" and "&e&lPASSIVE" and "&cWounded" and "&8&oSniper shots briefly slow enemies." and "" and "&e&lTACTICAL" and "&cMarked Target &7[LEFT] &9🧪%{weapons::MMH::TAC-COST}%" and "&8&oMarked enemies take more damage to your" and "&8&oattacks." and "" and "&e&lTACTICAL" and "&6Scoped &7[RIGHT]" and "&8&oUse your sniper scope to zoom in and increase" and "&8&oyour accuracy." and "" and "&e&lULTIMATE" and "&4Sniper Rifle &f⌚%{weapons::MMH::ULT-CD}%" and "&8&oYour rifle is always active + your rifle" and "&8&ogains ammo over time." and "" and "&7Click to swap"
	set {class-display::MMH} to stone axe named "&eClass: %{class-color::MMH}%&l%{class-name::MMH}%" with lore "" and "&e&lPASSIVE" and "&6Sniper Rifle" and "&8&oYour sniper rifle is always active." and "" and "&e&lTACTICAL" and "&cMarked Target &7[RIGHT] &9🧪%{weapons::MMH::TAC-COST}%" and "&8&oMarked enemies take more damage to your" and "&8&oattacks." and "" and "&7Click to swap"

	set {class-display::HC} to crossbow named "&eClass: %{class-color::HC}%&l%{class-name::HC}%" with lore "" and "&6&lATTACK &7[RIGHT] &9🧪%{weapons::HC::ATK-COST}%" and "&8&oCharge up and fire a triple shot of arrows." and "" and "&e&lPASSIVE" and "&eWolf Companion" and "&8&oGet a Leash that can be used to summon" and "&8&oand command your wolf." and "" and "&e&lTACTICAL" and "&2Poison Tipped &7[LEFT] &9🧪%{weapons::HC::TAC-COST}%" and "&8&oYour next attack will apply poison." and "" and "&e&lULTIMATE" and "&6Holster &7[DROP] &9🧪%{weapons::HC::ULT-COST}% &f⌚%{weapons::HC::ULT-CD}%" and "&8&oSwap to your knife." and "" and "&7Click to swap"
	set {class-display::HK} to iron sword named "&eClass: %{class-color::HC}%&l%{class-name::HC}%" with lore "" and "&e&lPASSIVE" and "&eWolf Companion" and "&8&oGet a Leash that can be used to summon" and "&8&oand command your wolf." and "" and "&e&lTACTICAL" and "&2Poison Tipped &7[RIGHT] &9🧪%{weapons::HK::TAC-COST}%" and "&8&oYour next attack will apply poison." and "" and "&e&lULTIMATE" and "&6Holster &7[DROP] &9🧪%{weapons::HC::ULT-COST}% &f⌚%{weapons::HK::ULT-CD}%" and "&8&oSwap to your crossbow." and "" and "&7Click to swap"
	set {class-display::HWL} to lead named "&eClass: %{class-color::HC}%&l%{class-name::HC}%" with lore "" and "&e&lTACTICAL" and "&eTug &7[LEFT] &9🧪%{weapons::HWL::L-COST}%" and "&8&oCommand you wolf to come to you." and "" and "&e&lTACTICAL" and "&6Summon &7[RIGHT] &9🧪%{weapons::HWL::R-COST}% &f⌚%{weapons::HWL::CD}%" and "&8&oSummon a wolf that will assist you in battle." and "" and "&7Click to swap"

	set {class-display::TB} to bow named "&eClass: %{class-color::TB}%&l%{class-name::TB}%" with lore "" and "&6&lATTACK &7[HOLD+RIGHT] &9🧪%{weapons::TB::ATK-COST}%" and "&8&oShoot a wind burst that travels quicker" and "&8&oand does more damage the longer charged." and "" and "&e&lPASSIVE" and "&bWindy Feet" and "&8&oPermanent increased speed." and "" and "&e&lTACTICAL" and "&fGlide &7[LEFT] &9🧪%{weapons::TB::TAC-COST}% PER SECOND" and "&8&oToggle to begin gliding." and "" and "&e&lULTIMATE" and "&4Tornado &7[DROP] &9🧪%{weapons::TB::ULT-COST}% &f⌚%{weapons::TB::ULT-CD}%" and "&8&oSummon a directional tornado that pushes" and "&8&oand damages enemies." and "" and "&7Click to swap"
	set {class-display::TS} to iron hoe named "&eClass: %{class-color::TB}%&l%{class-name::TB}%" with lore "" and "&e&lPASSIVE" and "&6Tempest Bow" and "&8&oYour bow is always active." and "" and "&e&lTACTICAL" and "&fGlide &7[RIGHT] &9🧪%{weapons::TB::TAC-COST}% PER SECOND" and "&8&oToggle to begin gliding." and "" and "&7Click to swap"
	
	loop {class-display::*}:
		set {_v} to loop-value
		set {_i} to loop-index
		#add nbt compound of "{attribute_modifiers:{modifiers:[],show_in_tooltip:0}}" to nbt compound of {_v}
		set {class-display::%{_i}%} to {_v} with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable 

	# Perks ------------------------------------- # dyes (red: DMG, orange: DEF, yellow: Range, cyan: Movement)
	set {perk-check::1} to 29
	set {perk-check::2} to 31
	set {perk-check::3} to 33
	# ZT
	set {class-perk::ZT::%{perk-check::1}%} to cyan dye named "&dPerk: &lWeight Reduction" with lore "" and "&5&lPASSIVE" and "&8&oBriefly gain speed after &bEmpowered Throw." and ""
	set {class-perk::ZT::%{perk-check::2}%} to red dye named "&dPerk: &lLightning Speed" with lore "" and "&5&lPASSIVE" and "&bThunderstorm &8&ois summoned quicker." and ""
	set {class-perk::ZT::%{perk-check::3}%} to gray dye named "&dPerk: &lComing Soon" 
	# PGS
	set {class-perk::PGS::%{perk-check::1}%} to cyan dye named "&dPerk: &lAgile Shield" with lore "" and "&5&lPASSIVE" and "&8&oGain speed while &eHoly Shield &8&ois active." and ""
	set {class-perk::PGS::%{perk-check::2}%} to orange dye named "&dPerk: &lSupreme Radiance" with lore "" and "&5&lPASSIVE" and "&8&oIncreases the radius of &6Holy Radiance." and ""
	set {class-perk::PGS::%{perk-check::3}%} to gray dye named "&dPerk: &lComing Soon" 
	# GD
	set {class-perk::GD::%{perk-check::1}%} to cyan dye named "&dPerk: &lLunge Master" with lore "" and "&5&lPASSIVE" and "&cLunge &8&ocosts less mana to use." and ""

function getClassDiv(p: player, class: string, type: string) :: string:
	set {_uuid} to uuid of {_p}
	set {_prog} to {class-kill::%{_uuid}%::%{_class}%}
	if {_prog} >= {class-requirement::17}:
		set {_long} to "%{division-color::ELITE-GRANDMASTER}%&lElite-Grandmaster" 
		set {_short} to "%{division-color::ELITE-GRANDMASTER}%&lEGM"
		set {_color} to {division-color::ELITE-GRANDMASTER}
	else if {_prog} >= {class-requirement::16}:
		set {_long} to "%{division-color::GRAND-MASTER}%&lGrandmaster" 
		set {_short} to "%{division-color::GRAND-MASTER}%&lGM"
		set {_color} to {division-color::GRAND-MASTER}
	else if {_prog} >= {class-requirement::15}:
		set {_long} to "%{division-color::MASTER}%&lMaster" 
		set {_short} to "%{division-color::MASTER}%&lM"
		set {_color} to {division-color::MASTER}
	else if {_prog} >= {class-requirement::14}:
		set {_long} to "%{division-color::DIAMOND}%&lDiamond" 
		set {_short} to "%{division-color::DIAMOND}%&lD"
		set {_color} to {division-color::DIAMOND}
	else if {_prog} >= {class-requirement::13}:
		set {_long} to "%{division-color::GOLD}%&lGold" 
		set {_short} to "%{division-color::GOLD}%&lG"
		set {_color} to {division-color::GOLD}
	else if {_prog} >= {class-requirement::12}:
		set {_long} to "%{division-color::SILVER}%&lSilver" 
		set {_short} to "%{division-color::SILVER}%&lS"
		set {_color} to {division-color::SILVER}
	else if {_prog} >= {class-requirement::11}:
		set {_long} to "%{division-color::BRONZE}%&lBronze" 
		set {_short} to "%{division-color::BRONZE}%&lB"
		set {_color} to {division-color::BRONZE}
	else if {_prog} >= {class-requirement::10}:
		set {_long} to "%{division-color::ROOKIE}%&lRookie" 
		set {_short} to "%{division-color::ROOKIE}%&lR"
		set {_color} to {division-color::ROOKIE}
	else if {_prog} >= {class-requirement::9}:
		set {_long} to "%{division-color::TRASH}%&lTrash" 
		set {_short} to "%{division-color::TRASH}%&lT"
		set {_color} to {division-color::TRASH}
	if {_type} = "color":
		return {_color}
	else if {_type} = "long":
		return {_long}
	else:
		return {_short}



function ClassInfo(p: player, class: string):
	set {_uuid} to uuid of {_p}
	set metadata tag "class info" of {_p} to chest inventory with 6 rows named "Class Info"
	set slot (integers between 9 and 44) of metadata tag "class info" of {_p} to gray stained glass pane named " " 
	set slot (integers between 0 and 8) of metadata tag "class info" of {_p} to black stained glass pane named " " 
	set slot (integers between 45 and 53) of metadata tag "class info" of {_p} to black stained glass pane named " " 
	# info
	set name of slot 0 of metadata tag "class info" of {_p} to {_class}
	set slot 4 of metadata tag "class info" of {_p} to {class-display::%{_class}%} with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable 
	# division
	set {_prog} to {class-kill::%{_uuid}%::%{_class}%}
	set {_division::9} to {class-division::TRASH}
	set {_division::10} to {class-division::ROOKIE}
	set {_division::11} to {class-division::BRONZE}
	set {_division::12} to {class-division::SILVER}
	set {_division::13} to {class-division::GOLD}
	set {_division::14} to {class-division::DIAMOND}
	set {_division::15} to {class-division::MASTER}
	set {_division::16} to {class-division::GRAND-MASTER}
	set {_division::17} to {class-division::ELITE-GRANDMASTER}
	
	loop {_division::*}:
		set {_index} to loop-index parsed as a integer
		set slot {_index} of metadata tag "class info" of {_p} to loop-value
		set {_size} to size of lore of loop-value
		if {_prog} >= {class-requirement::%{_index}%}:
			set {_division} to {_index}
			set line {_size} of lore of slot {_index} of metadata tag "class info" of {_p} to "&aProgress [%{_prog}%/%{class-requirement::%{_index}%}%]"
		else:
			set line {_size} of lore of slot {_index} of metadata tag "class info" of {_p} to "&cProgress [%{_prog}%/%{class-requirement::%{_index}%}%]"

	set {_enchant} to slot {_division} of metadata tag "class info" of {_p}
	enchant {_enchant} with unbreaking 1
	set slot {_division} of metadata tag "class info" of {_p} to {_enchant} with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable 	
	# perks
	set {_pos} to {class-perk::%{_uuid}%::%{_class}%::perk}
	set {_perk::%{perk-check::1}%} to {class-perk::%{_class}%::%{perk-check::1}%}
	set {_perk::%{perk-check::2}%} to {class-perk::%{_class}%::%{perk-check::2}%}
	set {_perk::%{perk-check::3}%} to {class-perk::%{_class}%::%{perk-check::3}%}

	loop {_perk::*}:
		set {_index} to loop-index parsed as a integer
		set {_value} to loop-value 
		set {_size} to (size of lore of loop-value) + 1
		if {_pos} = {_index}:
			set line {_size} of lore of slot {_index} of metadata tag "class info" of {_p} to "&aSelected"
			enchant {_value} with unbreaking 1
			set line {_size} of lore of {_value} to "&aSelected"
		else if {class-perk::%{_uuid}%::%{_class}%::owned::*} contains {_index}:
			set line {_size} of lore of {_value} to "&7Click to select"
		else:
			set line {_size} of lore of {_value} to "&5Click to unlock"
		set slot {_index} of metadata tag "class info" of {_p} to {_value} with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable 	
	
	# bottom
	set {_bottom::45} to {class-bottom::back} 
	set {_bottom::49} to {class-bottom::lb} 
	set {_bottom::53} to {class-bottom::stats} 

	set {_lore::*} to leaderboard("Kill", {_class})
	set lore of {_bottom::49} to {_lore::*}

	set slot 45 of metadata tag "class info" of {_p} to {_bottom::45} with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable 
	set slot 49 of metadata tag "class info" of {_p} to {_bottom::49} with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable 
	set slot 53 of metadata tag "class info" of {_p} to {_bottom::53} with item flag hide additional tooltip, hide enchants, hide attributes, and hide unbreakable 

	set line 1 of lore of slot 53 of metadata tag "class info" of {_p} to "&e&o%{class-name::%{_class}%}%"

	set {_kill} to formatNumber({class-kill::%{_uuid}%::%{_class}%}) 
	set {_death} to formatNumber({class-death::%{_uuid}%::%{_class}%})
	set {_assist} to formatNumber({class-assist::%{_uuid}%::%{_class}%}) 
	set {_ks} to formatNumber({class-ks::%{_uuid}%::%{_class}%::top}) 
	set {_dmg} to formatNumber({class-damage::%{_uuid}%::%{_class}%}) 
	set {_kdr} to {class-kill::%{_uuid}%::%{_class}%}/{class-death::%{_uuid}%::%{_class}%}

	set line 3 of lore of slot 53 of metadata tag "class info" of {_p} to "&8Kills &f%{_kill}%"
	set line 4 of lore of slot 53 of metadata tag "class info" of {_p} to "&8K.D.R &f%{_kdr}%"
	set line 5 of lore of slot 53 of metadata tag "class info" of {_p} to "&8Deaths &f%{_death}%"
	set line 6 of lore of slot 53 of metadata tag "class info" of {_p} to "&8Assists &f%{_assist}%"
	set line 7 of lore of slot 53 of metadata tag "class info" of {_p} to "&8Damage &f%{_dmg}%"
	set line 8 of lore of slot 53 of metadata tag "class info" of {_p} to "&8Top Killstreak &f%{_ks}%"

	open (metadata tag "class info" of {_p}) to {_p}

on inventory click:
	if event-inventory = (metadata tag "class info" of player):
		cancel event

		set {_class} to name of slot 0 of player's current inventory
		set {_index} to index of event-slot

		if index of event-slot is 45:
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 3 at pitch 1 to player
			#if {duel::%player's uuid%::status} is "select":
			#	duelClassMenu(player)
			#else if {duel::%player's uuid%::status} is "intermission":
			#	duelRoundClassSelect(player)
			#else:
			ClassMenu(player)
		else if index of event-slot is 4:
			set {_name} to name of event-slot
			# RB
			if {_name} = "&eClass: %{class-color::RB}%&lRapid":
				if event-slot is bow:
					set slot 4 of player's current inventory to {class-display::RD}
				else if event-slot is stone sword:
					set slot 4 of player's current inventory to {class-display::RB}
			# PF
			else if {_name} = "&eClass: %{class-color::PF}%&lPirate":
				if event-slot is leather horse armor:
					set slot 4 of player's current inventory to {class-display::PC}
				else if event-slot is iron sword:
					set slot 4 of player's current inventory to {class-display::PF}
			# MMH
			else if {_name} = "&eClass: %{class-color::MMH}%&lMarksman":
				if event-slot is spyglass:
					set slot 4 of player's current inventory to {class-display::MMH}
				else if event-slot is stone axe:
					set slot 4 of player's current inventory to {class-display::MMS}
			# HC
			else if {_name} = "&eClass: %{class-color::HC}%&lHunter":
				if event-slot is crossbow:
					set slot 4 of player's current inventory to {class-display::HK}
				else if event-slot is iron sword:
					set slot 4 of player's current inventory to {class-display::HWL}
				else if event-slot is lead:
					set slot 4 of player's current inventory to {class-display::HC}
			# TB
			else if {_name} = "&eClass: %{class-color::TB}%&lTempest":
				if event-slot is bow:
					set slot 4 of player's current inventory to {class-display::TS}
				else if event-slot is iron hoe:
					set slot 4 of player's current inventory to {class-display::TB}
		else if index of event-slot is 49: # LEADERBOARDS
			if line 1 of lore of event-slot contains "Killstreak":
				set {_lore::*} to leaderboard("Kill", {_class})
				set lore of event-slot to {_lore::*}
			else if line 1 of lore of event-slot contains "Damage": 
				set {_lore::*} to leaderboard("Killstreak", {_class})
				set lore of event-slot to {_lore::*}
			else if line 1 of lore of event-slot contains "Kill": 
				set {_lore::*} to leaderboard("Damage", {_class})
				set lore of event-slot to {_lore::*}
			play sound "BLOCK_STONE_BUTTON_CLICK_ON" at volume 5 at pitch 1 to player
		# PERKS
		else if index of event-slot is {perk-check::1}, {perk-check::2}, or {perk-check::3}:
			set {_lore::*} to lore of event-slot
			set {_size} to size of {_lore::*}
			if line {_size} of lore of event-slot is "&7Click to select":
				set {class-perk::%player's uuid%::%{_class}%::perk} to {_index}
				classSelect(player, {_class})
				ClassInfo(player, {_class})
				play sound "block.enchantment_table.use" at volume 1 at pitch 1.5 to player
			else if line {_size} of lore of event-slot is "&5Click to unlock":
				set {_prog} to {class-kill::%player's uuid%::%{_class}%}
				if {_prog} >= {class-requirement::13}:
					set {_perkUnlock} to 3
				else if {_prog} >= {class-requirement::12}:
					set {_perkUnlock} to 2
				else if {_prog} >= {class-requirement::11}:
					set {_perkUnlock} to 1
				else: 
					set {_perkUnlock} to 0
				if {_perkUnlock} > 0:
					set {_size} to size of {class-perk::%player's uuid%::%{_class}%::owned::*}
					if {_size} >= {_prog}:
						send "&cInsufficient perk unlocks!"
						play sound "BLOCK_NOTE_BLOCK_BASS" at volume 1 at pitch 0.5 to player
					else:
						add {_index} to {class-perk::%player's uuid%::%{_class}%::owned::*}
						ClassInfo(player, {_class})
				else:
					send "&cInsufficient perk unlocks!"
					play sound "BLOCK_NOTE_BLOCK_BASS" at volume 1 at pitch 0.5 to player

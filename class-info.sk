	set {class-perk::FH::%{perk-check::1}%} to orange dye named "&dPerk: &lThe Biggest Boy" with lore "" and "&5&lPASSIVE" and "&8&oGain +1 max heatlh." and ""
	set {class-perk::FH::%{perk-check::2}%} to orange dye named "&dPerk: &lUndying" with lore "" and "&5&lPASSIVE" and "&8&oGreatly increases the strength of the" and "&8&oshield provided by &bIt's Alive!" and ""
	set {class-perk::FH::%{perk-check::3}%} to gray dye named "&dPerk: &lComing Soon" 

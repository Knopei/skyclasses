	set {class-perk::BS::%{perk-check::1}%} to orange dye named "&dPerk: &lHealthy Boy" with lore "" and "&5&lPASSIVE" and "&8&oGain +1 max heatlh." and ""
	set {class-perk::BS::%{perk-check::2}%} to cyan dye named "&dPerk: &lResilient Basher" with lore "" and "&eStamina Recharge &8&orefunds a larger portion" and "&8&oof stamina &8&o+ briefly gain speed." and ""
	set {class-perk::BS::%{perk-check::3}%} to gray dye named "&dPerk: &lComing Soon" 
	# WH
	set {class-perk::WH::%{perk-check::1}%} to orange dye named "&dPerk: &lInntertwined" with lore "" and "&5&lPASSIVE" and "&8&oDuring &1Warden Summon &8&odamage your" and "&8&oWarden does heals you, and damage you" and "&8&odo heals your Warden." and "" 
	set {class-perk::WH::%{perk-check::2}%} to red dye named "&dPerk: &lFragile Stacker" with lore "" and "&5&lPASSIVE" and "&8&oYour Warden will now apply &7Fragile Stacks" and "&8&oto enemies it damages." and ""

# RAPID BOW


on right click with stone sword: # TAC USE
	if name of player's held item is "%{wc}%Rapid Dagger": 
		if tacCHECK(player, {weapons::RB::TAC-COST}) is true:
			play sound "entity_generic_drink" with volume 1 and pitch 1 at player
			add potion effect of speed 3 for 1.5 seconds to potion effects of player
			wait 1 seconds
			add potion effect of speed 2 for 1.5 seconds to potion effects of player

on drop of stone sword with priority low: # ULT USE
	if name of event-item is "%{wc}%Rapid Dagger":
		cancel event
		if {general-perk::%player's uuid%::perk} = 22:
			set {_ultCooldown} to {special::%player's uuid%::ULT-CD}
		else:
			set {_ultCooldown} to {weapons::RB::ULT-CD}
		broadcast {_ultCooldown}
		if {godlike-ULT-USE::%player's uuid%::WH} is set:
			send "&cULT ALREADY ACTIVATED!" to player
		else if {godlike-ULT-CD::%player's uuid%::RB} is set:
			set {_time} to difference between now and {godlike-ULT-CD::%player's uuid%::RB}
			if {_time} < {_ultCooldown}:
				send "&cULT NOT READY!" to player
		else if ultCHECK(player, {weapons::RB::ULT-COST}) is true:	
			set {godlike-ULT-USE::%player's uuid%::RB} to now

			# PRE
			wait 5 ticks
			if name of player's held item is "%{wc}%Rapid Dagger": 
				set player's held item to {class::weapon::RB}
			else:
				wait 5 ticks
				loop player's inventory:
					if name of loop-value is "%{wc}%Rapid Dagger":
						set {_i} to index of loop-value
						set slot {_i} of player's inventory to {class::weapon::RB}
						stop loop
			# PHY ULT
			set {_speed} to 0.5
			loop 50 times:
				if name of player's held item is "%{wc}%Rapid Bow": 
					if {_speed} < 1.5:
						add 0.1 to {_speed}
						shoot a arrow from player at speed {_speed}
					else:
						if {_speed} < 3:
							add 0.1 to {_speed}
						set {_l} to location 0.5 in front of player
						add 1.5 to y-coord of {_l}
						set {_y} to a random number between -4 and 4 
						set {_pitch} to a random number between -4 and 4
						add {_y} to yaw of {_l}
						add {_pitch} to pitch of {_l}
						shoot a arrow from {_l} at speed {_speed}
					#
					set metadata value "attacker" of shot projectile to player
					set metadata value "type" of shot projectile to "RB"
					play sound "entity_arrow_shoot" with volume 3 and pitch 1 at player
					if {class-perk::%player's uuid%::RB::perk} = {perk-check::2}:
						if {_count} >= 40:
							set metadata value "fire" of shot projectile to true
							ignite shot projectile
						else: 
							add 1 to {_count}
						
				wait 2 tick
			# POST
			wait 5 ticks
			if name of player's held item is "%{wc}%Rapid Bow": 
				set player's held item to {class::weapon::RD}
			else:
				wait 5 ticks
				loop player's inventory:
					if name of loop-value is "%{wc}%Rapid Bow":
						set {_i} to index of loop-value
						set slot {_i} of player's inventory to {class::weapon::RD}
						stop loop

			set {godlike-ULT-CD::%player's uuid%::RB} to now	
			delete {godlike-ULT-USE::%player's uuid%::RB}	
			# ULT CD
			wait {_ultCooldown}
			delete {godlike-ULT-CD::%player's uuid%::RB}	
			if {class::%player's uuid%} = "RB":
				play sound "BLOCK_BEACON_ACTIVATE" at volume 3 at pitch 1 to player


on damage of living entity:
	if event-damagecause is a projectile:
		if event-projectile is a arrow:
			if metadata value "type" of event-projectile is "RB":
				set {_attacker} to metadata value "attacker" of event-projectile
				updateAttacker({_attacker}, victim)
				directAttack(victim)
				if metadata value "fire" of event-projectile is true:
					set fire to victim for 4 seconds
				if {class-perk::%{_attacker}'s uuid%::RB::perk} = {perk-check::1}:
					add potion effect of speed 3 without particles for 1 seconds to potion effects of {_attacker}
				else:
					add potion effect of speed 2 without particles for 1 seconds to potion effects of {_attacker}
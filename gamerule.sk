
on load:
	set {skyfall} to location(-0.5, 0, 0.5, world "skyfall", -180, -0)
	set {japan} to location(0.5, 0, 0.5, world "japan", -180, -0)
	#
	set {mapRotation} to false
	execute console command "mv gamerule show_advancement_messages false skyfall"
	execute console command "mv gamerule spread_vines false skyfall"
	execute console command "mv gamerule fire_spread_radius_around_player false skyfall"
	execute console command "mv gamerule fire_damage true skyfall"
	execute console command "mv gamerule projectiles_can_break_blocks false skyfall"
	execute console command "mv gamerule locator_bar false skyfall"

	execute console command "mv gamerule show_advancement_messages false japan"
	execute console command "mv gamerule spread_vines false japan"
	execute console command "mv gamerule fire_spread_radius_around_player false japan"
	execute console command "mv gamerule fire_damage true japan"
	execute console command "mv gamerule projectiles_can_break_blocks false japan"
	execute console command "mv gamerule locator_bar false japan"

	

on damage of iron golem:
	wait 1 tick
	broadcast "HP: &c%health of victim%"
	if attacker's held item is air:
		kill victim

command /disableMapRotation:
	permission: op
	trigger:
		if {mapRotation} is true:
			set {mapRotation} to false
			send "&cMap rotation Disabled!"
		else if {mapRotation} is false:
			set {mapRotation} to true
			send "&aMap rotation Enabled!"


